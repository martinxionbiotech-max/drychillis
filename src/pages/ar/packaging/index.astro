---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما خيارات التعبئة التي تقدمونها؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نوفر التعبئة السائبة (أكياس متعددة الطبقات 25 كجم)، وخدمات الطعام (10–25 كجم)، والتجزئة (أكياس استهلاكية) وتعبئة OEM/علامة خاصة، مع إخراج مختوم وموسوم بالمواصفات في كل شكل."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكنكم تعبئة OEM أو علامة خاصة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم. ندعم تعبئة OEM والعلامة الخاصة حسب علامتك — حجم الكيس والخامة وفن الملصق حسب مواصفاتك، مع الاحتفاظ بتتبع الدفعة في كل وحدة."
      }
    },
    {
      "@type": "Question",
      "name": "كيف يُشحن الفلفل السائب؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُعبأ الفلفل السائب في أكياس كرافت متعددة الطبقات أو منسوجة (عادة 25 كجم)، وغالبًا على منصات وفي حاويات، ويمكن تصديره بحرًا مع مجموعة المستندات الكاملة: COA والتتبع والشهادة الصحية النباتية."
      }
    }
  ]
};
---

<BaseLayout
  title="تعبئة سائبة وOEM للفلفل الحار والفلفل الحلو | Tenda Peppers"
  description="أكياس سائبة 25كجم وخدمات الطعام وتعبئة OEM بعلامة خاصة للفلفل المجفف والفلفل الحلو. مُصنّع في الصين، ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; التعبئة
    </nav>
    <h1>تعبئة سائبة وOEM</h1>
    <p class="lead">
      من أكياس سائبة 25 كجم إلى أكياس التجزئة والعلامة الخاصة — فلفل مجفف وفلفل حلو معبأ حسب
      مواصفاتك، بإخراج مختوم وموسوم وتتبع كامل للدفعة.
    </p>

    <h2 style="margin-top:32px;">أشكال التعبئة</h2>
    <table>
      <thead>
        <tr><th>الشكل</th><th>الحجم</th><th>الأنسب لـ</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>سائب (متعدد الطبقات)</strong></td><td>25 كجم</td><td>الصناعة، إعادة التعبئة، التصدير</td></tr>
        <tr><td><strong>خدمات الطعام</strong></td><td>10–25 كجم</td><td>المطاعم، المعالجات، الهوت بوت</td></tr>
        <tr><td><strong>التجزئة</strong></td><td>أكياس استهلاكية</td><td>تجزئة العلامة، التجارة الإلكترونية</td></tr>
        <tr><td><strong>OEM / علامة خاصة</strong></td><td>حسب المواصفة</td><td>علامتك، فنك</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">ما يتضمنه كل شكل</h2>
    <ul>
      <li>إخراج مختوم وموسوم بالمواصفات</li>
      <li>رقم الدفعة والتتبع إلى قاعدة الزراعة</li>
      <li>COA عند الطلب، مع شهادة صحية نباتية للتصدير</li>
      <li>تعبئة مضبوطة الرطوبة للحفاظ على اللون ومدة الصلاحية</li>
    </ul>

    <h2 style="margin-top:32px;">OEM والعلامة الخاصة</h2>
    <p>
      ندعم تعبئة OEM والعلامة الخاصة حسب علامتك — حجم الكيس والخامة وفن الملصق حسب مواصفاتك. المنتج
      الداخلي هو نفس المواصفة الخاضعة لـ ISO 9001 / HACCP؛ فقط التعبئة تحمل اسمك.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما خيارات التعبئة التي تقدمونها؟</h3>
      <p>نوفر التعبئة السائبة (أكياس متعددة الطبقات 25 كجم)، وخدمات الطعام (10–25 كجم)، والتجزئة (أكياس استهلاكية) وتعبئة OEM/علامة خاصة، مع إخراج مختوم وموسوم بالمواصفات في كل شكل.</p>
    </div>
    <div class="faq-item">
      <h3>هل يمكنكم تعبئة OEM أو علامة خاصة؟</h3>
      <p>نعم. ندعم تعبئة OEM والعلامة الخاصة حسب علامتك — حجم الكيس والخامة وفن الملصق حسب مواصفاتك، مع الاحتفاظ بتتبع الدفعة في كل وحدة.</p>
    </div>
    <div class="faq-item">
      <h3>كيف يُشحن الفلفل السائب؟</h3>
      <p>يُعبأ الفلفل السائب في أكياس كرافت متعددة الطبقات أو منسوجة (عادة 25 كجم)، وغالبًا على منصات وفي حاويات، ويمكن تصديره بحرًا مع مجموعة المستندات الكاملة: COA والتتبع والشهادة الصحية النباتية.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر للتعبئة</a>
      <a class="cta cta-outline" href="/ar/products/paprika/" style="margin-left:8px;">→ الفلفل الحلو</a>
    </div>
  </div>
</BaseLayout>
