---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BuyerSpec from "../../../components/BuyerSpec.astro";
import AtAGlance from "../../../components/AtAGlance.astro";

const buyerSpec = [
  { param: "Форма продукта", value: "Уточнить спецификацию" },
  { param: "Сорт", value: "Перец Wangdu" },
  { param: "Уровень остроты (SHU)", value: "<10,000" },
  { param: "Цветность ASTA", value: "Уточнить спецификацию" },
  { param: "Размер частиц (mesh)", value: "Уточнить спецификацию" },
  { param: "Влажность", value: "<13%" },
  { param: "Обработка", value: "Уточнить спецификацию" },
  { param: "Сертификаты", value: "ISO 9001 и HACCP стандартно — BRC, Halal, Kosher по запросу" },
];

const glanceFacts = [
  { label: "Уровень остроты", value: "<10 000 SHU" },
  { label: "Регион", value: "Шаньдун, Хэбэй" },
  { label: "Лучше всего для", value: "Слабоострая паприка, цвет" },
  { label: "Сертификаты", value: "ISO 9001 и HACCP" },
];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "https://drychillis.com/products/wangdu-chilli/#product",
  "name": "Перец Wangdu",
  "description": "Перец Wangdu — слабоострый перец ниже 10 000 SHU из Шаньдуна и Хэбэя, используется вместе с красным Yidu для слабоострой паприки и цвета. Китайский производитель, ISO 9001 и HACCP.",
  "image": ["https://drychillis.com/images/products/chilli-whole.jpg"],
  "url": "https://drychillis.com/products/wangdu-chilli/",
  "sku": "TENDA-WANGDU-CHILLI",
  "category": "Специи и приправы",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Уровень остроты (SHU)", "value": "<10,000", "unitText": "SHU" },
    { "@type": "PropertyValue", "name": "Регион", "value": "Шаньдун, Хэбэй" },
    { "@type": "PropertyValue", "name": "Лучше всего для", "value": "Слабоострая паприка, цвет" }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Что такое перец Wangdu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wangdu — слабоострый перец ниже 10 000 SHU из Шаньдуна и Хэбэя, используется вместе с красным Yidu для слабоострой паприки и натурального красного цвета."
      }
    },
    {
      "@type": "Question",
      "name": "Насколько острым является перец Wangdu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wangdu — слабая острота — ниже 10 000 SHU, как минимум в 5 раз мягче средней полосы (Xian и Jinta) и намного ниже сверхострых сортов. Это сорт, ориентированный на цвет."
      }
    },
    {
      "@type": "Question",
      "name": "Для чего используется перец Wangdu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wangdu используется вместе с красным Yidu для слабоострой паприки и натурального цвета. Указывайте сорт и целевое значение ASTA — цвет и острота независимы."
      }
    }
  ]
};
---

<BaseLayout
  title="Перец Wangdu — Слабоострый Перец для Цвета | Tenda Peppers"
  description="Перец Wangdu — слабоострый перец ниже 10 000 SHU из Шаньдуна и Хэбэя, используется вместе с красным Yidu для слабоострой паприки и цвета. Китайский производитель, ISO 9001 и HACCP."
  lang="ru"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ru/">Главная</a> &rsaquo; <a href="/ru/products/dried-chillies/">Сушёный чили</a> &rsaquo; Wangdu
    </nav>
    <h1>Перец Wangdu</h1>
    <p class="lead">
      Слабоострый перец ниже 10 000 SHU из Шаньдуна и Хэбэя — используется вместе с красным Yidu для слабоострой паприки и натурального цвета.
    </p>
    <div class="takeaways">
      <strong>Короткий ответ:</strong> Wangdu — слабоострый перец (ниже 10 000 SHU) из Шаньдуна и Хэбэя, используется вместе с красным Yidu для слабоострой паприки и цвета. Это сорт, ориентированный на цвет — его покупают по ASTA, а не по жгучести.
    </div>
    <AtAGlance facts={glanceFacts} lang="ru" />
    <div class="product-media">
      <img src="/images/products/chilli-whole.jpg" alt="Целый сушёный чили" width="1400" height="1050" loading="eager" />
    </div>
    <p class="product-price" style="font-weight:600;color:#8a1c1c;margin:10px 0 0;">Цена подтверждается при запросе котировки — MOQ, упаковка и спецификация согласовываются до заказа.</p>

    <h2 style="margin-top:32px;">Что такое перец Wangdu?</h2>
    <p>
      Wangdu — слабоострый перец ниже 10 000 SHU из Шаньдуна и Хэбэя. В <a href="/ru/guides/chinese-chilli-varieties-grades/">справочнике сортов</a> он находится в слабоострой полосе вместе с красным Yidu — полосе, которую перемалывают в слабоострую паприку, где работает цвет, а острота остаётся на фоне.
    </p>
    <table>
      <thead>
        <tr><th>Свойство</th><th>Значение</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>Острота (SHU)</strong></td><td><10,000</td></tr>
        <tr><td><strong>Регион</strong></td><td>Шаньдун, Хэбэй</td></tr>
        <tr><td><strong>Лучше всего для</strong></td><td>Слабоострая паприка, цвет</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">Для чего используется перец Wangdu?</h2>
    <ul>
      <li>Слабоострая паприка</li>
      <li>Натуральный красный цвет</li>
      <li>Смеси с акцентом на цвет</li>
    </ul>

    <h2 style="margin-top:32px;">Wangdu против красного Yidu</h2>
    <p>
      Красный Yidu и Wangdu — слабоострая пара ниже 10 000 SHU. Оба питают слабоострый сорт паприки — порошок с акцентом на цвет, где SHU остаётся ниже 10 000. Указывайте сорт и целевое значение ASTA: цвет и острота независимы.
    </p>

    <h2 style="margin-top:32px;">Wangdu в цифрах</h2>
    <p>
      Wangdu ниже 10 000 SHU — как минимум в 5 раз мягче средней полосы (Xian, Jinta при 10 000–20 000) и в 100+ раз мягче Chilli King (свыше 50 000). Его покупают за цвет, а не за остроту.
    </p>
    <p class="data-note">
      Значения остроты репрезентативны для каждого сорта. Уточняйте точное окно SHU, форму и
      помол при запросе.
    </p>

    <BuyerSpec rows={buyerSpec} lang="ru" confirmText="Уточнить спецификацию" />

    <h2 style="margin-top:32px;">В той же полосе ниже 10 000 SHU</h2>
    <p>
      Другие варианты этой полосы: красный Yidu, <a href="/ru/products/paprika-powder/">Паприка в Порошке</a>.
    </p>

    <h2 style="margin-top:32px;">Часто задаваемые вопросы</h2>
    <div class="faq-item">
      <h3>Что такое перец Wangdu?</h3>
      <p>Wangdu — слабоострый перец ниже 10 000 SHU из Шаньдуна и Хэбэя, используется вместе с красным Yidu для слабоострой паприки и натурального красного цвета.</p>
    </div>
    <div class="faq-item">
      <h3>Насколько острым является перец Wangdu?</h3>
      <p>Wangdu — слабая острота — ниже 10 000 SHU, как минимум в 5 раз мягче средней полосы (Xian и Jinta) и намного ниже сверхострых сортов. Это сорт, ориентированный на цвет.</p>
    </div>
    <div class="faq-item">
      <h3>Для чего используется перец Wangdu?</h3>
      <p>Wangdu используется вместе с красным Yidu для слабоострой паприки и натурального цвета. Указывайте сорт и целевое значение ASTA — цвет и острота независимы.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ru/contact/">Запросить Котировку Wangdu</a>
      <a class="cta cta-outline" href="/ru/products/dried-chillies/" style="margin-left:8px;">Сушёный чили →</a>
    </div>
  </div>
</BaseLayout>
