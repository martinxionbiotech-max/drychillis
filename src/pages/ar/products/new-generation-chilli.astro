---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BuyerSpec from "../../../components/BuyerSpec.astro";
import AtAGlance from "../../../components/AtAGlance.astro";

const buyerSpec = [
  { param: "شكل المنتج", value: "تأكيد المواصفات" },
  { param: "الصنف", value: "فلفل نيو جينيريشن" },
  { param: "مستوى الحرارة (SHU)", value: "20,000–50,000" },
  { param: "قيمة اللون ASTA", value: "تأكيد المواصفات" },
  { param: "حجم الشبكة (Mesh)", value: "تأكيد المواصفات" },
  { param: "الرطوبة", value: "<13%" },
  { param: "المعالجة", value: "تأكيد المواصفات" },
  { param: "الشهادات", value: "ISO 9001 وHACCP قياسيًا — BRC وحلال وكوشر عند الطلب" },
];

const glanceFacts = [
  { label: "مستوى الحرارة", value: "20,000–50,000 SHU" },
  { label: "المنطقة", value: "شاندونغ" },
  { label: "الأنسب لـ", value: "خلطات التوابل، مسحوق الفلفل" },
  { label: "الشهادات", value: "ISO 9001 وHACCP" },
];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "https://drychillis.com/products/new-generation-chilli/#product",
  "name": "فلفل نيو جينيريشن",
  "description": "فلفل نيو جينيريشن — فلفل عالي الحرارة عند 20,000–50,000 SHU من شاندونغ، لخلطات التوابل ومسحوق الفلفل. مصنع صيني، ISO 9001 وHACCP.",
  "image": ["https://drychillis.com/images/products/chilli-whole.jpg"],
  "url": "https://drychillis.com/products/new-generation-chilli/",
  "sku": "TENDA-NEW-GENERATION-CHILLI",
  "category": "البهارات والتوابل",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "مستوى الحرارة (SHU)", "value": "20,000–50,000", "unitText": "SHU" },
    { "@type": "PropertyValue", "name": "المنطقة", "value": "شاندونغ" },
    { "@type": "PropertyValue", "name": "الأنسب لـ", "value": "خلطات التوابل، مسحوق الفلفل" }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هو فلفل نيو جينيريشن؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نيو جينيريشن فلفل عالي الحرارة عند 20,000–50,000 SHU من شاندونغ، يُستخدم أساسًا لخلطات التوابل ومسحوق الفلفل. يقع في نفس نطاق سانينغ وزيدانتو وسفن ستار."
      }
    },
    {
      "@type": "Question",
      "name": "ما مدى حرارة فلفل نيو جينيريشن؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نيو جينيريشن عالي الحرارة عند 20,000–50,000 SHU — قوي وثابت، أعلى من الأصناف المتوسطة مثل شيان وجينتا وأقل من نطاق الحرارة الفائقة فوق 50,000 SHU. حدد نافذة SHU دقيقة بدلًا من رقم واحد."
      }
    },
    {
      "@type": "Question",
      "name": "فيمَ يُستخدم فلفل نيو جينيريشن؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُشترى نيو جينيريشن لخلطات التوابل ومسحوق الفلفل والرقائق. الحرارة واللون والنكهة تتغير باستقلالية، لذا اذكر الصنف ونافذة SHU للحفاظ على اتساق الخلطة."
      }
    }
  ]
};
---

<BaseLayout
  title="فلفل نيو جينيريشن — 20,000–50,000 SHU | Tenda Peppers"
  description="فلفل نيو جينيريشن — فلفل عالي الحرارة عند 20,000–50,000 SHU من شاندونغ، لخلطات التوابل ومسحوق الفلفل. مصنع صيني، ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; نيو جينيريشن
    </nav>
    <h1>فلفل نيو جينيريشن</h1>
    <p class="lead">
      فلفل عالي الحرارة عند 20,000–50,000 SHU من شاندونغ، يُشترى لخلطات التوابل ومسحوق الفلفل.
    </p>
    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> نيو جينيريشن فلفل عالي الحرارة (20,000–50,000 SHU) من شاندونغ، يُستخدم لخلطات التوابل ومسحوق الفلفل. يشارك نطاق الحرارة العالية مع سانينغ وزيدانتو وسفن ستار — حرارة بارزة، لكن ليس في الطرف الأقصى من السلم.
    </div>
    <AtAGlance facts={glanceFacts} lang="ar" />
    <div class="product-media">
      <img src="/images/products/chilli-whole.jpg" alt="فلفل مجفف كامل" width="1400" height="1050" loading="eager" />
    </div>
    <p class="product-price" style="font-weight:600;color:#8a1c1c;margin:10px 0 0;">يُؤكَّد السعر عند طلب العرض — يُتفق على الحد الأدنى للطلب والتعبئة والمواصفات قبل الطلب.</p>

    <h2 style="margin-top:32px;">ما هو فلفل نيو جينيريشن؟</h2>
    <p>
      نيو جينيريشن فلفل عالي الحرارة عند 20,000–50,000 SHU من شاندونغ. يظهر في صفحة <a href="/ar/heat-levels/high-heat/">الحرارة العالية</a> إلى جانب سانينغ وزيدانتو وسفن ستار، ويُشترى أساسًا لخلطات التوابل والمسحوق — منتجات تكون الحرارة فيها سمة محددة لكنها ليست النقطة الوحيدة.
    </p>
    <table>
      <thead>
        <tr><th>الخاصية</th><th>التفاصيل</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>الحرارة (SHU)</strong></td><td>20,000–50,000</td></tr>
        <tr><td><strong>المنطقة</strong></td><td>شاندونغ</td></tr>
        <tr><td><strong>الأنسب لـ</strong></td><td>خلطات التوابل، مسحوق الفلفل</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">فيمَ يُستخدم فلفل نيو جينيريشن؟</h2>
    <ul>
      <li>خلطات التوابل</li>
      <li>مسحوق الفلفل</li>
      <li>رقائق الفلفل</li>
    </ul>

    <h2 style="margin-top:32px;">نيو جينيريشن مقابل سانينغ مقابل زيدانتو</h2>
    <p>
      سانينغ (تيانينغ) وزيدانتو هما الصنفان الكلاسيكيان للصلصة الحارة عند 20,000–50,000 SHU؛ أما نيو جينيريشن فيُشترى أكثر لخلطات التوابل والمسحوق. جميعها في نفس النطاق، لذا تتغير الحرارة واللون والنكهة باستقلالية — اذكر الصنف ونافذة SHU دقيقة في مواصفاتك.
    </p>

    <h2 style="margin-top:32px;">نيو جينيريشن بالأرقام</h2>
    <p>
      يقع نيو جينيريشن عند 20,000–50,000 SHU — أوسع نطاق بارز الحرارة في سلّمنا، أعلى من الأصناف المتوسطة مثل شيان وجينتا (10,000–20,000) وأقل من نطاق الحرارة الفائقة فوق 50,000 SHU.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكّد نافذة SHU والشكل والشبكة بدقة عند الاستفسار.
    </p>

    <BuyerSpec rows={buyerSpec} lang="ar" confirmText="تأكيد المواصفات" />

    <h2 style="margin-top:32px;">في نفس نطاق 20,000–50,000 SHU</h2>
    <p>
      أصناف أخرى في هذا النطاق: <a href="/ar/products/sanying-chilli/">سانينغ</a>، <a href="/ar/products/seven-star-chilli/">سفن ستار</a>.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما هو فلفل نيو جينيريشن؟</h3>
      <p>نيو جينيريشن فلفل عالي الحرارة عند 20,000–50,000 SHU من شاندونغ، يُستخدم أساسًا لخلطات التوابل ومسحوق الفلفل. يقع في نفس نطاق سانينغ وزيدانتو وسفن ستار.</p>
    </div>
    <div class="faq-item">
      <h3>ما مدى حرارة فلفل نيو جينيريشن؟</h3>
      <p>نيو جينيريشن عالي الحرارة عند 20,000–50,000 SHU — قوي وثابت، أعلى من الأصناف المتوسطة مثل شيان وجينتا وأقل من نطاق الحرارة الفائقة فوق 50,000 SHU. حدد نافذة SHU دقيقة بدلًا من رقم واحد.</p>
    </div>
    <div class="faq-item">
      <h3>فيمَ يُستخدم فلفل نيو جينيريشن؟</h3>
      <p>يُشترى نيو جينيريشن لخلطات التوابل ومسحوق الفلفل والرقائق. الحرارة واللون والنكهة تتغير باستقلالية، لذا اذكر الصنف ونافذة SHU للحفاظ على اتساق الخلطة.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر نيو جينيريشن</a>
      <a class="cta cta-outline" href="/ar/products/dried-chillies/" style="margin-left:8px;">الفلفل المجفف ←</a>
    </div>
  </div>
</BaseLayout>
