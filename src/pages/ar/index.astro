---
import BaseLayout from "../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هي منتجات الفلفل الحلو والفلفل الحار التي تصنعها Tenda Peppers؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تصنع Tenda Peppers عائلتين من المنتجات: مسحوق الفلفل الحلو (الفلفل الحلو والفلفل الحلو منخفض الحرارة) والفلفل الحار المجفف (فلفل حار مجفف كامل، ورقائق فلفل حار، ومسحوق فلفل حار، وقطع فلفل حار)، وتغطي مستويات الحرارة من الفلفل الحلو أقل من 500 وحدة سكوفيل إلى الفلفل الحار أكثر من 50,000 وحدة سكوفيل."
      }
    },
    {
      "@type": "Question",
      "name": "ما الفرق بين الفلفل الحلو ومسحوق الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُصنع الفلفل الحلو من فلفل حلو منخفض الحرارة وعالي اللون (عادة أقل من 10,000 وحدة سكوفيل) ويُستخدم أساسًا للتلوين الأحمر الطبيعي والنكهة المعتدلة. يُصنع مسحوق الفلفل الحار من أصناف أكثر حرارة (20,000–50,000+ وحدة سكوفيل) ويُستخدم لإضافة الحرارة. يخدمان أغراضًا مختلفة في تصنيع الأغذية."
      }
    },
    {
      "@type": "Question",
      "name": "ما الشهادات التي تحملها Tenda Peppers؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تحمل Tenda Peppers شهادتي ISO 9001 (إدارة الجودة) وHACCP (سلامة الأغذية). يتم الإنتاج تحت نظام سلامة أغذية بصفر عيوب وصفر تسامح، مع فحص بالأشعة السينية وفرز بالألوان وكشف المعادن."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكنكم توريد مواصفات مخصصة للفلفل الحلو والفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم. يمكن توريد الفلفل الحلو والفلفل الحار وفقًا لقيمة اللون ASTA ومستوى الحرارة (SHU) وحجم الشبكة ومواصفات الرطوبة المستهدفة. تواصل معنا بمواصفاتك المستهدفة للحصول على عرض سعر مطابق."
      }
    }
  ]
};
---

<BaseLayout
  lang="ar"
  title="Tenda Peppers | مصنّع الفلفل الحار المجفف ومسحوق الفلفل الحار"
  description="شركة تصنيع صينية لمسحوق الفلفل الحلو والفلفل الحار المجفف. فلفل حلو، رقائق، مسحوق وفلفل كامل. حاصلة على ISO 9001 وHACCP."
  jsonLd={[faqJsonLd]}
>
    <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
      <h1>فلفل حار مجفف ومسحوق فلفل حار،<br />مزروع ومطحون في الصين.</h1>
      <p>
        تصنع Tenda Peppers الفلفل الحار المجفف ومسحوق الفلفل الحار من 12 قاعدة زراعة في
        شاندونغ وشينجيانغ وخنان — مطحون تحت ISO 9001 وHACCP مع فحص بالأشعة السينية وفرز بالألوان.
        نورد لمصنّعي الأغذية في أوروبا والشرق الأوسط وأمريكا الشمالية.
      </p>
      <div class="hero-actions">
        <a class="cta" href="/ar/products/dried-chillies/">الفلفل الحار المجفف ومسحوق الفلفل الحار</a>
        <a class="cta cta-outline" href="/ar/products/paprika/">مسحوق الفلفل الحلو</a>
      </div>
      </div>
      <div class="hero-products">
        <a class="hero-product" href="/ar/products/paprika/">
          <img src="/images/products/paprika-powder.jpg" alt="مسحوق الفلفل الحلو" width="1360" height="1400" loading="eager" />
          <span class="hero-product__label">مسحوق الفلفل الحلو</span>
        </a>
        <a class="hero-product" href="/ar/products/dried-chillies/">
          <img src="/images/products/chilli-whole.jpg" alt="الفلفل المجفف" width="1400" height="1050" loading="eager" />
          <span class="hero-product__label">الفلفل المجفف</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>عائلتان من المنتجات</h2>
      <p class="lead">
        نركز على محصول واحد — الفلفل — ونطحنه إلى عائلتين من المنتجات لصناعة الأغذية:
        الفلفل الحلو المركّز على اللون والفلفل الحار المجفف المركّز على الحرارة.
      </p>
      <div class="grid grid-2">
        <div class="card">
          <h3>مسحوق الفلفل الحلو</h3>
          <p>
            فلفل حلو منخفض الحرارة وعالي اللون مصنوع من أصناف الفلفل الحلو (فلفل شينجيانغ الحلو،
            ييدو الأحمر). يُستخدم للتلوين الأحمر الطبيعي وخلطات التوابل والتتبيلات.
          </p>
          <a href="/ar/products/paprika/">عرض الفلفل الحلو ←</a>
        </div>
        <div class="card">
          <h3>الفلفل الحار المجفف</h3>
          <p>
            فلفل كامل ورقائق ومسحوق وقطع بمستويات حرارة من 10,000 إلى 50,000+ وحدة سكوفيل —
            للصلصات والوجبات الخفيفة والتوابل وخدمات الطعام.
          </p>
          <a href="/ar/products/dried-chillies/">عرض الفلفل الحار ←</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>لماذا Tenda Peppers</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3>12 قاعدة زراعة</h3>
          <p>مواد خام قابلة للتتبع من قواعد زراعة فلفل خاضعة للرقابة في شاندونغ وشينجيانغ وخنان.</p>
        </div>
        <div class="card">
          <h3>ISO 9001 وHACCP</h3>
          <p>أنظمة معتمدة للجودة وسلامة الأغذية، مع فحص بالأشعة السينية وفرز بالألوان وكشف المعادن.</p>
        </div>
        <div class="card">
          <h3>طاقة إنتاجية 10,000+ طن</h3>
          <p>ثلاثة خطوط إنتاج عالية الجودة مع 30,000 متر مربع من مساحة المصنع وتخزين مبرد.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>مستويات الحرارة التي نوردها</h2>
      <table>
        <thead>
          <tr><th>مستوى الحرارة</th><th>نطاق SHU</th><th>الأصناف الممثلة</th><th>شكل المنتج</th></tr>
        </thead>
        <tbody>
          <tr><td>حلو / منخفض الحرارة</td><td>&lt;500 – 10,000</td><td>فلفل شينجيانغ الحلو، ييدو الأحمر، وانغدو</td><td>مسحوق فلفل حلو</td></tr>
          <tr><td>حرارة متوسطة</td><td>10,000 – 20,000</td><td>فلفل شيان، جينتا، إرجينغتياو</td><td>رقائق فلفل حار، مسحوق متوسط</td></tr>
          <tr><td>حرارة عالية</td><td>20,000 – 50,000</td><td>فلفل سانيينغ، زيدانتو، الجيل الجديد</td><td>مسحوق فلفل حار، رقائق</td></tr>
          <tr><td>حار جدًا</td><td>&gt;50,000</td><td>فلفل جيكسين، فلفل شياومي، ملك الفلفل</td><td>قطع فلفل حار، مسحوق</td></tr>
        </tbody>
      </table>
      <p class="data-note" style="margin-top:12px;">
        مستويات الحرارة تمثيلية لأصناف الفلفل الصينية. أكّد SHU المستهدف وقيمة اللون ASTA عند الاستفسار.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>أدلة تقنية</h2>
      <p class="lead" style="margin-bottom:24px;">
        إرشادات متعمقة من مركز المعرفة الخاص بـ Tenda Peppers — المواصفات والمعايير ومعرفة
        التوريد لمشتري الفلفل الحلو والفلفل الحار المجفف.
      </p>
      <div class="grid grid-3">
        <div class="card">
          <h3>دليل شراء الفلفل الحلو والفلفل الحار</h3>
          <p>كيفية تحديد قيمة اللون ومستوى الحرارة والشبكة والرطوبة لتطبيقك.</p>
          <a href="https://docs.drychillis.com/buying-guide/">اقرأ الدليل ←</a>
        </div>
        <div class="card">
          <h3>شرح لون ASTA ووحدات SHU</h3>
          <p>ما معنى قيمة اللون ASTA ووحدات سكوفيل، وكيفية قراءتها.</p>
          <a href="https://docs.drychillis.com/asta-shu-explained/">اقرأ الدليل ←</a>
        </div>
        <div class="card">
          <h3>أصناف الفلفل ودرجاته</h3>
          <p>أصناف الفلفل الصينية الرئيسية ومناطقها ومستويات حرارتها وأفضل استخداماتها.</p>
          <a href="https://docs.drychillis.com/chilli-varieties/">اقرأ الدليل ←</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>الأسئلة الشائعة</h2>
      <div class="faq-item">
        <h3>ما هي منتجات الفلفل الحلو والفلفل الحار التي تصنعها Tenda Peppers؟</h3>
        <p>تصنع Tenda Peppers عائلتين من المنتجات: مسحوق الفلفل الحلو (الفلفل الحلو والفلفل الحلو منخفض الحرارة) والفلفل الحار المجفف (فلفل حار مجفف كامل، ورقائق فلفل حار، ومسحوق فلفل حار، وقطع فلفل حار)، وتغطي مستويات الحرارة من الفلفل الحلو أقل من 500 وحدة سكوفيل إلى الفلفل الحار أكثر من 50,000 وحدة سكوفيل.</p>
      </div>
      <div class="faq-item">
        <h3>ما الفرق بين الفلفل الحلو ومسحوق الفلفل الحار؟</h3>
        <p>يُصنع الفلفل الحلو من فلفل حلو منخفض الحرارة وعالي اللون (عادة أقل من 10,000 وحدة سكوفيل) ويُستخدم أساسًا للتلوين الأحمر الطبيعي والنكهة المعتدلة. يُصنع مسحوق الفلفل الحار من أصناف أكثر حرارة (20,000–50,000+ وحدة سكوفيل) ويُستخدم لإضافة الحرارة.</p>
      </div>
      <div class="faq-item">
        <h3>ما الشهادات التي تحملها Tenda Peppers؟</h3>
        <p>تحمل Tenda Peppers شهادتي ISO 9001 (إدارة الجودة) وHACCP (سلامة الأغذية). يتم الإنتاج تحت نظام سلامة أغذية بصفر عيوب وصفر تسامح، مع فحص بالأشعة السينية وفرز بالألوان وكشف المعادن.</p>
      </div>
      <div class="faq-item">
        <h3>هل يمكنكم توريد مواصفات مخصصة للفلفل الحلو والفلفل الحار؟</h3>
        <p>نعم. يمكن توريد الفلفل الحلو والفلفل الحار وفقًا لقيمة اللون ASTA ومستوى الحرارة (SHU) وحجم الشبكة ومواصفات الرطوبة المستهدفة. تواصل معنا بمواصفاتك المستهدفة للحصول على عرض سعر مطابق.</p>
      </div>
    </div>
  </section>
</BaseLayout>
