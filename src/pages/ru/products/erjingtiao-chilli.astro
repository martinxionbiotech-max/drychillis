---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildOffers, priceLine } from "../../../data/product-offers";

const productUrl = "https://drychillis.com/ru/products/erjingtiao-chilli/";
const productOffers = buildOffers("erjingtiao-chilli", productUrl);

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "https://drychillis.com/ru/products/erjingtiao-chilli/#product",
  "name": "Перец Эрцзинтяо",
  "description": "Тонкий ароматный перец из Сычуани, 15 000–30 000 SHU — основа вкуса хот-пота, масла чили и доубаньцзяна.",
  "image": ["https://drychillis.com/images/products/chilli-whole.jpg"],
  "url": "https://drychillis.com/ru/products/erjingtiao-chilli/",
  "sku": "TENDA-ERJINGTIAO-CHILLI",
  "category": "Специи и приправы",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  ...(productOffers ? { "offers": productOffers } : {}),
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Острота (SHU)", "value": "15 000 – 30 000 (средне-высокая)" },
    { "@type": "PropertyValue", "name": "Регион", "value": "Сычуань (Чэндуская равнина)" },
    { "@type": "PropertyValue", "name": "Тип плода", "value": "Тонкий морщинистый стручок с тонкой мякотью" },
    { "@type": "PropertyValue", "name": "Лучше всего для", "value": "Хот-пот, доубаньцзян, масло чили, паста" }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Что такое перец Эрцзинтяо?",
      "acceptedAnswer": { "@type": "Answer", "text": "Эрцзинтяо (二荆条) — тонкий ароматный перец из Сычуани примерно 15 000–30 000 SHU, основа вкуса хот-пота, масла чили и доубаньцзяна. Его покупают ради аромата, а не ради остроты." } },
    { "@type": "Question", "name": "Насколько остр перец Эрцзинтяо?",
      "acceptedAnswer": { "@type": "Answer", "text": "Он находится в верхней части среднего диапазона — примерно 15 000–30 000 SHU: в 15–30 раз острее сладкой паприки и мягче Санин и Цзыданьтоу. Острота зависит от региона выращивания, поэтому диапазон стоит подтверждать." } },
    { "@type": "Question", "name": "Для чего используют Эрцзинтяо?",
      "acceptedAnswer": { "@type": "Answer", "text": "Это классика сычуаньской кухни: основа хот-пота, доубаньцзян (ферментированная бобовая паста), масло чили и ферментированная паста из перца. Важен аромат, а не острота, поэтому его используют целиком или крупно дроблённым." } }
  ]
};
---

<BaseLayout
  title="Перец Эрцзинтяо — 15 000–30 000 SHU | Tenda Peppers"
  description="Эрцзинтяо (二荆条) — ароматный перец из Сычуани, 15 000–30 000 SHU, для хот-пота, доубаньцзяна и масла чили. Китайский производитель, ISO 9001 и HACCP."
  lang="ru"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ru/">Главная</a> &rsaquo; <a href="/ru/products/dried-chillies/">Сушёный перец</a> &rsaquo; Эрцзинтяо
    </nav>
    <h1>Перец Эрцзинтяо</h1>
    <p class="lead">
      Тонкий ароматный перец из Сычуани примерно 15 000–30 000 SHU — основа вкуса хот-пота,
      масла чили и доубаньцзяна. Его покупают ради аромата, а не ради остроты.
    </p>
    <p class="product-price" style="font-weight:600;color:#8a1c1c;margin:10px 0 0;">{priceLine("erjingtiao-chilli", "ru")}</p>

    <h2 style="margin-top:32px;">Что такое перец Эрцзинтяо?</h2>
    <p>
      Эрцзинтяо — тонкий морщинистый сычуаньский перец, чьё название приблизительно переводится как
      «полоска с двумя шипами», по характерной сужающейся форме стручка. Он держится на уровне
      примерно 15 000–30 000 SHU — верх среднего диапазона — и выращивается по всему Сычуаньскому
      бассейну. В отличие от «цветных» сортов (Цзиньта) или «острых» (Санин, Цзисинь), Эрцзинтяо
      выбирают ради <strong>аромата</strong>.
    </p>
    <table>
      <thead><tr><th>Свойство</th><th>Подробности</th></tr></thead>
      <tbody>
        <tr><td><strong>Острота (SHU)</strong></td><td>15 000 – 30 000 (средне-высокая)</td></tr>
        <tr><td><strong>Регион</strong></td><td>Сычуань (Чэндуская равнина)</td></tr>
        <tr><td><strong>Тип плода</strong></td><td>Тонкий морщинистый стручок с тонкой мякотью</td></tr>
        <tr><td><strong>Лучше всего для</strong></td><td>Хот-пот, доубаньцзян, масло чили, паста</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      SHU — репрезентативный диапазон (средняя уверенность); он зависит от региона выращивания в
      Сычуани. Подтвердите нужный диапазон с нами.
    </p>

    <h2 style="margin-top:32px;">Для чего используют Эрцзинтяо?</h2>
    <ul>
      <li>Основа хот-пота и супа мала</li>
      <li>Доубаньцзян (ферментированная бобовая паста)</li>
      <li>Масло чили и настоянные масла</li>
      <li>Ферментированная паста из перца и приправы</li>
    </ul>

    <h2 style="margin-top:32px;">Почему аромат теряется в тонком помоле</h2>
    <p>
      Аромат Эрцзинтяо идёт от тонкой мякоти и высокого отношения поверхности к объёму: та же
      геометрия, что делает его ароматным, делает его хрупким. Тонкий помол открывает воздуху больше
      ароматической поверхности, поэтому летучий аромат уходит быстрее, чем у сорта с толстой мякотью.
      Поэтому Эрцзинтяо традиционно используют <strong>целиком или крупно дроблённым</strong>: помол
      20–40 меш сохраняет аромат намного дольше, чем порошок 80 меш.
    </p>

    <h2 style="margin-top:32px;">Эрцзинтяо, Цзиньта и Сянь</h2>
    <table>
      <thead><tr><th>Сорт</th><th>SHU</th><th>Ради чего покупают</th><th>Лучшая форма</th></tr></thead>
      <tbody>
        <tr><td><strong>Эрцзинтяо</strong></td><td>15 000 – 30 000</td><td>Аромат, благоухание</td><td>Целиком, крупный помол, паста</td></tr>
        <tr><td><strong>Цзиньта</strong></td><td>10 000 – 20 000</td><td>Цвет, глянцевый вид</td><td>Видимые хлопья</td></tr>
        <tr><td><strong>Сянь</strong></td><td>10 000 – 20 000</td><td>Универсальный тёмно-красный</td><td>Порошок, соус</td></tr>
      </tbody>
    </table>
    <p>
      Правило выбора: судите по тому, чем оценивают готовый продукт. Если ароматом — основа
      хот-пота или доубаньцзян — побеждает Эрцзинтяо. Если видом хлопьев — Цзиньта. Если нужен
      универсальный красный порошок — Сянь.
    </p>

    <h2 style="margin-top:32px;">Как задать спецификацию Эрцзинтяо</h2>
    <p>
      Укажите сорт, форму (целиком, крупный помол или паста), целевой диапазон SHU и меш. Для
      продуктов, чувствительных к аромату, предпочитайте целые стручки или помол 20–40 меш и
      подтверждайте влажность ниже 13%. Если продукт — тонкий порошок, скажите нам: мы подскажем
      смеси, сохраняющие и остроту, и аромат.
    </p>

    <h2 style="margin-top:32px;">Часто задаваемые вопросы</h2>
    <div class="faq-item">
      <h3>Что такое перец Эрцзинтяо?</h3>
      <p>Эрцзинтяо (二荆条) — тонкий ароматный перец из Сычуани примерно 15 000–30 000 SHU, основа вкуса хот-пота, масла чили и доубаньцзяна. Его покупают ради аромата, а не остроты.</p>
    </div>
    <div class="faq-item">
      <h3>Насколько остр Эрцзинтяо?</h3>
      <p>Примерно 15 000–30 000 SHU — верх среднего диапазона, в 15–30 раз острее сладкой паприки и мягче Санин и Цзыданьтоу.</p>
    </div>
    <div class="faq-item">
      <h3>Для чего используют Эрцзинтяо?</h3>
      <p>В сычуаньской кухне: основа хот-пота, доубаньцзян, масло чили и ферментированная паста из перца. Важен аромат, а не острота.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ru/contact/">Запросить цену на Эрцзинтяо</a>
      <a class="cta cta-outline" href="/ru/products/dried-chillies/" style="margin-left:8px;">Сушёный перец →</a>
    </div>
  </div>
</BaseLayout>
