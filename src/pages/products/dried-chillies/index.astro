const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What dried chilli products does Tenda Peppers supply?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We supply four product forms — whole dried chillies, chilli flakes (crushed chilli), chilli powder and chilli segments — covering heat levels from about 10,000 to 70,000+ SHU across Chinese chilli varieties."
      }
    },
    {
      "@type": "Question",
      "name": "What heat level (SHU) do I need?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Medium heat (10,000–20,000 SHU) suits general seasoning and snacks; high heat (20,000–50,000 SHU) suits hot sauces and industrial food; extra hot (over 50,000 SHU) is for extreme-heat products and Sichuan-style dishes. Tell us your target SHU and we match the variety."
      }
    },
    {
      "@type": "Question",
      "name": "Can you supply whole dried chillies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We supply whole dried chillies in varieties including lantern pepper, Jinta pepper, facing-heaven pepper and Xiaomi pepper, with size and moisture graded to specification."
      }
    },
    {
      "@type": "Question",
      "name": "How is colour and heat controlled?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Heat and colour are controlled at source through variety selection and grade control, then verified in-house. Every batch passes de-seeding, magnet filtration, X-ray inspection and colour sorting."
      }
    },
    {
      "@type": "Question",
      "name": "What are the moisture and mesh specifications?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dried chillies are typically supplied at under 13% moisture, with chilli powder ground to 60–80 mesh, adjustable to your requirement. Exact mesh and moisture are confirmed against your target specification and documented in the quotation."
      }
    },
    {
      "@type": "Question",
      "name": "Which varieties are best for hot sauce or extreme heat?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "High-heat varieties such as Sanying (Tianying), Zidantou and Seven-Star (20,000–50,000 SHU) are the workhorses for hot sauce and snack seasoning. For extreme heat, Jixin (50,000–70,000 SHU), Xiaomi and Chilli King exceed 50,000 SHU."
      }
    },
    {
      "@type": "Question",
      "name": "How do I keep heat consistent between batches?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Consistency comes from naming a specific variety (or a precise SHU window) rather than ordering generic 'chilli powder'. Heat, colour and flavour vary independently, so a complete specification names all three — and every batch is traceable to its growing base."
