---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AtAGlance from "../../../components/AtAGlance.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما الفلفل الأفضل لتوابل الوجبات الخفيفة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "سفن ستار هو المعيار — 20,000–50,000 SHU حرارة عالية تحدد المنتج — عادة كمسحوق للوجبات الخفيفة. سانينغ بديل في نفس النطاق."
      }
    },
    {
      "@type": "Question",
      "name": "ما مدى حرارة الفلفل للوجبات الخفيفة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الحرارة العالية هي المعيار: 20,000–50,000 SHU. ثبّت الصنف ونافذة SHU دقيقة — موجة الحرارة والطعم اللاحق يعتمدان على كليهما."
      }
    },
    {
      "@type": "Question",
      "name": "مسحوق أم رقائق لتوابل الوجبات الخفيفة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "مسحوق (شبكة 60–80) لتغطية متساوية للوجبة الخفيفة. الرقائق لمسة إضافية عندما تريد نقاط حرارة مرئية."
      }
    }
  ]
};

const glanceFacts = [
  { label: "الحرارة", value: "20,000–50,000 SHU" },
  { label: "الصنف المعياري", value: "سفن ستار" },
  { label: "الشكل", value: "مسحوق، رقائق" },
  { label: "يُقيَّم بـ", value: "حرارة تحدد المنتج" }
];
---

<BaseLayout
  title="فلفل لتوابل الوجبات الخفيفة | Tenda Peppers"
  description="فلفل لتوابل الوجبات الخفيفة — سفن ستار عند 20,000–50,000 SHU، حرارة عالية تحدد المنتج، كمسحوق لتغطية متساوية. مصنع صيني، ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/guides/">الأدلة</a> &rsaquo; توابل الوجبات الخفيفة
    </nav>
    <h1>فلفل لتوابل الوجبات الخفيفة</h1>
    <p class="lead">
      تحتاج الوجبات الخفيفة حرارة تحدد المنتج — النطاق العالي 20,000–50,000 SHU. سفن ستار هو المعيار، كمسحوق لتغطية متساوية؛ الرقائق لمسة إضافية عندما تريد نقاط حرارة مرئية.
    </p>

    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> توابل الوجبات الخفيفة تستخدم النطاق العالي — سفن ستار عند 20,000–50,000 SHU — لأن الحرارة تحدد المنتج. استخدم مسحوقًا (شبكة 60–80) لتغطية متساوية؛ الطعم اللاحق يعتمد على الصنف ونافذة SHU التي تثبتها.
    </div>
    <AtAGlance facts={glanceFacts} lang="ar" />

    <h2 style="margin-top:32px;">ما الذي يجعل الفلفل جيدًا للوجبات الخفيفة؟</h2>
    <p>
      تحتاج الوجبات الخفيفة حرارة تحدد المنتج — النطاق العالي 20,000–50,000 SHU. سفن ستار هو معيار الوجبات الخفيفة، والمسحوق (شبكة 60–80) يعطي تغطية متساوية. اطلع على <a href="/ar/products/seven-star-chilli/">فلفل سفن ستار</a>.
    </p>
    <table>
      <thead>
        <tr><th>الصنف / النطاق</th><th>الحرارة (SHU)</th><th>الدور</th><th></th></tr>
      </thead>
      <tbody>
        <tr><td><strong>سفن ستار</strong></td><td>20,000 – 50,000</td><td>معيار توابل الوجبات الخفيفة</td><td><a href="/ar/products/seven-star-chilli/">عرض ←</a></td></tr>
        <tr><td><strong>سانينغ (تيانيينغ)</strong></td><td>20,000 – 50,000</td><td>بديل في نفس النطاق</td><td><a href="/ar/products/sanying-chilli/">عرض ←</a></td></tr>
        <tr><td><strong>النطاق المتوسط</strong></td><td>10,000 – 20,000</td><td>وجبات خفيفة خفيفة</td><td><a href="/ar/heat-levels/medium-heat/">عرض ←</a></td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">كيف تحدد الفلفل للوجبات الخفيفة</h2>
    <p>
      ثبّت الصنف ونافذة SHU دقيقة — موجة الحرارة والطعم اللاحق يعتمدان على كليهما. المسحوق (شبكة 60–80) يعطي تغطية متساوية للوجبة الخفيفة؛ الرقائق لمسة إضافية عندما تريد نقاط حرارة مرئية.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكّد نافذة SHU والشكل والشبكة بدقة عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما الفلفل الأفضل لتوابل الوجبات الخفيفة؟</h3>
      <p>سفن ستار هو المعيار — 20,000–50,000 SHU حرارة عالية تحدد المنتج — عادة كمسحوق للوجبات الخفيفة. سانينغ بديل في نفس النطاق.</p>
    </div>
    <div class="faq-item">
      <h3>ما مدى حرارة الفلفل للوجبات الخفيفة؟</h3>
      <p>الحرارة العالية هي المعيار: 20,000–50,000 SHU. ثبّت الصنف ونافذة SHU دقيقة — موجة الحرارة والطعم اللاحق يعتمدان على كليهما.</p>
    </div>
    <div class="faq-item">
      <h3>مسحوق أم رقائق لتوابل الوجبات الخفيفة؟</h3>
      <p>مسحوق (شبكة 60–80) لتغطية متساوية للوجبة الخفيفة. الرقائق لمسة إضافية عندما تريد نقاط حرارة مرئية.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/products/dried-chillies/">الفلفل المجفف ←</a>
      <a class="cta cta-outline" href="/ar/contact/" style="margin-left:8px;">اطلب عرض سعر</a>
    </div>
  </div>
</BaseLayout>
