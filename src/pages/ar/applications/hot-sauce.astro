---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AtAGlance from "../../../components/AtAGlance.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما الفلفل الذي أستخدمه للصلصة الحارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "أصناف عالية الحرارة في نطاق 20,000–50,000+ SHU — سانينغ أو زيدانتو أو جيشين — عادة على شكل مسحوق أو رقائق. حدّد الصنف ونافذة SHU دقيقة."
      }
    },
    {
      "@type": "Question",
      "name": "كيف أحدد الحرارة للصلصة الحارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "اذكر الصنف ونافذة SHU دقيقة. الحرارة ليست خطية، لذا «حار» ليس مواصفة — اسم الصنف هو ما يثبّت الاتساق بين الدفعات."
      }
    },
    {
      "@type": "Question",
      "name": "هل أحتاج صنفًا ملونًا في الصلصة الحارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، لمعظم الوصفات: الصلصة الحارة تجمع صنف حرارة مع صنف لون/رائحة، لأن الحرارة واللون والرائحة نادرًا ما تبلغ ذروتها في صنف واحد."
      }
    }
  ]
};

const glanceFacts = [
  { label: "نطاق الحرارة", value: "20,000–50,000+ SHU" },
  { label: "الأصناف الرئيسية", value: "سانينغ، زيدانتو، جيشين" },
  { label: "الشكل", value: "مسحوق، رقائق" },
  { label: "يُقيَّم بـ", value: "الحرارة واللون" }
];
---

<BaseLayout
  title="فلفل للصلصة الحارة | Tenda Peppers"
  description="ما الفلفل الذي تستخدمه للصلصة الحارة — سانينغ وزيدانتو وجيشين عند 20,000–50,000+ SHU على شكل مسحوق أو رقائق. مصنع صيني، ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/guides/">الأدلة</a> &rsaquo; الصلصة الحارة
    </nav>
    <h1>فلفل للصلصة الحارة</h1>
    <p class="lead">
      تُقيَّم الصلصة الحارة بالحرارة واللون. الأصناف المعتمدة هي سانينغ وزيدانتو وجيشين في نطاق 20,000–50,000+ SHU، عادة على شكل مسحوق أو رقائق.
    </p>

    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> الصلصة الحارة تريد حرارة عالية — سانينغ أو زيدانتو أو جيشين عند 20,000–50,000+ SHU، على شكل مسحوق أو رقائق. حدّد الصنف ونافذة SHU دقيقة؛ الحرارة ليست خطية، لذا «حار» ليس مواصفة.
    </div>
    <AtAGlance facts={glanceFacts} lang="ar" />

    <h2 style="margin-top:32px;">ما الذي يجعل الفلفل جيدًا للصلصة الحارة؟</h2>
    <p>
      تُقيَّم الصلصة الحارة بالحرارة واللون. استخدم أصنافًا عالية الحرارة — سانينغ أو زيدانتو أو جيشين في نطاق 20,000–50,000+ SHU — عادة على شكل مسحوق أو رقائق. اطلع على <a href="/ar/guides/asta-colour-and-shu-heat-explained/">شرح SHU</a> لمعرفة كيفية قياس الحرارة.
    </p>
    <table>
      <thead>
        <tr><th>الصنف / النطاق</th><th>الحرارة (SHU)</th><th>الدور</th><th></th></tr>
      </thead>
      <tbody>
        <tr><td><strong>سانينغ (تيانيينغ)</strong></td><td>20,000 – 50,000</td><td>صنف الصلصة الحارة الكلاسيكي</td><td><a href="/ar/products/sanying-chilli/">عرض ←</a></td></tr>
        <tr><td><strong>زيدانتو</strong></td><td>20,000 – 50,000</td><td>صنف الصلصة الحارة الكلاسيكي</td><td><a href="/ar/products/zidantou-chilli/">عرض ←</a></td></tr>
        <tr><td><strong>جيشين (قلب الدجاجة)</strong></td><td>50,000 – 70,000</td><td>حرارة قصوى، يُخلط عادة</td><td><a href="/ar/products/jixin-chilli/">عرض ←</a></td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">كيف تحدد الفلفل للصلصة الحارة</h2>
    <p>
      حدّد الصنف ونافذة SHU دقيقة؛ الحرارة ليست خطية، لذا «حار» ليس مواصفة. الصلصة الحارة تجمع صنف حرارة مع صنف لون/رائحة. المسحوق يعطي صلصات ناعمة ولونًا موحدًا؛ الرقائق تعطي ملمسًا مرئيًا.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكّد نافذة SHU والشكل والشبكة بدقة عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما الفلفل الذي أستخدمه للصلصة الحارة؟</h3>
      <p>أصناف عالية الحرارة في نطاق 20,000–50,000+ SHU — سانينغ أو زيدانتو أو جيشين — عادة على شكل مسحوق أو رقائق. حدّد الصنف ونافذة SHU دقيقة.</p>
    </div>
    <div class="faq-item">
      <h3>كيف أحدد الحرارة للصلصة الحارة؟</h3>
      <p>اذكر الصنف ونافذة SHU دقيقة. الحرارة ليست خطية، لذا «حار» ليس مواصفة — اسم الصنف هو ما يثبّت الاتساق بين الدفعات.</p>
    </div>
    <div class="faq-item">
      <h3>هل أحتاج صنفًا ملونًا في الصلصة الحارة؟</h3>
      <p>نعم، لمعظم الوصفات: الصلصة الحارة تجمع صنف حرارة مع صنف لون/رائحة، لأن الحرارة واللون والرائحة نادرًا ما تبلغ ذروتها في صنف واحد.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/products/dried-chillies/">الفلفل المجفف ←</a>
      <a class="cta cta-outline" href="/ar/contact/" style="margin-left:8px;">اطلب عرض سعر</a>
    </div>
  </div>
</BaseLayout>
