const articleJsonLd = {"@context": "https://schema.org", "@type": "TechArticle", "headline": "Malla 60 vs 80: Qué Molido de Polvo Elegir", "description": "Malla 60 son unos 250 µm y malla 80 unos 180 µm — ambos dentro del rango estándar de polvo 60–80 mesh. Qué significa cada molido para dispersión y sensación en boca.", "image": "https://drychillis.com/images/og-default.jpg", "author": {"@type": "Organization", "name": "Tenda Peppers", "url": "https://drychillis.com"}, "publisher": {"@id": "https://drychillis.com/#organization"}, "datePublished": "2026-09-23", "dateModified": "2026-09-23", "mainEntityOfPage": {"@type": "WebPage", "@id": "https://drychillis.com/es/guides/60-vs-80-mesh/"}};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuál es la diferencia entre malla 60 y 80?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Malla 60 son unos 250 µm y malla 80 unos 180 µm — ambos dentro del rango estándar de polvo 60–80 mesh. El molido de malla 80 es más fino y suave."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuál debo elegir?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "60–80 mesh es el rango estándar de polvo: malla 60 para polvo general y mezclas de condimentos, malla 80 para un polvo más suave. La malla es ajustable a su requisito — nombre la malla o el tamaño de partícula objetivo."
      }
    },
    {
      "@type": "Question",
      "name": "¿Una malla más fina cambia el picor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. La malla mide el molido, no el picor ni el color del chile. Una malla más fina cambia la dispersión, la sensación en boca y la suspensión — no el SHU."
      }
    }
  ]
};

const glanceFacts = [
  { label: "Malla 60", value: "≈250 µm, polvo estándar" },
  { label: "Malla 80", value: "≈180 µm, polvo suave" },
