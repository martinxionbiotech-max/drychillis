---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Paprika Powder (Sweet & Low-Heat)",
  "description": "مُصنّع مسحوق الفلفل الحلو في الصين — فلفل حلو وفلفل حلو منخفض الحرارة، من فلفل شينجيانغ الحلو وYidu red، للتلوين الأحمر الطبيعي وخلطات التوابل والتتبيل. ISO 9001 وHACCP.",
  "image": [
    "https://drychillis.com/images/products/paprika-powder.jpg",
    "https://drychillis.com/images/products/paprika-sweet.jpg",
    "https://drychillis.com/images/products/paprika-low-heat.jpg",
  ],
  "url": "https://drychillis.com/ar/products/paprika/",
  "sku": "TENDA-PAPRIKA-POWDER",
  "category": "Spices and Seasonings",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "ASTA Colour Value", "value": "60–240 (حسب الصنف)" },
    { "@type": "PropertyValue", "name": "Heat Level (SHU)", "value": "<500 – 10,000" },
    { "@type": "PropertyValue", "name": "Moisture", "value": "<13%" },
    { "@type": "PropertyValue", "name": "Mesh", "value": "60–80 mesh" }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "فيمَ يُستخدم مسحوق الفلفل الحلو؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُستخدم مسحوق الفلفل الحلو أساسًا للتلوين الأحمر الطبيعي والنكهة الخفيفة في خلطات التوابل والتتبيل والنقانق وتوابل الوجبات الخفيفة واستخلاص أوليوريزين الفلفل الحلو (ملوّن أحمر طبيعي E160c)."
      }
    },
    {
      "@type": "Question",
      "name": "ما الفرق بين الفلفل الحلو والفلفل الحلو منخفض الحرارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الفلفل الحلو (أقل من 500 SHU) يُصنع من أصناف الفلفل الحلو عالية اللون مثل فلفل شينجيانغ الحلو وRed Dragon 23، بقيمة لون ASTA من 8–18. أما الفلفل الحلو منخفض الحرارة (أقل من 10,000 SHU) فيأتي من أصناف مثل Yidu red وWangdu، ويضيف حرارة خفيفة ورائحة فلفل واضحة فوق اللون."
      }
    },
    {
      "@type": "Question",
      "name": "ما قيمة اللون ASTA التي يمكنكم توريدها؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نورّد مسحوق الفلفل الحلو بنطاق قيمة لون ASTA من نحو 60 إلى 240، حسب الصنف والدرجة. أكّد قيمة اللون ومستوى الحرارة المستهدف عند الاستفسار."
      }
    },
    {
      "@type": "Question",
      "name": "ما مواصفات الرطوبة والميش؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُورَّد مسحوق الفلفل الحلو عادةً برطوبة أقل من 13% وميش 60–80، مع مواصفات قابلة للتعديل. الفحص بالأشعة السينية والكشف عن المعادن قياسيان في كل دفعة."
      }
    },
    {
      "@type": "Question",
      "name": "ما الفرق بين الفلفل الحلو ومسحوق الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الفلفل الحلو يُصنع من فلفل حلو منخفض الحرارة عالي اللون (أقل من 10,000 SHU) ويُستخدم للتلوين والنكهة الخفيفة. مسحوق الفلفل الحار يُصنع من أصناف أكثر حرارة (20,000–70,000+ SHU) لإضافة الحرارة. وهما غير قابلين للتبادل."
      }
    },
    {
      "@type": "Question",
      "name": "أي صنف من الفلفل الحلو يعطي أقوى لون؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "أصناف الفلفل الحلو عالية اللون من شينجيانغ — مثل Red Dragon 23 وUS Red — تعطي أقوى لون لكل وحدة، وهي المعيار لاستخلاص أوليوريزين الفلفل الحلو والتلوين الغذائي."
      }
    }
  ]
};
---

<BaseLayout
  title="مُصنّع مسحوق الفلفل الحلو والفلفل الحلو منخفض الحرارة | Tenda Peppers"
  description="مُصنّع مسحوق الفلفل الحلو في الصين. فلفل حلو وفلفل حلو منخفض الحرارة، من فلفل شينجيانغ الحلو وYidu red — تلوين أحمر طبيعي لخلطات التوابل والتتبيل والتوابل. ISO 9001 وHACCP."
  ogImage="/images/og-paprika.jpg"
  lang="ar"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; مسحوق الفلفل الحلو
    </nav>
    <h1>مسحوق الفلفل الحلو</h1>
    <p class="lead">
      فلفل حلو منخفض الحرارة وعالي اللون، مطحون من أصناف الفلفل الحلو الصيني — للتلوين الأحمر
      الطبيعي وخلطات التوابل والتتبيل. نوفر درجتين: الفلفل الحلو (أقل من 500 SHU) للون النقي،
      والفلفل الحلو منخفض الحرارة (أقل من 10,000 SHU) للون مع رائحة فلفل واضحة.
    </p>

    <div class="product-media">
      <img src="/images/products/paprika-powder.jpg" alt="مسحوق الفلفل الحلو" width="1360" height="1400" loading="eager" />
    </div>

    <h2 style="margin-top:32px;">ما الفلفل الحلو الذي تورده Tenda Peppers؟</h2>
    <p>
      نطحن محصولًا واحدًا — الفلفل الحلو — إلى درجتين من الفلفل الحلو، حسب مقدار اللون ومقدار
      الحرارة التي يحتاجها تطبيقك.
    </p>
    <table>
      <thead>
        <tr><th>المنتج</th><th>الصنف</th><th>الحرارة (SHU)</th><th>اللون (ASTA)</th><th>الأنسب لـ</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>مسحوق الفلفل الحلو</strong></td>
          <td>فلفل شينجيانغ الحلو، Red Dragon 23</td>
          <td>&lt;500</td>
          <td>8–18 (لون عالٍ)</td>
          <td>التلوين الغذائي، استخلاص الأوليوريزين</td>
        </tr>
        <tr>
          <td><strong>مسحوق الفلفل الحلو منخفض الحرارة</strong></td>
          <td>Yidu red، Wangdu</td>
          <td>&lt;10,000</td>
          <td>عالٍ (لُبّ سميك)</td>
          <td>تلوين مع رائحة فلفل واضحة، التتبيل</td>
        </tr>
      </tbody>
    </table>

    <div class="product-gallery">
      <figure><img src="/images/products/paprika-powder.jpg" alt="مسحوق الفلفل الحلو" loading="lazy" /><figcaption>مسحوق الفلفل الحلو</figcaption></figure>
      <figure><img src="/images/products/paprika-sweet.jpg" alt="مسحوق الفلفل الحلو" loading="lazy" /><figcaption>الفلفل الحلو</figcaption></figure>
      <figure><img src="/images/products/paprika-low-heat.jpg" alt="مسحوق الفلفل الحلو منخفض الحرارة" loading="lazy" /><figcaption>فلفل حلو منخفض الحرارة</figcaption></figure>
    </div>

    <h2 style="margin-top:32px;">ما قيمة اللون ASTA ولماذا تهم؟</h2>
    <p>
      يُشترى الفلفل الحلو باللون. قيمة اللون ASTA هي المعيار الصناعي لقياس اللون الأحمر القابل
      للاستخلاص من الفلفل الحلو — كلما زاد الرقم، زادت قوة التلوين لكل وحدة. يغطي الفلفل الحلو
      التجاري عادةً من 60 إلى 240 ASTA حسب الصنف والدرجة؛ ويحدد الرقم السعر ومدى التلوين لكمية
      معينة.
    </p>
    <p>
      الفلفل الحلو من حزام اللون في شينجيانغ — أصناف مثل Red Dragon 23 وUS Red — هو المعيار للون
      العالي مع حرارة منخفضة، وهو المادة الخام القياسية لأوليوريزين الفلفل الحلو (ملوّن أحمر
      طبيعي E160c).
    </p>

    <h2 style="margin-top:32px;">الفلفل الحلو مقابل الفلفل الحلو منخفض الحرارة</h2>
    <p>
      تؤدي الدرجتان وظائف مختلفة، والفرق هو الحرارة:
    </p>
    <ul>
      <li><strong>الفلفل الحلو</strong> (أقل من 500 SHU) — لون نقي بلا حرارة محسوسة. للتلوين الغذائي والنقانق واستخلاص الأوليوريزين.</li>
      <li><strong>الفلفل الحلو منخفض الحرارة</strong> (أقل من 10,000 SHU) — لون مع رائحة فلفل واضحة وحرارة خفيفة. لخلطات التوابل والتتبيل وتوابل الوجبات الخفيفة.</li>
    </ul>
    <p class="data-note">
      الفلفل الحلو ومسحوق الفلفل الحار غير قابلين للتبادل: الفلفل الحلو أولوية اللون (أقل من
      10,000 SHU)، ومسحوق الفلفل الحار أولوية الحرارة (20,000–70,000+ SHU). انظر مجموعة
      <a href="/ar/products/dried-chillies/">الفلفل المجفف ومسحوق الفلفل الحار</a> للحرارة.
    </p>

    <h2 style="margin-top:32px;">المواصفات</h2>
    <table>
      <thead>
        <tr><th>المعيار</th><th>المدى النموذجي</th></tr>
      </thead>
      <tbody>
        <tr><td>قيمة اللون ASTA</td><td>60–240 (حسب الصنف)</td></tr>
        <tr><td>مستوى الحرارة (SHU)</td><td>&lt;500 – 10,000</td></tr>
        <tr><td>الرطوبة</td><td>&lt;13%</td></tr>
        <tr><td>الميش</td><td>60–80 ميش (قابل للتعديل)</td></tr>
        <tr><td>المعالجة</td><td>نزع البذور، ترشيح مغناطيسي، أشعة سينية، فرز ألوان</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      القيم نطاقات تمثيلية لكل صنف. يُؤكَّد اللون والحرارة والميش والرطوبة الدقيقة وفق مواصفاتك
      وتُوثَّق في العرض.
    </p>

    <h2 style="margin-top:32px;">التطبيقات</h2>
    <ul>
      <li>خلطات التوابل والبهارات</li>
      <li>التتبيل وخلطات اللحوم</li>
      <li>توابل الوجبات الخفيفة والنودلز الفوري</li>
      <li>تلوين النقانق واللحوم المصنّعة</li>
      <li>استخلاص أوليوريزين الفلفل الحلو (ملوّن أحمر طبيعي E160c)</li>
    </ul>

    <h2 style="margin-top:32px;">ماذا يجب أن يسأل المشتري قبل الطلب؟</h2>
    <ul>
      <li><strong>قيمة اللون ASTA المستهدفة</strong> — أكّد قوة التلوين التي تحتاجها (نطاق 60–240)</li>
      <li><strong>مستوى الحرارة</strong> — حلو (أقل من 500 SHU) أو منخفض الحرارة (أقل من 10,000 SHU)</li>
      <li><strong>حجم الميش</strong> — 60–80 ميش قياسي، قابل للتعديل</li>
      <li><strong>الرطوبة</strong> — أكّد أقل من 13% للثبات</li>
      <li><strong>الشهادات</strong> — ISO 9001 وHACCP قياسيان؛ أكّد إذا كنت تحتاج BRC أو حلال أو كوشير</li>
      <li><strong>التعبئة والوجهة</strong> — سائب أو تجزئة أو OEM، مع مجموعة المستندات</li>
    </ul>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>فيمَ يُستخدم مسحوق الفلفل الحلو؟</h3>
      <p>يُستخدم مسحوق الفلفل الحلو أساسًا للتلوين الأحمر الطبيعي والنكهة الخفيفة في خلطات التوابل والتتبيل والنقانق وتوابل الوجبات الخفيفة واستخلاص أوليوريزين الفلفل الحلو (ملوّن أحمر طبيعي E160c).</p>
    </div>
    <div class="faq-item">
      <h3>ما الفرق بين الفلفل الحلو والفلفل الحلو منخفض الحرارة؟</h3>
      <p>الفلفل الحلو (أقل من 500 SHU) يُصنع من أصناف الفلفل الحلو عالية اللون مثل فلفل شينجيانغ الحلو وRed Dragon 23، بقيمة لون ASTA من 8–18. أما الفلفل الحلو منخفض الحرارة (أقل من 10,000 SHU) فيأتي من أصناف مثل Yidu red وWangdu، ويضيف حرارة خفيفة ورائحة فلفل واضحة فوق اللون.</p>
    </div>
    <div class="faq-item">
      <h3>ما قيمة اللون ASTA التي يمكنكم توريدها؟</h3>
      <p>نورّد مسحوق الفلفل الحلو بنطاق قيمة لون ASTA من نحو 60 إلى 240، حسب الصنف والدرجة. أكّد قيمة اللون ومستوى الحرارة المستهدف عند الاستفسار.</p>
    </div>
    <div class="faq-item">
      <h3>ما مواصفات الرطوبة والميش؟</h3>
      <p>يُورَّد مسحوق الفلفل الحلو عادةً برطوبة أقل من 13% وميش 60–80، مع مواصفات قابلة للتعديل. الفحص بالأشعة السينية والكشف عن المعادن قياسيان في كل دفعة.</p>
    </div>
    <div class="faq-item">
      <h3>ما الفرق بين الفلفل الحلو ومسحوق الفلفل الحار؟</h3>
      <p>الفلفل الحلو يُصنع من فلفل حلو منخفض الحرارة عالي اللون (أقل من 10,000 SHU) ويُستخدم للتلوين والنكهة الخفيفة. مسحوق الفلفل الحار يُصنع من أصناف أكثر حرارة (20,000–70,000+ SHU) لإضافة الحرارة. وهما غير قابلين للتبادل.</p>
    </div>
    <div class="faq-item">
      <h3>أي صنف من الفلفل الحلو يعطي أقوى لون؟</h3>
      <p>أصناف الفلفل الحلو عالية اللون من شينجيانغ — مثل Red Dragon 23 وUS Red — تعطي أقوى لون لكل وحدة، وهي المعيار لاستخلاص أوليوريزين الفلفل الحلو والتلوين الغذائي.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر للفلفل الحلو</a>
    </div>

    <div style="margin-top:32px;padding:20px;background:#faf5f2;border-radius:8px;">
      <h2 style="margin-top:0;">وثائق تقنية ذات صلة</h2>
      <ul style="margin-bottom:0;">
        <li><a href="https://docs.drychillis.com/ar/buying-guide/" target="_blank" rel="noopener">دليل شراء الفلفل الحلو والفلفل الحار</a></li>
        <li><a href="https://docs.drychillis.com/ar/asta-shu-explained/" target="_blank" rel="noopener">شرح لون ASTA ووحدات SHU</a></li>
        <li><a href="https://docs.drychillis.com/ar/colour-storage/" target="_blank" rel="noopener">تغير اللون والتخزين</a></li>
      </ul>
      <p class="data-note" style="margin-top:12px;">من <a href="https://docs.drychillis.com/ar/" target="_blank" rel="noopener">مركز المعرفة الخاص بـ Tenda Peppers</a>.</p>
    </div>
  </div>
</BaseLayout>
