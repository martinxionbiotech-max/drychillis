---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  author?: string;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
  lang?: string;
}

const {
  title,
  description = "Tenda Peppers manufactures paprika and dried chillies in China — sweet paprika powder, chilli flakes, chilli powder and whole dried chillies for the European, Middle East and North American markets.",
  canonical,
  ogType = "website",
  ogImage = "/images/og-default.jpg",
  jsonLd,
  author,
  datePublished,
  dateModified,
  noindex = false,
  lang = "en",
} = Astro.props;

const dir = lang === "ar" ? "rtl" : "ltr";

const SITE = "https://drychillis.com";
const BRAND = "Tenda Peppers";
const BRAND_FULL = "Tenda Peppers — Paprika & Dried Chillies Manufacturer";

// 语言 → locale 元数据
const LOCALES: Record<string, { code: string; og: string }> = {
  en: { code: "en", og: "en_US" },
  es: { code: "es", og: "es_ES" },
  ar: { code: "ar", og: "ar_AE" },
};
const locale = LOCALES[lang] ?? LOCALES.en;

const cleanTitle = title.replace(/\u200b/gi, "").trim();
const hasBrand = cleanTitle.toUpperCase().includes("TENDA") || cleanTitle.toUpperCase().includes("DRYCHILLIS");
const baseTitle = cleanTitle || BRAND_FULL;
const fullTitle = hasBrand ? baseTitle : `${baseTitle} | ${BRAND}`;

const canonicalUrl = canonical
  ? (canonical.startsWith("http") ? canonical : SITE + canonical)
  : SITE + Astro.url.pathname;

// hreflang 备选 URL：当前路径去掉语言前缀，得到「路径骨架」，再拼各语言
const currentPath = Astro.url.pathname;
const pathSkeleton = currentPath.replace(/^\/(es|ar)(?=\/|$)/, "");
const hreflangUrl = (l: string) => {
  const base = l === "en" ? "" : "/" + l;
  return SITE + base + pathSkeleton;
};

const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const articleJsonLd =
  ogType === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: cleanTitle,
        description,
        image: ogImage.startsWith("http") ? ogImage : SITE + ogImage,
        author: author
          ? { "@type": "Organization", name: author, url: SITE }
          : { "@type": "Organization", name: "Tenda Peppers", url: SITE },
        publisher: { "@id": SITE + "/#organization" },
        datePublished: datePublished,
        dateModified: dateModified || datePublished,
        mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
        inLanguage: locale.code,
      }
    : null;

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": SITE + "/#organization",
  "name": "Tenda Peppers",
  "legalName": "Leling Tenda Chili Products Co., Ltd.",
  "url": SITE,
  "email": "tdlajiao@126.com",
  "telephone": "+86-18162067392",
  "foundingDate": "2010",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Yang'an Town Outer Ring Road",
    "addressLocality": "Leling",
    "addressRegion": "Shandong",
    "addressCountry": "CN"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "sales",
    "email": "tdlajiao@126.com",
    "telephone": "+86-18162067392",
    "areaServed": ["Europe", "Middle East", "North America"],
    "availableLanguage": ["English", "Spanish", "Arabic", "Chinese"]
  },
  "hasCredential": [
    { "@type": "EducationalOccupationalCredential", "name": "ISO 9001" },
    { "@type": "EducationalOccupationalCredential", "name": "HACCP" }
  ],
  "knowsAbout": [
    "Paprika powder",
    "Sweet paprika",
    "Dried chillies",
    "Chilli flakes",
    "Chilli powder",
    "Whole dried chillies",
    "Chilli segments",
    "ASTA colour value",
    "Scoville Heat Units (SHU)"
  ]
};

const webSiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": SITE + "/#website",
  "url": SITE,
  "name": BRAND_FULL,
  "inLanguage": [locale.code, "en", "es", "ar"],
  "publisher": { "@id": SITE + "/#organization" }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": SITE + (lang === "en" ? "/" : "/" + lang + "/")
    },
    ...(canonicalUrl !== SITE + "/"
      ? [
          {
            "@type": "ListItem",
            "position": 2,
            "name": cleanTitle,
            "item": canonicalUrl
          }
        ]
      : [])
  ]
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex" : "max-image-preview:large"} />
    {author && <meta name="author" content={author} />}

    <link rel="alternate" hreflang="en" href={hreflangUrl("en")} />
    <link rel="alternate" hreflang="es" href={hreflangUrl("es")} />
    <link rel="alternate" hreflang="ar" href={hreflangUrl("ar")} />
    <link rel="alternate" hreflang="x-default" href={hreflangUrl("en")} />

    <meta property="og:site_name" content={BRAND_FULL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage.startsWith("http") ? ogImage : SITE + ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale.og} />
    {lang === "es" && <meta property="og:locale:alternate" content="en_US" />}
    {lang === "es" && <meta property="og:locale:alternate" content="ar_AE" />}
    {lang === "en" && <meta property="og:locale:alternate" content="es_ES" />}
    {lang === "en" && <meta property="og:locale:alternate" content="ar_AE" />}
    {lang === "ar" && <meta property="og:locale:alternate" content="en_US" />}
    {lang === "ar" && <meta property="og:locale:alternate" content="es_ES" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith("http") ? ogImage : SITE + ogImage} />

    {datePublished && <meta property="article:published_time" content={datePublished} />}
    {dateModified && <meta property="article:modified_time" content={dateModified} />}

    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />

    {jsonLdArray.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    {articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
