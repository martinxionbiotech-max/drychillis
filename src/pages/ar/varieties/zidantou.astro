  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هو فلفل زيدانتو؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "زيدانتو، الفلفل الرصاصي، فلفل مخروطي عالي الحرارة من شاندونغ وآنهوي عند 20,000–50,000 SHU. هو معيار للصلصة الحارة والأغذية الصناعية، وغالبًا يُعالج إلى مسحوق."
      }
    },
    {
      "@type": "Question",
      "name": "ما مدى حرارة فلفل زيدانتو؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يقع زيدانتو في نطاق الحرارة العالية، 20,000–50,000 SHU — نفس نطاق عمل سانينغ، مناسب للصلصات الحارة والتوابل الصناعية لا لمنتجات الحرارة الفائقة."
      }
    },
    {
      "@type": "Question",
      "name": "فيمَ يُستخدم فلفل زيدانتو؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُستخدم زيدانتو للصلصة الحارة والأغذية الصناعية ومسحوق الفلفل. شكله المخروطي وحرارته الثابتة يجعلانه قاعدة عالية الحرارة موثوقة للخلطات والمعالجة."
      }
    }
  ]
