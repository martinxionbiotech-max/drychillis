---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما حجم الميش القياسي لمسحوق الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "60–80 ميش هو القياسي لمسحوق الفلفل الحار والفلفل الحلو — ناعم بما يكفي لتوزيع متساوٍ للون والحرارة. الخشن (20–40 ميش) للرقائق؛ والناعم جدًا (100+ ميش) للصلصات الناعمة."
      }
    },
    {
      "@type": "Question",
      "name": "كيف يؤثر حجم الميش على المنتج؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يحدد الميش حجم الجسيمات، الذي يتحكم في توزيع الحرارة واللون وملمس الفم وتعليق المسحوق في الصلصة. المسحوق الأنعم يتوزع أسرع ويتكتل أقل؛ والخشن يعطي قوامًا مرئيًا."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكنكم الطحن بميش مخصص؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم. الميش قابل للتعديل حسب متطلباتك — سمِّ الميش (أو حجم الجسيمات المستهدف) ونطابقه، موثقًا في العرض مع مواصفة الرطوبة وSHU."
      }
    }
  ]
};
---

<BaseLayout
  title="دليل حجم الميش لمسحوق الفلفل الحار | Tenda Peppers"
  description="حجم الميش لمسحوق الفلفل الحار موضحًا — 60–80 ميش قياسي، أخشن للرقائق، أنعم للصلصات الناعمة. طحن مخصص. مُصنّع في الصين، ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; حجم الميش
    </nav>
    <h1>دليل حجم الميش لمسحوق الفلفل الحار</h1>
    <p class="lead">
      يحدد الميش حجم جسيمات مسحوق الفلفل الحار والفلفل الحلو — كيف يتوزع اللون والحرارة وملمس الفم
      والأداء في الصلصة أو الخلطة.
    </p>

    <h2 style="margin-top:32px;">ما حجم الميش القياسي؟</h2>
    <p>
      لمسحوق الفلفل الحار والفلفل الحلو، 60–80 ميش هو الافتراضي: ناعم للون والحرارة المنتظمين في
      الخلطات. يعتمد الميش الصحيح على التطبيق:
    </p>
    <table>
      <thead>
        <tr><th>الميش</th><th>طابع الجسيمات</th><th>الأنسب لـ</th></tr>
      </thead>
      <tbody>
        <tr><td>20–40 ميش</td><td>خشن، مرئي</td><td>فلفل مطحون، رقائق</td></tr>
        <tr><td>60–80 ميش</td><td>ناعم، قياسي</td><td>خلطات التوابل، مسحوق عام</td></tr>
        <tr><td>100+ ميش</td><td>ناعم جدًا</td><td>صلصات ناعمة، خلط فوري</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">كيف يؤثر الميش على المنتج</h2>
    <ul>
      <li><strong>التوزيع</strong> — المسحوق الأنعم يتوزع أسرع وأكثر انتظامًا</li>
      <li><strong>ملمس الفم</strong> — الخشن يعطي قوامًا، والناعم سلس</li>
      <li><strong>التكتل</strong> — الأنعم يتكتل أقل ويعلق أفضل في السائل</li>
      <li><strong>إطلاق اللون</strong> — الأنعم يطلق اللون (ASTA) بسهولة أكبر</li>
    </ul>

    <h2 style="margin-top:32px;">كيف تحدد الميش</h2>
    <p>
      سمِّ الميش (أو حجم الجسيمات المستهدف) إلى جانب نطاق SHU والرطوبة والشكل. الميش قابل للتعديل
      وموثق في العرض — للمسحوق، 60–80 ميش هو الافتراضي المعقول ما لم يتطلب تطبيقك غير ذلك.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما حجم الميش القياسي لمسحوق الفلفل الحار؟</h3>
      <p>60–80 ميش هو القياسي لمسحوق الفلفل الحار والفلفل الحلو — ناعم بما يكفي لتوزيع متساوٍ للون والحرارة. الخشن (20–40 ميش) للرقائق؛ والناعم جدًا (100+ ميش) للصلصات الناعمة.</p>
    </div>
    <div class="faq-item">
      <h3>كيف يؤثر حجم الميش على المنتج؟</h3>
      <p>يحدد الميش حجم الجسيمات، الذي يتحكم في توزيع الحرارة واللون وملمس الفم وتعليق المسحوق في الصلصة. المسحوق الأنعم يتوزع أسرع ويتكتل أقل؛ والخشن يعطي قوامًا مرئيًا.</p>
    </div>
    <div class="faq-item">
      <h3>هل يمكنكم الطحن بميش مخصص؟</h3>
      <p>نعم. الميش قابل للتعديل حسب متطلباتك — سمِّ الميش (أو حجم الجسيمات المستهدف) ونطابقه، موثقًا في العرض مع مواصفة الرطوبة وSHU.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب مواصفة</a>
      <a class="cta cta-outline" href="/ar/products/dried-chillies/" style="margin-left:8px;">الفلفل المجفف ←</a>
    </div>
  </div>
</BaseLayout>
