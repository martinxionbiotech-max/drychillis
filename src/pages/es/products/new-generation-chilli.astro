---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BuyerSpec from "../../../components/BuyerSpec.astro";
import AtAGlance from "../../../components/AtAGlance.astro";

const buyerSpec = [
  { param: "Forma del producto", value: "Confirmar especificación" },
  { param: "Variedad", value: "Chile New Generation" },
  { param: "Nivel de picor (SHU)", value: "20,000–50,000" },
  { param: "Valor de color ASTA", value: "Confirmar especificación" },
  { param: "Tamaño de malla", value: "Confirmar especificación" },
  { param: "Humedad", value: "<13%" },
  { param: "Procesamiento", value: "Confirmar especificación" },
  { param: "Certificaciones", value: "ISO 9001 y HACCP de serie — BRC, Halal y Kosher a pedido" },
];

const glanceFacts = [
  { label: "Nivel de picor", value: "20,000–50,000 SHU" },
  { label: "Región", value: "Shandong" },
  { label: "Ideal para", value: "Mezclas de condimentos, chile en polvo" },
  { label: "Certificaciones", value: "ISO 9001 y HACCP" },
];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "https://drychillis.com/products/new-generation-chilli/#product",
  "name": "Chile New Generation",
  "description": "Pimiento New Generation — chile de alto picor a 20.000–50.000 SHU de Shandong, para mezclas de condimentos y chile en polvo. Fabricante chino, ISO 9001 y HACCP.",
  "image": ["https://drychillis.com/images/products/chilli-whole.jpg"],
  "url": "https://drychillis.com/products/new-generation-chilli/",
  "sku": "TENDA-NEW-GENERATION-CHILLI",
  "category": "Especias y Condimentos",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Nivel de Picor (SHU)", "value": "20,000–50,000", "unitText": "SHU" },
    { "@type": "PropertyValue", "name": "Región", "value": "Shandong" },
    { "@type": "PropertyValue", "name": "Ideal Para", "value": "Mezclas de condimentos, chile en polvo" }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué es el chile New Generation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "New Generation es un chile de alto picor a 20.000–50.000 SHU de Shandong, usado sobre todo para mezclas de condimentos y chile en polvo. Está en la misma banda que Sanying, Zidantou y Seven-Star."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué tan picante es el pimiento New Generation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "New Generation es de picor alto a 20.000–50.000 SHU — fuerte y persistente, por encima de variedades medias como Xian y Jinta, y por debajo de la banda extra-picante de más de 50.000 SHU. Especifique una ventana SHU precisa, no un número único."
      }
    },
    {
      "@type": "Question",
      "name": "¿Para qué se usa el pimiento New Generation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "New Generation se compra para mezclas de condimentos, chile en polvo y copos. Picor, color y sabor varían de forma independiente, así que nombre la variedad y la ventana SHU para mantener la mezcla consistente."
      }
    }
  ]
};
---

<BaseLayout
  title="Chile New Generation — 20.000–50.000 SHU | Tenda Peppers"
  description="Pimiento New Generation — chile de alto picor a 20.000–50.000 SHU de Shandong, para mezclas de condimentos y chile en polvo. Fabricante chino, ISO 9001 y HACCP."
  lang="es"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/es/">Inicio</a> &rsaquo; <a href="/es/products/dried-chillies/">Chiles Secos</a> &rsaquo; New Generation
    </nav>
    <h1>Chile New Generation</h1>
    <p class="lead">
      Un chile de alto picor a 20.000–50.000 SHU de Shandong, comprado para mezclas de condimentos y chile en polvo.
    </p>
    <div class="takeaways">
      <strong>Respuesta breve:</strong> New Generation es un chile de alto picor (20.000–50.000 SHU) de Shandong, usado para mezclas de condimentos y chile en polvo. Comparte la banda de picor alto con Sanying, Zidantou y Seven-Star — con protagonismo del picor, pero no en el extremo de la escalera.
    </div>
    <AtAGlance facts={glanceFacts} lang="es" />
    <div class="product-media">
      <img src="/images/products/chilli-whole.jpg" alt="Chiles secos enteros" width="1400" height="1050" loading="eager" />
    </div>
    <p class="product-price" style="font-weight:600;color:#8a1c1c;margin:10px 0 0;">Precio confirmado en la cotización — MOQ, envasado y especificación acordados antes del pedido.</p>

    <h2 style="margin-top:32px;">¿Qué es el chile New Generation?</h2>
    <p>
      New Generation es un chile de alto picor a 20.000–50.000 SHU de Shandong. Aparece en la página de <a href="/es/heat-levels/high-heat/">picor alto</a> junto a Sanying, Zidantou y Seven-Star, y se compra principalmente para mezclas de condimentos y polvo — productos donde el picor es un rasgo definitorio pero no el único.
    </p>
    <table>
      <thead>
        <tr><th>Propiedad</th><th>Detalle</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>Picor (SHU)</strong></td><td>20,000–50,000</td></tr>
        <tr><td><strong>Región</strong></td><td>Shandong</td></tr>
        <tr><td><strong>Ideal para</strong></td><td>Mezclas de condimentos, chile en polvo</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">¿Para qué se usa el pimiento New Generation?</h2>
    <ul>
      <li>Mezclas de condimentos</li>
      <li>Chile en polvo</li>
      <li>Copos de chile</li>
    </ul>

    <h2 style="margin-top:32px;">New Generation vs Sanying vs Zidantou</h2>
    <p>
      Sanying (Tianying) y Zidantou son las variedades clásicas de salsa picante a 20.000–50.000 SHU; New Generation se compra más para mezclas de condimentos y polvo. Todas están en la misma banda, así que picor, color y sabor varían de forma independiente — nombre la variedad y una ventana SHU precisa en su especificación.
    </p>

    <h2 style="margin-top:32px;">New Generation en números</h2>
    <p>
      New Generation ronda los 20.000–50.000 SHU — la banda con protagonismo del picor más amplia de nuestra escalera, por encima de variedades medias como Xian y Jinta (10.000–20.000) y por debajo de la banda extra-picante de más de 50.000 SHU.
    </p>
    <p class="data-note">
      Los valores de picor son representativos por variedad. Confirme su ventana SHU, forma y malla
      exactas al consultar.
    </p>

    <BuyerSpec rows={buyerSpec} lang="es" confirmText="Confirmar especificación" />

    <h2 style="margin-top:32px;">En la misma banda de 20.000–50.000 SHU</h2>
    <p>
      Otras variedades de esta banda: <a href="/es/products/sanying-chilli/">Sanying</a>, <a href="/es/products/seven-star-chilli/">Seven-Star</a>.
    </p>

    <h2 style="margin-top:32px;">Preguntas Frecuentes</h2>
    <div class="faq-item">
      <h3>¿Qué es el chile New Generation?</h3>
      <p>New Generation es un chile de alto picor a 20.000–50.000 SHU de Shandong, usado sobre todo para mezclas de condimentos y chile en polvo. Está en la misma banda que Sanying, Zidantou y Seven-Star.</p>
    </div>
    <div class="faq-item">
      <h3>¿Qué tan picante es el pimiento New Generation?</h3>
      <p>New Generation es de picor alto a 20.000–50.000 SHU — fuerte y persistente, por encima de variedades medias como Xian y Jinta, y por debajo de la banda extra-picante de más de 50.000 SHU. Especifique una ventana SHU precisa, no un número único.</p>
    </div>
    <div class="faq-item">
      <h3>¿Para qué se usa el pimiento New Generation?</h3>
      <p>New Generation se compra para mezclas de condimentos, chile en polvo y copos. Picor, color y sabor varían de forma independiente, así que nombre la variedad y la ventana SHU para mantener la mezcla consistente.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/es/contact/">Solicitar Cotización New Generation</a>
      <a class="cta cta-outline" href="/es/products/dried-chillies/" style="margin-left:8px;">Chiles Secos →</a>
    </div>
  </div>
</BaseLayout>
