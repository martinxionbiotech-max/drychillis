  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هو مسحوق الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "مسحوق الفلفل الحار هو فلفل مجفف مطحون إلى 60–80 ميش ناعم. يعطي حرارة موحدة قابلة للخلط — عادة 20,000–50,000 SHU — للصلصات الحارة والتوابل والأغذية الصناعية. الحرارة واللون والنكهة تتفاوت بشكل مستقل، لذا تسمي المواصفة الصنف ونطاق SHU، لا 'مسحوق فلفل حار' عام."
      }
    },
    {
      "@type": "Question",
      "name": "ما حجم الميش لمسحوق الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "مسحوق الفلفل الحار القياسي 60–80 ميش — ناعم بما يكفي لتوزيع متساوٍ وقوام سلس. الخشن (20–40) للرقائق؛ الأنعم (100+) للصلصات الناعمة. الميش قابل للتعديل حسب طلبك."
      }
    },
    {
      "@type": "Question",
      "name": "أي صنف أستخدم لمسحوق الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "سانينغ (تيانيينغ) وزيدانتو وسبعة نجوم (20,000–50,000 SHU) هي الأصناف المعتادة للصلصة الحارة والتوابل. للحرارة الفائقة، يتجاوز جيشين وشياومي 50,000 SHU. سمِّ الصنف ونطاق SHU دقيقًا لثبات الدفعات."
      }
    }
  ]
};
---

<BaseLayout
  title="مسحوق الفلفل الحار (60–80 ميش) | Tenda Peppers"
  description="مصنع صيني لمسحوق الفلفل الحار — 60–80 ميش، 20,000–50,000 SHU، من سانينغ وزيدانتو وسبعة نجوم للصلصة الحارة والتوابل والأغذية الصناعية. ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; مسحوق الفلفل الحار
    </nav>
    <h1>مسحوق الفلفل الحار (60–80 ميش)</h1>
    <p class="lead">
      فلفل مجفف مطحون ناعم — 60–80 ميش، 20,000–50,000 SHU — أساس الصلصات الحارة والتوابل والأغذية
      الصناعية، مطحون من سانينغ وزيدانتو وسبعة نجوم.
    </p>

    <h2 style="margin-top:32px;">ما هو مسحوق الفلفل الحار؟</h2>
    <p>
      مسحوق الفلفل الحار هو فلفل مجفف مطحون إلى 60–80 ميش ناعم لحرارة موحدة قابلة للخلط. بخلاف
      الرقائق أو الفلفل الكامل، يتوزع بالتساوي في الصلصة أو التوابل، لذا فهو الشكل الافتراضي
      للصلصات الحارة والوجبات الخفيفة والأغذية الصناعية. انظر دليل
      <a href="/ar/blog/how-to-specify-chilli-powder/">كيف تحدد مسحوق الفلفل الحار</a>.
    </p>
    <table>
      <thead>
        <tr><th>الصنف</th><th>الحرارة (SHU)</th><th>المنطقة</th><th>الأفضل لـ</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>سانينغ / تيانيينغ</strong></td><td>20,000 – 50,000</td><td>خنان، خبي</td><td>الصلصة الحارة، زيت الفلفل</td></tr>
        <tr><td><strong>زيدانتو (رصاصي)</strong></td><td>20,000 – 50,000</td><td>شاندونغ، آنهوي</td><td>الصلصة الحارة، الصناعة</td></tr>
        <tr><td><strong>سبعة نجوم</strong></td><td>20,000 – 50,000</td><td>شاندونغ، شانشي</td><td>نكهة الوجبات الخفيفة، الهوت بوت</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">فيمَ يُستخدم مسحوق الفلفل الحار؟</h2>
    <ul>
      <li>الصلصات الحارة وزيت الفلفل</li>
      <li>نكهات الوجبات الخفيفة والنودلز الفوري</li>
      <li>خلطات التوابل والبهارات</li>
      <li>الأغذية الصناعية والتوابل المصنعة</li>
    </ul>

    <h2 style="margin-top:32px;">كيف تحدد مسحوق الفلفل الحار</h2>
    <p>
      سمِّ خمسة أشياء: الصنف (أو نطاق SHU)، والحرارة بـ SHU، والميش، والرطوبة، واللون (ASTA) إن
      لزم. للصلصة الحارة، سانينغ وزيدانتو هما الثنائي الكلاسيكي؛ وسبعة نجوم يناسب الوجبات الخفيفة.
      الحرارة غير خطية، لذا النطاق الدقيق — لا «حار» أو «متوسط» — هو ما يحافظ على ثبات المنتج من
      دفعة لأخرى.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكد نطاق SHU والميش والرطوبة الدقيق عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما هو مسحوق الفلفل الحار؟</h3>
      <p>مسحوق الفلفل الحار هو فلفل مجفف مطحون إلى 60–80 ميش ناعم. يعطي حرارة موحدة قابلة للخلط — عادة 20,000–50,000 SHU — للصلصات الحارة والتوابل والأغذية الصناعية. الحرارة واللون والنكهة تتفاوت بشكل مستقل، لذا تسمي المواصفة الصنف ونطاق SHU، لا 'مسحوق فلفل حار' عام.</p>
    </div>
    <div class="faq-item">
      <h3>ما حجم الميش لمسحوق الفلفل الحار؟</h3>
      <p>مسحوق الفلفل الحار القياسي 60–80 ميش — ناعم بما يكفي لتوزيع متساوٍ وقوام سلس. الخشن (20–40) للرقائق؛ الأنعم (100+) للصلصات الناعمة. الميش قابل للتعديل حسب طلبك.</p>
    </div>
    <div class="faq-item">
      <h3>أي صنف أستخدم لمسحوق الفلفل الحار؟</h3>
      <p>سانينغ (تيانيينغ) وزيدانتو وسبعة نجوم (20,000–50,000 SHU) هي الأصناف المعتادة للصلصة الحارة والتوابل. للحرارة الفائقة، يتجاوز جيشين وشياومي 50,000 SHU. سمِّ الصنف ونطاق SHU دقيقًا لثبات الدفعات.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر للمسحوق</a>
      <a class="cta cta-outline" href="/ar/products/dried-chillies/chilli-segments/" style="margin-left:8px;">شرائح الفلفل الحار ←</a>
    </div>
  </div>
</BaseLayout>
