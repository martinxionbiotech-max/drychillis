---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const qualityJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "الجودة والشهادات",
  "url": "https://drychillis.com/ar/quality/",
  "mainEntity": { "@id": "https://drychillis.com/#organization" }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما الشهادات التي تحملها Tenda Peppers؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تحمل Tenda Peppers شهادتي ISO 9001:2015 (إدارة الجودة) وHACCP (سلامة الأغذية). يتم الإنتاج تحت سياسة سلامة أغذية بصفر عيوب وصفر تسامح مع مراقبة على مدار الساعة."
      }
    },
    {
      "@type": "Question",
      "name": "كيف تزيلون الأجسام الغريبة من الفلفل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تمر كل دفعة بنزع البذور والترشيح المغناطيسي (المعادن الحديدية) والفحص بالأشعة السينية (الأجسام الكثيفة) والفرز بالألوان (الفرز البصري للعيوب). يُنفذ هذا الفحص متعدد المراحل جنبًا إلى جنب مع التحكم في الرطوبة."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكنني الحصول على الشهادات وتوثيق الدفعات؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم. الشهادات وتوثيق الدفعات متاحة عند الطلب، وكل شحنة قابلة للتتبع حتى قاعدة زراعتها تحت نظام ISO 9001 / HACCP."
      }
    },
    {
      "@type": "Question",
      "name": "كيف يُضمن الثبات بين الدفعات؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يأتي الثبات من التحكم في الصنف والدرجة عند المصدر، وقابلية تتبع المواد الخام من 12 قاعدة زراعة خاضعة للرقابة، وإعادة التحقق في المختبر قبل الإنتاج — لتبقى الحرارة واللون والنكهة مستقرة بين الدفعات."
      }
    }
  ]
};
---

<BaseLayout
  lang="ar"
  title="الجودة والشهادات | Tenda Peppers"
  description="مراقبة جودة Tenda Peppers — معتمدة ISO 9001 وHACCP، مع فحص بالأشعة السينية وفرز بالألوان وكشف المعادن وعملية إنتاج من 8 خطوات للفلفل الحلو والفلفل الحار المجفف."
  jsonLd={[qualityJsonLd, faqJsonLd]}
>
  <div class="container section">
    <h1>الجودة والشهادات</h1>
    <p class="lead">
      تُضبط جودة الفلفل الحلو والفلفل الحار عند المصدر وتُتحقق في كل خطوة — تحت نظام ISO 9001
      وHACCP مع سياسة سلامة أغذية بصفر عيوب وصفر تسامح.
    </p>

        <div class="product-gallery">
      <figure><img src="/images/quality-inspection.jpg" alt="X-ray inspection and colour sorting line" loading="lazy" /><figcaption>X-ray &amp; colour sorting</figcaption></figure>
      <figure><img src="/images/factory-line.jpg" alt="Tenda Peppers production line" loading="lazy" /><figcaption>Production line</figcaption></figure>
    </div>

<h2 style="margin-top:32px;">الشهادات</h2>
    <table>
      <thead>
        <tr><th>الشهادة</th><th>النطاق</th><th>الحالة</th></tr>
      </thead>
      <tbody>
        <tr><td>ISO 9001:2015</td><td>نظام إدارة الجودة</td><td>✅ معتمد</td></tr>
        <tr><td>HACCP</td><td>إدارة سلامة الأغذية</td><td>✅ معتمد</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      الشهادات متاحة عند الطلب. الاختبارات من طرف ثالث متاحة عند طلب المشتري.
    </p>

    <h2 style="margin-top:32px;">عملية الإنتاج من 8 خطوات</h2>
    <table>
      <thead>
        <tr><th>الخطوة</th><th>المرحلة</th><th>التحكم</th></tr>
      </thead>
      <tbody>
        <tr><td>1</td><td>توريد المواد الخام</td><td>تدقيق الموردين المعتمدين، إعادة التحقق في المختبر</td></tr>
        <tr><td>2</td><td>المعالجة الأولية</td><td>نزع البذور، التنظيف</td></tr>
        <tr><td>3</td><td>التصنيف</td><td>التصنيف حسب الحجم واللون والرطوبة</td></tr>
        <tr><td>4</td><td>التخزين</td><td>مستودع منخفض الحرارة</td></tr>
        <tr><td>5</td><td>المعالجة</td><td>الترشيح المغناطيسي، كشف المعادن</td></tr>
        <tr><td>6</td><td>الفرز بالألوان والأشعة السينية</td><td>إزالة الأجسام الغريبة، الفرز بالألوان</td></tr>
        <tr><td>7</td><td>التغليف</td><td>مغلق، موسوم بالمواصفات</td></tr>
        <tr><td>8</td><td>المنتج النهائي</td><td>الفحص النهائي قبل الإفراج</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">التحكم في الأجسام الغريبة</h2>
    <ul>
      <li><strong>الترشيح المغناطيسي</strong> — يزيل شظايا المعادن الحديدية</li>
      <li><strong>الفحص بالأشعة السينية</strong> — يكشف الأجسام الكثيفة التي لا يكتشفها الترشيح المغناطيسي</li>
      <li><strong>الفرز بالألوان</strong> — يزيل الفرز البصري القطع الباهتة والمعيبة</li>
      <li><strong>نزع البذور</strong> — يزيل البذور والمواد النباتية الملتصقة</li>
    </ul>

    <h2 style="margin-top:32px;">سلسلة التحكم في سلامة الأغذية</h2>
    <p>
      سلامة الأغذية هنا ليست نقطة تفتيش واحدة بل سلسلة من أربع بوابات يجب أن تصمد جميعها قبل
      شحن أي دفعة:
    </p>
    <ul>
      <li><strong>سلامة المواد الخام</strong> — موردون معتمدون، إعادة التحقق في المختبر قبل الإنتاج</li>
      <li><strong>سلامة الإنتاج والمعالجة</strong> — نزع البذور، الترشيح المغناطيسي، الفحص بالأشعة السينية، الفرز بالألوان</li>
      <li><strong>الاختبار والفحص قبل الإفراج</strong> — كل دفعة تُتحقق مقابل المواصفة</li>
      <li><strong>شهادة النظام</strong> — ISO 9001 وHACCP، بتدقيق خارجي</li>
    </ul>

    <h2 style="margin-top:32px;">نقاط مراقبة الجودة</h2>
    <ul>
      <li>مراقبة كاملة على مدار الساعة في المصنع والورشة</li>
      <li>إجراءات تشغيل مراجعة في كل موقع، مطبقة بدقة</li>
      <li>مفتشو جودة متخصصون في كل مرحلة</li>
      <li>معدات صناعية متقدمة وتدفق عمليات متطور</li>
      <li>التحكم في الرطوبة وفحص الأجسام الغريبة طوال العملية</li>
    </ul>

    <h2 style="margin-top:32px;">ملاحظات ثبات اللون</h2>
    <p>
      نوثق كيف يتصرف اللون مع مرور الوقت لمشترينا: يبهت مسحوق الفلفل الحار تدريجيًا في درجة
      حرارة الغرفة (أسرع بعد التعقيم الحراري العالي)، بينما قد يغمق مسحوق الفلفل الحلو بعد
      التعقيم. هذه كيمياء لون طبيعية — ونقدم المشورة بشأن التخزين للحفاظ على اللون في تطبيقك.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما الشهادات التي تحملها Tenda Peppers؟</h3>
      <p>تحمل Tenda Peppers شهادتي ISO 9001:2015 (إدارة الجودة) وHACCP (سلامة الأغذية). يتم الإنتاج تحت سياسة سلامة أغذية بصفر عيوب وصفر تسامح مع مراقبة على مدار الساعة.</p>
    </div>
    <div class="faq-item">
      <h3>كيف تزيلون الأجسام الغريبة من الفلفل؟</h3>
      <p>تمر كل دفعة بنزع البذور والترشيح المغناطيسي (المعادن الحديدية) والفحص بالأشعة السينية (الأجسام الكثيفة) والفرز بالألوان (الفرز البصري للعيوب).</p>
    </div>
    <div class="faq-item">
      <h3>هل يمكنني الحصول على الشهادات وتوثيق الدفعات؟</h3>
      <p>نعم. الشهادات وتوثيق الدفعات متاحة عند الطلب، وكل شحنة قابلة للتتبع حتى قاعدة زراعتها تحت نظام ISO 9001 / HACCP.</p>
    </div>
    <div class="faq-item">
      <h3>كيف يُضمن الثبات بين الدفعات؟</h3>
      <p>يأتي الثبات من التحكم في الصنف والدرجة عند المصدر، وقابلية تتبع المواد الخام، وإعادة التحقق في المختبر قبل الإنتاج — لتبقى الحرارة واللون والنكهة مستقرة بين الدفعات.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">طلب الشهادات</a>
    </div>
  </div>
</BaseLayout>
