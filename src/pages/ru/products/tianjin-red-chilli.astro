---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildOffers, priceLine } from "../../../data/product-offers";

const productUrl = "https://drychillis.com/ru/products/tianjin-red-chilli/";
const productOffers = buildOffers("tianjin-red-chilli", productUrl);

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "https://drychillis.com/ru/products/tianjin-red-chilli/#product",
  "name": "Перец Тяньцзинь Ред (朝天椒)",
  "description": "Кластерный перец «смотрящий в небо» (朝天椒), 30 000–50 000 SHU — целый и молотый перец высокой остроты для экспорта, отгружается через Тяньцзинь.",
  "image": ["https://drychillis.com/images/products/chilli-whole.jpg"],
  "url": "https://drychillis.com/ru/products/tianjin-red-chilli/",
  "sku": "TENDA-TIANJIN-RED-CHILLI",
  "category": "Специи и приправы",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  ...(productOffers ? { "offers": productOffers } : {}),
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Острота (SHU)", "value": "30 000 – 50 000" },
    { "@type": "PropertyValue", "name": "Тип плода", "value": "Мелкий кластерный стручок, направленный вверх" },
    { "@type": "PropertyValue", "name": "Регион", "value": "Северный Китай; торговля через Тяньцзинь" },
    { "@type": "PropertyValue", "name": "Лучше всего для", "value": "Целый перец, порошок, хлопья, сегменты" }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Что такое перец Тяньцзинь Ред / 朝天椒?",
      "acceptedAnswer": { "@type": "Answer", "text": "Тяньцзинь Ред — экспортное название кластерного перца «смотрящий в небо» (朝天椒), отгружаемого через Тяньцзинь: мелкие стручки, направленные вверх, примерно 30 000–50 000 SHU — самый распространённый целый и молотый перец высокой остроты для экспорта." } },
    { "@type": "Question", "name": "Насколько он остр?",
      "acceptedAnswer": { "@type": "Answer", "text": "Примерно 30 000–50 000 SHU — выше среднего диапазона и чуть ниже очень острых Цзисинь и Сяоми (50 000–70 000). Поскольку «смотрящий в небо» — это форма, точная острота зависит от происхождения." } },
    { "@type": "Question", "name": "Это сорт или форма?",
      "acceptedAnswer": { "@type": "Answer", "text": "Форма. «Смотрящий в небо» (朝天椒) описывает кластерные стручки, направленные вверх, а не один сорт. Острота варьирует от 30 000 до 50 000+ SHU в зависимости от происхождения, поэтому заказ без происхождения и диапазона SHU неполон." } }
  ]
};
---

<BaseLayout
  title="Перец Тяньцзинь Ред (朝天椒) — 30 000–50 000 SHU | Tenda Peppers"
  description="Тяньцзинь Ред / 朝天椒 — кластерный перец 30 000–50 000 SHU для целого и молотого перца на экспорт. Китайский производитель, ISO 9001 и HACCP."
  lang="ru"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ru/">Главная</a> &rsaquo; <a href="/ru/products/dried-chillies/">Сушёный перец</a> &rsaquo; Тяньцзинь Ред
    </nav>
    <h1>Перец Тяньцзинь Ред (朝天椒)</h1>
    <p class="lead">
      Кластерный перец «смотрящий в небо» (朝天椒) примерно 30 000–50 000 SHU — самый распространённый
      целый и молотый перец высокой остроты для экспорта, отгружается через торговый центр Тяньцзиня.
    </p>
    <p class="product-price" style="font-weight:600;color:#8a1c1c;margin:10px 0 0;">{priceLine("tianjin-red-chilli", "ru")}</p>

    <h2 style="margin-top:32px;">Что такое перец Тяньцзинь Ред?</h2>
    <p>
      Тяньцзинь Ред — название, которое экспортёры используют для перца «смотрящий в небо» (朝天椒),
      торгуемого через Тяньцзинь, один из крупнейших портов сбора и экспорта перца в Китае. Стручки
      мелкие, кластерные и растут вверх — именно эта черта дала название группе. Острота — примерно
      30 000–50 000 SHU: выше среднего диапазона и чуть ниже Цзисинь и Сяоми.
    </p>
    <table>
      <thead><tr><th>Свойство</th><th>Подробности</th></tr></thead>
      <tbody>
        <tr><td><strong>Острота (SHU)</strong></td><td>30 000 – 50 000</td></tr>
        <tr><td><strong>Тип плода</strong></td><td>Мелкий кластерный стручок, направленный вверх</td></tr>
        <tr><td><strong>Регион</strong></td><td>Северный Китай; торговля через Тяньцзинь</td></tr>
        <tr><td><strong>Лучше всего для</strong></td><td>Целый перец, порошок, хлопья, сегменты</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      SHU — репрезентативный диапазон; поскольку «смотрящий в небо» — форма, а не сорт, точное
      значение зависит от происхождения. Подтвердите нужный диапазон с нами.
    </p>

    <h2 style="margin-top:32px;">Для чего используют Тяньцзинь Ред?</h2>
    <ul>
      <li>Целый сушёный перец для общепита и розницы</li>
      <li>Молотый перец и хлопья для приправ</li>
      <li>Сегменты перца для супов и рагу</li>
      <li>Основа острых соусов и масла чили</li>
    </ul>

    <h2 style="margin-top:32px;">«Смотрящий в небо» — это форма, а не уровень остроты</h2>
    <p>
      Именно это упускает большинство покупателей. «Смотрящий в небо» (朝天椒) описывает
      <strong>форму стручка</strong> — кластерные стручки, направленные вверх по мере созревания, — а
      не ботанический сорт с фиксированной остротой. В зависимости от происхождения диапазон идёт от
      примерно 30 000 до более чем 50 000 SHU. Поэтому заказ «перца смотрящего в небо» без
      происхождения и диапазона SHU недоспецифицирован.
    </p>

    <h2 style="margin-top:32px;">Тяньцзинь Ред, Санин и Цзыданьтоу</h2>
    <table>
      <thead><tr><th>Продукт</th><th>SHU</th><th>Что фиксирует</th></tr></thead>
      <tbody>
        <tr><td><strong>Тяньцзинь Ред / смотрящий в небо</strong></td><td>30 000 – 50 000</td><td>Форма + диапазон остроты (торговое обозначение)</td></tr>
        <tr><td><strong>Санин (Тяньин)</strong></td><td>20 000 – 50 000</td><td>Именованный сорт (Хэнань/Хэбэй)</td></tr>
        <tr><td><strong>Цзыданьтоу</strong></td><td>20 000 – 50 000</td><td>Именованный сорт, толстая мякоть для порошка</td></tr>
      </tbody>
    </table>
    <p>
      Берите именованный сорт (Санин или Цзыданьтоу), когда нужен воспроизводимый профиль от партии к
      партии. Берите «Тяньцзинь Ред / смотрящий в небо», когда нужна общая категория высокой остроты,
      которую вы затем уточняете происхождением и диапазоном SHU.
    </p>

    <h2 style="margin-top:32px;">Как задать спецификацию Тяньцзинь Ред</h2>
    <p>
      Укажите форму (целиком, порошок, хлопья или сегменты), целевой диапазон SHU, происхождение, если
      известно, меш (для порошка стандартно 60–80) и влажность (ниже 13%). Поскольку обозначение
      широкое, именно диапазон SHU фактически фиксирует продукт.
    </p>

    <h2 style="margin-top:32px;">Часто задаваемые вопросы</h2>
    <div class="faq-item">
      <h3>Что такое перец Тяньцзинь Ред / 朝天椒?</h3>
      <p>Экспортное название кластерного перца «смотрящий в небо», отгружаемого через Тяньцзинь: мелкие стручки вверх, примерно 30 000–50 000 SHU.</p>
    </div>
    <div class="faq-item">
      <h3>Насколько он остр?</h3>
      <p>Примерно 30 000–50 000 SHU — выше среднего диапазона и чуть ниже Цзисинь и Сяоми (50 000–70 000).</p>
    </div>
    <div class="faq-item">
      <h3>Это сорт или форма?</h3>
      <p>Форма: «смотрящий в небо» описывает кластерные стручки вверх, а не один сорт. Заказ без происхождения и диапазона SHU неполон.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ru/contact/">Запросить цену на Тяньцзинь Ред</a>
      <a class="cta cta-outline" href="/ru/products/dried-chillies/" style="margin-left:8px;">Сушёный перец →</a>
    </div>
  </div>
</BaseLayout>
