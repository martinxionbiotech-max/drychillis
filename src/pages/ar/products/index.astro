---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما المنتجات التي تصنّعها Tenda Peppers من الفلفل الحلو والفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "عائلتان من محصول واحد: مسحوق الفلفل الحلو المركّز على اللون (حلو وقليل الحرارة، ASTA 60–240) والفلفل المجفف المركّز على الحرارة (كامل، رقائق، مسحوق، وقطع، من 10,000 إلى 70,000+ SHU)."
      }
    },
    {
      "@type": "Question",
      "name": "ما الفرق بين الفلفل الحلو ومسحوق الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُصنع الفلفل الحلو من أصناف حلوة منخفضة الحرارة (أقل من 10,000 SHU) ويُحدَّد بلون ASTA. أما مسحوق الفلفل الحار فيُطحن من أصناف حارة (20,000–70,000+ SHU) ويُحدَّد بوحدات SHU. اللون والحرارة رقمان مستقلان."
      }
    },
    {
      "@type": "Question",
      "name": "ما أشكال الفلفل المجفف التي توفرونها؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "فلفل مجفف كامل، ورقائق (20–40 mesh)، ومسحوق (60–80 mesh)، وقطع. الشبكة والشكل مستقلان عن الحرارة؛ يمكن شحن نفس نطاق SHU كرقائق أو مسحوق أو قرن كامل."
      }
    },
    {
      "@type": "Question",
      "name": "ما نطاق الحرارة الذي يمكنكم توفيره؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "من أقل من 500 SHU (فلفل حلو) إلى أكثر من 70,000 SHU (جيشين وشياومي). تُزوَّد كل فئة بنطاق SHU دقيق بدل وصف عام مثل «حار» أو «خفيف»."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكنني طلب مواصفة مخصصة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم. حدد الشكل، ونطاق SHU، وقيمة ASTA، والشبكة، والرطوبة (أقل من 13% قياسيًا)، ونجهّز عرض سعر مع وثائق الدفعة وإمكانية التتبع إلى إحدى قواعد الزراعة المراقبة الاثنتي عشرة."
      }
    }
  ]
};
---

<BaseLayout
  title="منتجات الفلفل الحلو والفلفل المجفف | Tenda Peppers"
  description="مسحوق الفلفل الحلو والفلفل المجفف من مصنّع صيني: فلفل حلو، رقائق، مسحوق، كامل وقطع. SHU من أقل من 500 إلى 70,000+، وASTA 60–240."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; المنتجات
    </nav>
    <h1>منتجات الفلفل الحلو والفلفل المجفف</h1>
    <p class="lead">
      محصول واحد — الفلفل — مطحون إلى عائلتين من المنتجات: فلفل حلو مركّز على اللون وفلفل مجفف
      مركّز على الحرارة. كل شكل يُحدَّد برقم وليس بكلمة: ASTA للون، وSHU للحرارة، وmesh للقوام.
    </p>

    <div class="takeaways">
      <strong>إجابة مختصرة:</strong> تصنّع Tenda Peppers عائلتين من محصول واحد. يُحدَّد مسحوق
      الفلفل الحلو بلون ASTA (60–240) مع حرارة منخفضة (أقل من 10,000 SHU). ويُحدَّد الفلفل المجفف
      بوحدات SHU (10,000–70,000+) بأربعة أشكال: كامل، ورقائق، ومسحوق، وقطع. الحرارة والقوام
      مستقلان.
    </div>

    <h2 style="margin-top:32px;">عائلتان من المنتجات</h2>
    <div class="grid grid-2">
      <div class="card">
        <h3>مسحوق الفلفل الحلو</h3>
        <p>
          فلفل حلو وحلو منخفض الحرارة مصنوع من أصناف شينجيانغ الحلوة وYidu red. لون طبيعي
          للنقانق وخلطات التوابل والتتبيلات. يُحدَّد بوحدات ASTA 60–240.
        </p>
        <a href="/ar/products/paprika-powder/">عرض مسحوق الفلفل الحلو ←</a>
      </div>
      <div class="card">
        <h3>الفلفل المجفف</h3>
        <p>
          فلفل كامل ورقائق ومسحوق وقطع من 10,000 إلى 70,000+ SHU — للصلصات والوجبات الخفيفة
          والتوابل وخدمات الطعام. يُحدَّد بنطاق SHU والشبكة.
        </p>
        <a href="/ar/products/dried-chillies/">عرض الفلفل المجفف ←</a>
      </div>
    </div>

    <h2 style="margin-top:32px;">أشكال المنتجات</h2>
    <p>تصفّح حسب الشكل والوظيفة المطلوبة:</p>
    <ul>
      <li><a href="/ar/products/paprika-powder/">مسحوق الفلفل الحلو</a> — لون طبيعي وحرارة منخفضة.</li>
      <li><a href="/ar/products/dried-chillies/whole-dried-chillies/">فلفل مجفف كامل</a> — للتقديم وخدمات الطعام.</li>
      <li><a href="/ar/products/dried-chillies/chilli-flakes/">رقائق الفلفل</a> — قوام ظاهر، 20–40 mesh.</li>
      <li><a href="/ar/products/dried-chillies/chilli-powder/">مسحوق الفلفل</a> — توزيع الحرارة، 60–80 mesh.</li>
      <li><a href="/ar/products/dried-chillies/chilli-segments/">قطع الفلفل</a> — حرارة مضبوطة في اليخنات والحساء.</li>
    </ul>

    <h2 style="margin-top:32px;">مرجع الأصناف</h2>
    <p>
      الحرارة تعتمد على الصنف وهي غير خطية. يربط هذا الجدول الأصناف التي نطحنها بنطاقات SHU
      الفعلية وأفضل استخدام:
    </p>
    <table>
      <thead>
        <tr><th>الصنف</th><th>نطاق SHU</th><th>المنطقة</th><th>أفضل استخدام</th></tr>
      </thead>
      <tbody>
        <tr><td>شينجيانغ الحلو / ييدو الأحمر</td><td>&lt;500 – 10,000</td><td>شينجيانغ، شاندونغ</td><td>الفلفل الحلو، اللون</td></tr>
        <tr><td>جينتا</td><td>10,000 – 20,000</td><td>قانسو، شينجيانغ</td><td>رقائق ظاهرة، لون</td></tr>
        <tr><td>إرجينغتياو</td><td>15,000 – 30,000</td><td>سيتشوان</td><td>نكهة، معجون الفلفل، هوت بوت</td></tr>
        <tr><td>الفانوس (دينغلونغجياو)</td><td>10,000 – 20,000</td><td>شاندونغ، خبي</td><td>قرن كامل، طبق جاف</td></tr>
        <tr><td>سانينغ (تيانينغ)</td><td>20,000 – 50,000</td><td>خنان، خبي</td><td>صلصة حارة، زيت الفلفل</td></tr>
        <tr><td>زيدانتو (الرصاصة)</td><td>20,000 – 50,000</td><td>شاندونغ، آنهوي</td><td>مسحوق عالي الحرارة</td></tr>
        <tr><td>أحمر تيانجين / فلفل السماء</td><td>30,000 – 50,000</td><td>تيانجين (تصدير)</td><td>تصدير كامل ومسحوق</td></tr>
        <tr><td>جيشين (قلب الدجاجة)</td><td>50,000 – 70,000</td><td>قويتشو، خونان</td><td>حرارة قصوى، زيت الفلفل</td></tr>
        <tr><td>شياومي (الدخن)</td><td>50,000 – 70,000</td><td>يونان، قويتشو</td><td>قرن كامل، قطع</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">اللون مقابل الحرارة: رقمان مختلفان</h2>
    <p>
      أهم نقطة قبل الطلب: <strong>اللون والحرارة مستقلان</strong>. قد يكون المسحوق الأحمر الداكن
      فلفلًا حلوًا بقوة 500 SHU أو فلفلًا شديد الحرارة بقوة 70,000 SHU — فاللون لا يخبرك بشيء عن
      الحرارة. لهذا يُشترى الفلفل الحلو بوحدات ASTA ويُشترى الفلفل الحار بوحدات SHU.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما المنتجات التي تصنّعها Tenda Peppers من الفلفل الحلو والفلفل الحار؟</h3>
      <p>عائلتان من محصول واحد: مسحوق الفلفل الحلو المركّز على اللون والفلفل المجفف المركّز على الحرارة، بأشكال كامل ورقائق ومسحوق وقطع.</p>
    </div>
    <div class="faq-item">
      <h3>ما الفرق بين الفلفل الحلو ومسحوق الفلفل الحار؟</h3>
      <p>يُحدَّد الفلفل الحلو بلون ASTA مع حرارة منخفضة، ويُحدَّد مسحوق الفلفل الحار بوحدات SHU. يمكن أن يتشابه لوناهما تمامًا.</p>
    </div>
    <div class="faq-item">
      <h3>كيف أختار بين الفلفل الحلو والرقائق والمسحوق والكامل والقطع؟</h3>
      <p>اختر حسب الوظيفة: الفلفل الحلو للون، والرقائق للقوام الظاهر، والمسحوق لتوزيع الحرارة، والكامل للتقديم، والقطع لحرارة مضبوطة.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر</a>
    </div>
  </div>
</BaseLayout>
