---
import { t, type Lang } from "../i18n/ui";

interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;
const L = lang as Lang;
const year = new Date().getFullYear();
const base = lang === "en" ? "" : "/" + lang;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-col">
      <h2>{t(L, "footer.company")}</h2>
      <address>
        <p><strong>Tenda Peppers</strong> — Leling Tenda Chili Products Co., Ltd.</p>
        <p>Yang'an Town Outer Ring Road, Leling, Shandong, China</p>
        <p>Phone / WhatsApp: <a href="https://wa.me/8615153588090" target="_blank" rel="noopener">+86 15153588090</a></p>
        <p>Email: <a href="mailto:joanna@paprikabulk.com">joanna@paprikabulk.com</a></p>
      </address>
    </div>
    <div class="footer-col">
      <h2>{t(L, "footer.products")}</h2>
      <nav aria-label="Product links">
        <a href={base + "/products/paprika/"}>{t(L, "footer.productPaprika")}</a>
        <a href={base + "/products/dried-chillies/"}>{t(L, "footer.productChillies")}</a>
      </nav>
    </div>
    <div class="footer-col">
      <h2>{t(L, "footer.resources")}</h2>
      <nav aria-label="Resource links">
        <a href={base + "/quality/"}>{t(L, "nav.quality")}</a>
        <a href={base + "/about/"}>{t(L, "nav.about")}</a>
        <a href={base + "/contact/"}>{t(L, "nav.contact")}</a>
        <a href={base + "/heat-levels/medium-heat/"}>{t(L, "footer.heatLevels")}</a>
        <a href={base + "/blog/"}>{t(L, "footer.guides")}</a>
        <a href="https://docs.drychillis.com/" target="_blank" rel="noopener">📚 {t(L, "footer.knowledgeHub")}</a>
      </nav>
    </div>
    <div class="footer-col">
      <h2>{t(L, "footer.legal")}</h2>
      <nav aria-label="Legal links">
        <a href={base + "/privacy-policy/"}>{t(L, "footer.privacy")}</a>
        <a href={base + "/terms-and-conditions/"}>{t(L, "footer.terms")}</a>
      </nav>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {year} Tenda Peppers — Leling Tenda Chili Products Co., Ltd. {t(L, "footer.rights")}</p>
  </div>
</footer>
