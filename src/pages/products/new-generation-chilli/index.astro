---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BuyerSpec from "../../../components/BuyerSpec.astro";
import AtAGlance from "../../../components/AtAGlance.astro";
import { buildOffers, priceLine } from "../../../data/product-offers";

const productUrl = "https://drychillis.com/products/new-generation-chilli/";
const productOffers = buildOffers("new-generation-chilli", productUrl);

const buyerSpec = [
  { param: "Product form", value: "Confirm specification" },
  { param: "Variety", value: "New Generation Chilli" },
  { param: "Heat level (SHU)", value: "20,000–50,000" },
  { param: "ASTA colour value", value: "Confirm specification" },
  { param: "Mesh size", value: "Confirm specification" },
  { param: "Moisture", value: "<13%" },
  { param: "Processing", value: "Confirm specification" },
  { param: "Certifications", value: "ISO 9001 & HACCP standard — BRC, Halal, Kosher on request" },
];

const glanceFacts = [
  { label: "Heat level", value: "20,000–50,000 SHU" },
  { label: "Region", value: "Shandong" },
  { label: "Best for", value: "Seasoning blends, chilli powder" },
  { label: "Certifications", value: "ISO 9001 & HACCP" },
];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "https://drychillis.com/products/new-generation-chilli/#product",
  "name": "New Generation Chilli",
  "description": "New Generation pepper — high-heat chilli at 20,000–50,000 SHU from Shandong, for seasoning blends and chilli powder. China manufacturer, ISO 9001 & HACCP.",
  "image": ["https://drychillis.com/images/products/chilli-whole.jpg"],
  "url": "https://drychillis.com/products/new-generation-chilli/",
  "sku": "TENDA-NEW-GENERATION-CHILLI",
  "category": "Spices and Seasonings",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  ...(productOffers ? { "offers": productOffers } : {}),
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Heat Level (SHU)", "value": "20,000–50,000", "unitText": "SHU" },
    { "@type": "PropertyValue", "name": "Region", "value": "Shandong" },
    { "@type": "PropertyValue", "name": "Best For", "value": "Seasoning blends, chilli powder" }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is New Generation chilli?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "New Generation is a high-heat chilli at 20,000–50,000 SHU from Shandong, used mainly for seasoning blends and chilli powder. It sits in the same band as Sanying, Zidantou and Seven-Star."
      }
    },
    {
      "@type": "Question",
      "name": "How hot is New Generation pepper?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "New Generation is high heat at 20,000–50,000 SHU — strong and lingering, above medium varieties like Xian and Jinta and below the extra-hot band over 50,000 SHU. Specify a precise SHU window rather than a single number."
      }
    },
    {
      "@type": "Question",
      "name": "What is New Generation pepper used for?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "New Generation is bought for seasoning blends, chilli powder and flakes. Heat, colour and flavour vary independently, so name the variety and the SHU window to keep the blend consistent."
      }
    }
  ]
};
---

<BaseLayout
  title="New Generation Chilli — 20,000–50,000 SHU | Tenda Peppers"
  description="New Generation pepper — high-heat chilli at 20,000–50,000 SHU from Shandong, for seasoning blends and chilli powder. China manufacturer, ISO 9001 & HACCP."
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/">Home</a> &rsaquo; <a href="/products/dried-chillies/">Dried Chillies</a> &rsaquo; New Generation
    </nav>
    <h1>New Generation Chilli</h1>
    <p class="lead">
      A high-heat chilli at 20,000–50,000 SHU from Shandong, bought for seasoning blends and chilli powder.
    </p>
    <div class="takeaways">
      <strong>Short answer:</strong> New Generation is a high-heat chilli (20,000–50,000 SHU) from Shandong, used for seasoning blends and chilli powder. It shares the high-heat band with Sanying, Zidantou and Seven-Star — heat-forward, but not at the extreme end of the ladder.
    </div>
    <AtAGlance facts={glanceFacts} />
    <div class="product-media">
      <img src="/images/products/chilli-whole.jpg" alt="Whole dried chillies" width="1400" height="1050" loading="eager" />
    </div>
    <p class="product-price" style="font-weight:600;color:#8a1c1c;margin:10px 0 0;">Price confirmed on quotation — MOQ, packing and specification agreed before order.</p>

    <h2 style="margin-top:32px;">What is New Generation chilli?</h2>
    <p>
      New Generation is a high-heat chilli at 20,000–50,000 SHU from Shandong. It is listed on the <a href="/heat-levels/high-heat/">high heat</a> page next to Sanying, Zidantou and Seven-Star, and is bought mainly for seasoning blends and powder — products where heat is a defining feature but not the only point.
    </p>
    <table>
      <thead>
        <tr><th>Property</th><th>Detail</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>Heat (SHU)</strong></td><td>20,000–50,000</td></tr>
        <tr><td><strong>Region</strong></td><td>Shandong</td></tr>
        <tr><td><strong>Best for</strong></td><td>Seasoning blends, chilli powder</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">What is New Generation pepper used for?</h2>
    <ul>
      <li>Seasoning blends</li>
      <li>Chilli powder</li>
      <li>Chilli flakes</li>
    </ul>

    <h2 style="margin-top:32px;">New Generation vs Sanying vs Zidantou</h2>
    <p>
      Sanying (Tianying) and Zidantou are the classic hot-sauce varieties at 20,000–50,000 SHU; New Generation is bought more for seasoning blends and powder. All sit in the same band, so heat, colour and flavour vary independently — name the variety and a precise SHU window in your specification.
    </p>

    <h2 style="margin-top:32px;">New Generation Chilli by the numbers</h2>
    <p>
      New Generation runs 20,000–50,000 SHU — the largest heat-forward band on our ladder, above medium varieties like Xian and Jinta (10,000–20,000) and below the extra-hot band over 50,000 SHU.
    </p>
    <p class="data-note">
      Heat values are representative per variety. Confirm your exact SHU window, form and mesh when
      you inquire.
    </p>

    <BuyerSpec rows={buyerSpec} />

    <h2 style="margin-top:32px;">Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is New Generation chilli?</h3>
      <p>New Generation is a high-heat chilli at 20,000–50,000 SHU from Shandong, used mainly for seasoning blends and chilli powder. It sits in the same band as Sanying, Zidantou and Seven-Star.</p>
    </div>
    <div class="faq-item">
      <h3>How hot is New Generation pepper?</h3>
      <p>New Generation is high heat at 20,000–50,000 SHU — strong and lingering, above medium varieties like Xian and Jinta and below the extra-hot band over 50,000 SHU. Specify a precise SHU window rather than a single number.</p>
    </div>
    <div class="faq-item">
      <h3>What is New Generation pepper used for?</h3>
      <p>New Generation is bought for seasoning blends, chilli powder and flakes. Heat, colour and flavour vary independently, so name the variety and the SHU window to keep the blend consistent.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/contact/">Request New Generation Quotation</a>
      <a class="cta cta-outline" href="/products/dried-chillies/" style="margin-left:8px;">Dried Chillies →</a>
    </div>
  </div>
</BaseLayout>
