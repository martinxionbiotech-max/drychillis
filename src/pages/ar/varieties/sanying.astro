---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هو فلفل سانينغ؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "سانينغ، ويسمى أيضًا تيانيينغ، فلفل من نوع الموجّه للسماء العنقودي من خنان وخبي، عند 20,000–50,000 SHU. هو الشكل الكلاسيكي للفلفل الجاف عالي الحرارة وأساس الصلصات الحارة وزيت الفلفل ونكهات الوجبات الخفيفة."
      }
    },
    {
      "@type": "Question",
      "name": "ما مدى حرارة فلفل سانينغ؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يقع سانينغ في نطاق الحرارة العالية، 20,000–50,000 SHU — حرارة قوية ومستمرة للصلصات الحارة والأغذية الصناعية، أعلى بكثير من الأصناف المتوسطة وأقل من جيشين وشياومي فائقي الحرارة."
      }
    },
    {
      "@type": "Question",
      "name": "فيمَ يُستخدم فلفل سانينغ؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "سانينغ معيارٌ للصلصات الحارة وزيت الفلفل ونكهات الوجبات الخفيفة والنودلز الفوري والأغذية الصناعية. حدده بالصنف ونطاق SHU دقيق لثبات الدفعات."
      }
    }
  ]
};
---

<BaseLayout
  title="فلفل سانينغ (تيانيينغ) — 20,000–50,000 SHU | Tenda Peppers"
  description="فلفل سانينغ (تيانيينغ) — فلفل موجه للسماء عنقودي من خنان وخبي عند 20,000–50,000 SHU للصلصة الحارة وزيت الفلفل والوجبات الخفيفة. مصنع صيني."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; سانينغ
    </nav>
    <h1>فلفل سانينغ (تيانيينغ)</h1>
    <p class="lead">
      الفلفل الجاف الكلاسيكي عالي الحرارة — فلفل موجه للسماء عنقودي عند 20,000–50,000 SHU، يزرع في
      خنان وخبي. أساس الصلصات الحارة وزيت الفلفل والوجبات الخفيفة.
    </p>

    <h2 style="margin-top:32px;">ما هو فلفل سانينغ؟</h2>
    <p>
      سانينغ — ويباع أيضًا باسم تيانيينغ — فلفل موجه للسماء عنقودي وهو الشكل المحدد لسوق الفلفل
      الجاف الصيني عالي الحرارة. حرارته في نطاق 20,000–50,000 SHU: قوية ومستمرة، لكنها قابلة للتحكم
      في الخلطة عند الجرع بالوزن. انظر صفحة <a href="/ar/heat-levels/high-heat/">الحرارة العالية</a>.
    </p>
    <table>
      <thead>
        <tr><th>الخاصية</th><th>التفصيل</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>الحرارة (SHU)</strong></td><td>20,000 – 50,000</td></tr>
        <tr><td><strong>المنطقة</strong></td><td>خنان، خبي</td></tr>
        <tr><td><strong>نوع الثمرة</strong></td><td>موجه للسماء عنقودي</td></tr>
        <tr><td><strong>الأفضل لـ</strong></td><td>الصلصة الحارة، زيت الفلفل، الوجبات الخفيفة</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">فيمَ يُستخدم فلفل سانينغ؟</h2>
    <ul>
      <li>الصلصات الحارة وزيت الفلفل</li>
      <li>نكهات الوجبات الخفيفة والنودلز الفوري</li>
      <li>الأغذية الصناعية والتوابل المصنعة</li>
      <li>مسحوق الفلفل والرقائق (عالية الحرارة)</li>
    </ul>

    <h2 style="margin-top:32px;">كيف تحدد فلفل سانينغ</h2>
    <p>
      سمِّ الصنف، ثم الشكل (كامل، مسحوق، رقائق أو شرائح)، ونطاق SHU، والرطوبة، والميش. الحرارة غير
      خطية وتعتمد على الصنف، لذا «سانينغ، 20,000–50,000 SHU، 60–80 ميش» طلبٌ أوثق بكثير من «مسحوق
      فلفل حار».
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكد نطاق SHU والشكل الدقيق عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما هو فلفل سانينغ؟</h3>
      <p>سانينغ، ويسمى أيضًا تيانيينغ، فلفل من نوع الموجّه للسماء العنقودي من خنان وخبي، عند 20,000–50,000 SHU. هو الشكل الكلاسيكي للفلفل الجاف عالي الحرارة وأساس الصلصات الحارة وزيت الفلفل ونكهات الوجبات الخفيفة.</p>
    </div>
    <div class="faq-item">
      <h3>ما مدى حرارة فلفل سانينغ؟</h3>
      <p>يقع سانينغ في نطاق الحرارة العالية، 20,000–50,000 SHU — حرارة قوية ومستمرة للصلصات الحارة والأغذية الصناعية، أعلى بكثير من الأصناف المتوسطة وأقل من جيشين وشياومي فائقي الحرارة.</p>
    </div>
    <div class="faq-item">
      <h3>فيمَ يُستخدم فلفل سانينغ؟</h3>
      <p>سانينغ معيارٌ للصلصات الحارة وزيت الفلفل ونكهات الوجبات الخفيفة والنودلز الفوري والأغذية الصناعية. حدده بالصنف ونطاق SHU دقيق لثبات الدفعات.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر سانينغ</a>
      <a class="cta cta-outline" href="/ar/varieties/jixin/" style="margin-left:8px;">جيشين (فائق) ←</a>
    </div>
  </div>
</BaseLayout>
