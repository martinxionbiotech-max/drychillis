---
interface GlanceFact {
  label: string;
  value: string;
}

interface Props {
  facts: GlanceFact[];
  lang?: string;
}

const { facts = [], lang = "en" } = Astro.props;

const TITLES: Record<string, string> = {
  en: "At a Glance",
  es: "De un Vistazo",
  ar: "نظرة سريعة",
  ru: "Кратко",
};
---
<div class="at-a-glance" aria-label="At a glance — key facts">
  <h2 style="margin:0 0 10px;">{TITLES[lang] ?? TITLES.en}</h2>
  <dl>
    {
      facts.map((f) => (
        <div class="glance-row">
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))
    }
  </dl>
</div>
