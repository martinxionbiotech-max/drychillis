---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما الذي يُعد فلفلًا فائق الحرارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الفلفل فائق الحرارة يتجاوز 50,000 وحدة سكوفيل (SHU) — حرارة شديدة في كامل الفم لمنتجات الحرارة القصوى وزيت الفلفل وأطباق سيتشوان. الأصناف التمثيلية: جيشين (50,000–70,000 SHU) وشياومي وتشيلي كينغ وشوان شوان."
      }
    },
    {
      "@type": "Question",
      "name": "فيمَ يُستخدم الفلفل فائق الحرارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُستخدم حيث تكون الحرارة هي العنوان: صلصات الحرارة القصوى وزيت الفلفل ومطبخ سيتشوان وهونان والمنتجات المسوَّقة بمستوى سكوفيل."
      }
    },
    {
      "@type": "Question",
      "name": "أي صنف يعطي أقصى حرارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "جيشين (قلب الدجاجة) هو من أكثر أنواع الفلفل الصيني حرارة عند 50,000–70,000 SHU، إلى جانب شياومي وتشيلي كينغ. وهي المعيار لمنتجات الحرارة القصوى وزيت الفلفل."
      }
    }
  ]
};
---

<BaseLayout
  title="فلفل فائق الحرارة (50,000+ SHU) | Tenda Peppers"
  description="فلفل فائق الحرارة (50,000+ SHU) — جيشين وشياومي وتشيلي كينغ للحرارة القصوى وزيت الفلفل وأطباق سيتشوان. مُصنّع في الصين، ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; حرارة فائقة
    </nav>
    <h1>فلفل فائق الحرارة (50,000+ SHU)</h1>
    <p class="lead">
      حرارة شديدة في كامل الفم — نطاق 50,000+ SHU مخصص للمنتجات التي تكون فيها الحرارة هي العنوان،
      على أصناف مثل جيشين (قلب الدجاجة) وشياومي وتشيلي كينغ.
    </p>

    <h2 style="margin-top:32px;">ما الذي يُعد فلفلًا فائق الحرارة؟</h2>
    <p>
      الحرارة الفائقة هي قمة النطاق الشائع للفلفل الصيني: أكثر من 50,000 SHU. ولأن الحرارة غير
      خطية، فإن جرعة صغيرة من الفلفل الفائق تحرّك حرارة الخلطة أكثر بكثير من الوزن نفسه من صنف
      عالي الحرارة — لذا يُحدد بعناية ويُستخدم عادةً كلمسة لا كأساس.
    </p>
    <table>
      <thead>
        <tr><th>الصنف</th><th>الحرارة (SHU)</th><th>المنطقة</th><th>الأنسب لـ</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>جيشين (قلب الدجاجة)</strong></td><td>50,000 – 70,000</td><td>يونان، قويتشو</td><td>حرارة قصوى، سيتشوان</td></tr>
        <tr><td><strong>شياومي</strong></td><td>30,000 – 50,000</td><td>يونان</td><td>زيت الفلفل، حرارة قصوى</td></tr>
        <tr><td><strong>تشيلي كينغ</strong></td><td>&gt;50,000</td><td>فوجيان، هاينان</td><td>منتجات الحرارة القصوى</td></tr>
        <tr><td><strong>شوان شوان</strong></td><td>&gt;50,000</td><td>جنوب الصين</td><td>توابل الحرارة القصوى</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">فيمَ يُستخدم الفلفل فائق الحرارة؟</h2>
    <ul>
      <li>صلصات الحرارة القصوى وزيت الفلفل</li>
      <li>مطبخ سيتشوان وهونان</li>
      <li>منتجات مسوَّقة بمستوى سكوفيل</li>
      <li>توابل صناعية بجرعات حرارة مضبوطة</li>
    </ul>

    <h2 style="margin-top:32px;">كيف تحدد الفلفل فائق الحرارة</h2>
    <p>
      سمِّ الصنف ونطاق SHU دقيقًا — جيشين (50,000–70,000 SHU) هو المرجع للحرارة القصوى. أكّد الشكل
      (القطع والمسحوق هما الأكثر شيوعًا عند هذا المستوى) وجرّع بحذر: الأصناف الفائقة تُخلط عادةً
      ولا تُستخدم صافية.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكّد نطاق SHU الدقيق والشكل عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما الذي يُعد فلفلًا فائق الحرارة؟</h3>
      <p>الفلفل فائق الحرارة يتجاوز 50,000 وحدة سكوفيل (SHU) — حرارة شديدة في كامل الفم لمنتجات الحرارة القصوى وزيت الفلفل وأطباق سيتشوان. الأصناف التمثيلية: جيشين (50,000–70,000 SHU) وشياومي وتشيلي كينغ وشوان شوان.</p>
    </div>
    <div class="faq-item">
      <h3>فيمَ يُستخدم الفلفل فائق الحرارة؟</h3>
      <p>يُستخدم حيث تكون الحرارة هي العنوان: صلصات الحرارة القصوى وزيت الفلفل ومطبخ سيتشوان وهونان والمنتجات المسوَّقة بمستوى سكوفيل.</p>
    </div>
    <div class="faq-item">
      <h3>أي صنف يعطي أقصى حرارة؟</h3>
      <p>جيشين (قلب الدجاجة) هو من أكثر أنواع الفلفل الصيني حرارة عند 50,000–70,000 SHU، إلى جانب شياومي وتشيلي كينغ. وهي المعيار لمنتجات الحرارة القصوى وزيت الفلفل.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر للحرارة الفائقة</a>
      <a class="cta cta-outline" href="/ar/heat-levels/high-heat/" style="margin-left:8px;">→ حرارة عالية</a>
    </div>
  </div>
</BaseLayout>
