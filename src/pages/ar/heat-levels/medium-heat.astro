---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما الذي يُعد فلفلًا متوسط الحرارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الفلفل متوسط الحرارة هو 10,000–20,000 وحدة سكوفيل (SHU) — دافئ بشكل ملحوظ دون حرق الأصناف عالية الحرارة. الأصناف الصينية التمثيلية: شيان وجينتا وإرجينغتياو."
      }
    },
    {
      "@type": "Question",
      "name": "فيمَ يُستخدم الفلفل متوسط الحرارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "هو أساس التوابل العامة ومعجون الفلفل وإضافات البيتزا والوجبات الخفيفة وخلطات التوابل اليومية حيث يجب أن تكون الحرارة حاضرة دون أن تطغى."
      }
    },
    {
      "@type": "Question",
      "name": "ما الأصناف التي يجب تحديدها لـ 10,000–20,000 SHU؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "شيان وجينتا وإرجينغتياو هي الأصناف الرئيسية في نطاق 10,000–20,000 SHU. جينتا مثالي للرقائق والمسحوق؛ إرجينغتياو يضيف رائحة ويُستخدم في معجون الفلفل. سمِّ الصنف ونطاق SHU في مواصفتك."
      }
    }
  ]
};
---

<BaseLayout
  title="فلفل متوسط الحرارة (10,000–20,000 SHU) | Tenda Peppers"
  description="فلفل متوسط الحرارة (10,000–20,000 SHU) — شيان وجينتا وإرجينغتياو للتوابل ومعجون الفلفل وإضافات البيتزا. مُصنّع في الصين، ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; حرارة متوسطة
    </nav>
    <h1>فلفل متوسط الحرارة (10,000–20,000 SHU)</h1>
    <p class="lead">
      دافئ بشكل ملحوظ، غير مُرهِق — نطاق 10,000–20,000 SHU هو أساس التوابل اليومية، من أصناف مثل
      شيان وجينتا وإرجينغتياو.
    </p>

    <h2 style="margin-top:32px;">ما الذي يُعد فلفلًا متوسط الحرارة؟</h2>
    <p>
      تقع الحرارة المتوسطة بين المنخفضة (أقل من 10,000 SHU) والعالية (20,000–50,000 SHU). تمنح
      دفئًا ورائحة واضحة، لكنها تبقى خفيفة بما يكفي لمنتجات جمهور واسع — لذا فهي الخيار الافتراضي
      للبيتزا والوجبات الخفيفة وخلطات التوابل.
    </p>
    <table>
      <thead>
        <tr><th>الصنف</th><th>الحرارة (SHU)</th><th>المنطقة</th><th>الأنسب لـ</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>شيان</strong></td><td>10,000 – 20,000</td><td>منغوليا الداخلية، شينجيانغ</td><td>مسحوق متوسط، رقائق</td></tr>
        <tr><td><strong>جينتا</strong></td><td>10,000 – 20,000</td><td>قانسو، منغوليا الداخلية</td><td>رقائق، مسحوق (أحمر لامع)</td></tr>
        <tr><td><strong>إرجينغتياو</strong></td><td>10,000 – 20,000</td><td>سيتشوان، قويتشو</td><td>معجون الفلفل، الرائحة</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">فيمَ يُستخدم الفلفل متوسط الحرارة؟</h2>
    <ul>
      <li>رقائق الفلفل للبيتزا والمعكرونة</li>
      <li>خلطات التوابل والبهارات اليومية</li>
      <li>معجون الفلفل وصلصات المائدة</li>
      <li>توابل الوجبات الخفيفة والمقرمشات</li>
    </ul>

    <h2 style="margin-top:32px;">كيف تحدد الفلفل متوسط الحرارة</h2>
    <p>
      سمِّ الصنف ونطاق SHU، ثم الشكل. للرقائق اختر جينتا أو شيان؛ وللمعجون العطري اختر إرجينغتياو.
      أكّد الرطوبة (أقل من 13%) وللمسحوق الميش (60–80 ميش قياسي).
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكّد نطاق SHU الدقيق والشكل والميش والرطوبة عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما الذي يُعد فلفلًا متوسط الحرارة؟</h3>
      <p>الفلفل متوسط الحرارة هو 10,000–20,000 وحدة سكوفيل (SHU) — دافئ بشكل ملحوظ دون حرق الأصناف عالية الحرارة. الأصناف الصينية التمثيلية: شيان وجينتا وإرجينغتياو.</p>
    </div>
    <div class="faq-item">
      <h3>فيمَ يُستخدم الفلفل متوسط الحرارة؟</h3>
      <p>هو أساس التوابل العامة ومعجون الفلفل وإضافات البيتزا والوجبات الخفيفة وخلطات التوابل اليومية حيث يجب أن تكون الحرارة حاضرة دون أن تطغى.</p>
    </div>
    <div class="faq-item">
      <h3>ما الأصناف التي يجب تحديدها لـ 10,000–20,000 SHU؟</h3>
      <p>شيان وجينتا وإرجينغتياو هي الأصناف الرئيسية في نطاق 10,000–20,000 SHU. جينتا مثالي للرقائق والمسحوق؛ إرجينغتياو يضيف رائحة ويُستخدم في معجون الفلفل. سمِّ الصنف ونطاق SHU في مواصفتك.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر للحرارة المتوسطة</a>
      <a class="cta cta-outline" href="/ar/heat-levels/high-heat/" style="margin-left:8px;">حرارة عالية ←</a>
    </div>
  </div>
</BaseLayout>
