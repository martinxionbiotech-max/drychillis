---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "مسحوق الفلفل الحلو (حلو ومنخفض الحرارة)",
  "description": "مسحوق فلفل حلو منخفض الحرارة وعالي اللون مصنوع من أصناف الفلفل الحلو الصينية — فلفل حلو وفلفل حلو منخفض الحرارة للتلوين الأحمر الطبيعي وخلطات التوابل والتتبيلات.",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "فيما يُستخدم مسحوق الفلفل الحلو؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُستخدم مسحوق الفلفل الحلو أساسًا للتلوين الأحمر الطبيعي والنكهة المعتدلة في خلطات التوابل والتتبيلات والنقانق وتتبيل الوجبات الخفيفة واستخلاص زيت الفلفل الحلو (ملون غذائي أحمر طبيعي)."
      }
    },
    {
      "@type": "Question",
      "name": "ما الفرق بين الفلفل الحلو والفلفل الحلو منخفض الحرارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُصنع الفلفل الحلو (أقل من 500 وحدة سكوفيل) من أصناف فلفل حلو عالية اللون مثل فلفل شينجيانغ الحلو وRed Dragon 23، بقيمة لون ASTA من 8 إلى 18. ويأتي الفلفل الحلو منخفض الحرارة (أقل من 10,000 وحدة سكوفيل) من أصناف مثل ييدو الأحمر ووانغدو، مضيفًا حرارة معتدلة ورائحة فلفل واضحة فوق اللون."
      }
    },
    {
      "@type": "Question",
      "name": "ما قيمة اللون ASTA التي يمكنكم توريدها؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نورد مسحوق الفلفل الحلو في نطاق قيمة لون ASTA من حوالي 60 إلى 240، حسب الصنف والدرجة. أكّد قيمة اللون المستهدفة ومستوى الحرارة عند الاستفسار."
      }
    },
    {
      "@type": "Question",
      "name": "ما مواصفات الرطوبة والشبكة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُورَّد مسحوق الفلفل الحلو عادة برطوبة أقل من 13% وشبكة 60–80، مع مواصفات قابلة للتعديل وفقًا لمتطلباتك. الفحص بالأشعة السينية وكشف المعادن قياسيان في كل دفعة."
      }
    }
  ]
};
---

<BaseLayout
  lang="ar"
  title="مصنّع مسحوق الفلفل الحلو | Tenda Peppers"
  description="مصنّع صيني لمسحوق الفلفل الحلو. فلفل حلو وفلفل حلو منخفض الحرارة من فلفل شينجيانغ الحلو وييدو الأحمر — تلوين أحمر طبيعي لخلطات التوابل والتتبيلات. ISO 9001 وHACCP."
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; مسحوق الفلفل الحلو
    </nav>
    <h1>مسحوق الفلفل الحلو</h1>
    <p class="lead">
      فلفل حلو منخفض الحرارة وعالي اللون مطحون من أصناف الفلفل الحلو الصينية — للتلوين الأحمر
      الطبيعي وخلطات التوابل والتتبيلات في أوروبا والشرق الأوسط وأمريكا الشمالية.
    </p>

    <h2 style="margin-top:32px;">مجموعة الفلفل الحلو لدينا</h2>
    <table>
      <thead>
        <tr><th>المنتج</th><th>الصنف</th><th>الحرارة (SHU)</th><th>اللون (ASTA)</th><th>الأنسب لـ</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>مسحوق الفلفل الحلو</strong></td>
          <td>فلفل شينجيانغ الحلو، Red Dragon 23</td>
          <td>&lt;500</td>
          <td>8–18</td>
          <td>تلوين الأغذية، استخلاص زيت الفلفل الحلو</td>
        </tr>
        <tr>
          <td><strong>مسحوق الفلفل الحلو منخفض الحرارة</strong></td>
          <td>ييدو الأحمر، وانغدو</td>
          <td>&lt;10,000</td>
          <td>عالي (لحم سميك)</td>
          <td>تلوين مع رائحة فلفل واضحة، تتبيلات</td>
        </tr>
      </tbody>
    </table>
    <p class="data-note">
      قيم اللون ومستويات الحرارة نطاقات تمثيلية لكل صنف — تُضبط المواصفات النهائية وفقًا لقيمة
      ASTA وSHU المستهدفة عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">المواصفات</h2>
    <table>
      <thead>
        <tr><th>المعيار</th><th>النطاق النموذجي</th></tr>
      </thead>
      <tbody>
        <tr><td>قيمة اللون ASTA</td><td>60–240 (حسب الصنف)</td></tr>
        <tr><td>مستوى الحرارة (SHU)</td><td>&lt;500 – 10,000</td></tr>
        <tr><td>الرطوبة</td><td>&lt;13%</td></tr>
        <tr><td>الشبكة</td><td>60–80 (قابلة للتعديل)</td></tr>
        <tr><td>المعالجة</td><td>نزع البذور، الترشيح المغناطيسي، الفحص بالأشعة السينية، الفرز بالألوان</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">التطبيقات</h2>
    <ul>
      <li>خلطات التوابل والتتبيل</li>
      <li>التتبيلات وخلطات اللحوم</li>
      <li>تتبيل الوجبات الخفيفة والنودلز سريعة التحضير</li>
      <li>تلوين النقانق واللحوم المصنعة</li>
      <li>استخلاص زيت الفلفل الحلو (ملون غذائي أحمر طبيعي)</li>
    </ul>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>فيما يُستخدم مسحوق الفلفل الحلو؟</h3>
      <p>يُستخدم مسحوق الفلفل الحلو أساسًا للتلوين الأحمر الطبيعي والنكهة المعتدلة في خلطات التوابل والتتبيلات والنقانق وتتبيل الوجبات الخفيفة واستخلاص زيت الفلفل الحلو.</p>
    </div>
    <div class="faq-item">
      <h3>ما الفرق بين الفلفل الحلو والفلفل الحلو منخفض الحرارة؟</h3>
      <p>يُصنع الفلفل الحلو (أقل من 500 وحدة سكوفيل) من أصناف فلفل حلو عالية اللون، بينما يأتي الفلفل الحلو منخفض الحرارة (أقل من 10,000 وحدة سكوفيل) من أصناف مثل ييدو الأحمر، مضيفًا حرارة معتدلة ورائحة فلفل واضحة.</p>
    </div>
    <div class="faq-item">
      <h3>ما قيمة اللون ASTA التي يمكنكم توريدها؟</h3>
      <p>نورد مسحوق الفلفل الحلو في نطاق قيمة لون ASTA من حوالي 60 إلى 240، حسب الصنف والدرجة. أكّد قيمة اللون المستهدفة عند الاستفسار.</p>
    </div>
    <div class="faq-item">
      <h3>ما مواصفات الرطوبة والشبكة؟</h3>
      <p>يُورَّد مسحوق الفلفل الحلو عادة برطوبة أقل من 13% وشبكة 60–80، مع مواصفات قابلة للتعديل. الفحص بالأشعة السينية وكشف المعادن قياسيان في كل دفعة.</p>
    </div>

    <div style="margin-top:32px;padding:20px;background:#faf5f2;border-radius:8px;">
      <h2 style="margin-top:0;">وثائق تقنية ذات صلة</h2>
      <ul style="margin-bottom:0;">
        <li><a href="https://docs.drychillis.com/buying-guide/" target="_blank" rel="noopener">دليل شراء الفلفل الحلو والفلفل الحار</a></li>
        <li><a href="https://docs.drychillis.com/asta-shu-explained/" target="_blank" rel="noopener">شرح لون ASTA ووحدات SHU</a></li>
        <li><a href="https://docs.drychillis.com/colour-storage/" target="_blank" rel="noopener">تغير اللون والتخزين</a></li>
      </ul>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">طلب عرض سعر الفلفل الحلو</a>
    </div>
  </div>
</BaseLayout>
