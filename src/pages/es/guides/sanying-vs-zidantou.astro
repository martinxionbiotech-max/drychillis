        <tr style="border-bottom:1px solid #eee0d8;">
          <td style="padding:8px;"><strong>Forma</strong></td>
          <td style="padding:8px;">Racimo orientado al cielo</td>
          <td style="padding:8px;">Bala cónica</td>
        </tr>
        <tr style="border-bottom:1px solid #eee0d8;">
