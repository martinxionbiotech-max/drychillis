---
import BaseLayout from "../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Sanying chilli?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sanying, also called Tianying, is a cluster-type facing-heaven chilli from Henan and Hebei at 20,000–50,000 SHU. It is the classic high-heat dry-chilli shape — the variety most buyers default to when they need dependable high heat for hot sauce, chilli oil and snack seasoning."
      }
    },
    {
      "@type": "Question",
      "name": "How hot is Sanying pepper?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sanying sits in the high-heat band, 20,000–50,000 SHU — strong, lingering heat, well above medium varieties and below the extra-hot Jixin and Xiaomi. Heat is non-linear, so a precise SHU window, not just \"high heat\", is what keeps a blend consistent."
      }
    },
    {
      "@type": "Question",
      "name": "What is Sanying pepper used for?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sanying is a standard for hot sauces, chilli oil, snack and instant-noodle seasoning, and industrial food. Heat, colour and flavour vary independently, so specify it by variety and a precise SHU window — the variety name is what locks batch-to-batch consistency."
      }
    }
  ]
};
