---
import BaseLayout from "../../layouts/BaseLayout.astro";

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Tenda Peppers Buyer Guides",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Paprika & Chilli Buying Guide", "item": "https://drychillis.com/guides/paprika-chilli-buying-guide/" },
    { "@type": "ListItem", "position": 2, "name": "ASTA Colour & SHU Heat Explained", "item": "https://drychillis.com/guides/asta-colour-and-shu-heat-explained/" },
    { "@type": "ListItem", "position": 3, "name": "Chinese Chilli Varieties & Grades", "item": "https://drychillis.com/guides/chinese-chilli-varieties-grades/" },
    { "@type": "ListItem", "position": 4, "name": "Chilli Powder Colour Change & Storage", "item": "https://drychillis.com/guides/chilli-powder-colour-storage/" },
    { "@type": "ListItem", "position": 5, "name": "Smoked Paprika vs Chilli Powder", "item": "https://drychillis.com/guides/smoked-paprika-vs-chilli-powder/" },
    { "@type": "ListItem", "position": 6, "name": "Sea vs Air Freight for Chilli Imports", "item": "https://drychillis.com/guides/sea-vs-air-freight/" },
    { "@type": "ListItem", "position": 7, "name": "ASTA Color Value in Paprika", "item": "https://drychillis.com/guides/asta-colour-value/" },
    { "@type": "ListItem", "position": 8, "name": "Dried Chilli Food Safety & Quality", "item": "https://drychillis.com/guides/food-safety-quality/" },
    { "@type": "ListItem", "position": 9, "name": "Whole vs Flakes vs Powder Chilli", "item": "https://drychillis.com/guides/chilli-form-whole-flakes-powder/" }
  ]
};
---

<BaseLayout
  title="Guides & Technical Resources | Tenda Peppers"
  description="Buyer guides for paprika and dried chillies — specify chilli powder, Chinese varieties, SHU heat levels, mesh size and packaging."
  jsonLd={[itemListJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/">Home</a> &rsaquo; Guides
    </nav>
    <h1>Guides &amp; Technical Resources</h1>
    <p class="lead">
      Buyer guides and reference pages for specifying and sourcing paprika and dried chillies — from
      heat levels to mesh size and packaging.
    </p>

    <div class="takeaways">
      <strong>Short answer:</strong> This hub indexes 6 buyer guides that cover the core sourcing decisions — from SHU heat bands (10,000–20,000 medium, 20,000–50,000 high, 50,000+ extra hot) to mesh size, colour storage and sea-vs-air freight. Use the list below when you need a citable specification answer.
    </div>

    <p>
      <strong>Guide list at a glance:</strong>
      <a href="/guides/paprika-chilli-buying-guide/">how to specify chilli powder</a>,
      <a href="/guides/chinese-chilli-varieties-grades/">Chinese chilli varieties &amp; grades</a>,
      <a href="/guides/asta-colour-and-shu-heat-explained/">ASTA colour &amp; SHU heat</a>,
      <a href="/guides/smoked-paprika-vs-chilli-powder/">smoked paprika vs chilli powder</a>,
      <a href="/guides/chilli-powder-colour-storage/">chilli powder colour &amp; storage</a>,
      <a href="/guides/sea-vs-air-freight/">sea vs air freight</a>, and
      <a href="/guides/asta-colour-value/">ASTA colour value in paprika</a>, and
      <a href="/guides/food-safety-quality/">food safety &amp; quality</a>, and
      <a href="/guides/chilli-form-whole-flakes-powder/">whole vs flakes vs powder</a>.
    </p>

    <h2 style="margin-top:32px;">Heat Levels (SHU)</h2>
    <ul>
      <li><a href="/heat-levels/medium-heat/">Medium heat chilli (10,000–20,000 SHU)</a></li>
      <li><a href="/heat-levels/high-heat/">High heat chilli (20,000–50,000 SHU)</a></li>
      <li><a href="/heat-levels/extra-hot/">Extra hot chilli (50,000+ SHU)</a></li>
    </ul>

    <h2 style="margin-top:32px;">Specifications &amp; Packaging</h2>
    <ul>
      <li><a href="/specs/mesh-size/">Chilli powder mesh size guide</a></li>
      <li><a href="/packaging/">Bulk &amp; OEM packaging</a></li>
    </ul>

    <h2 style="margin-top:32px;">Buyer Guides</h2>
    <ul>
      <li><a href="/guides/paprika-chilli-buying-guide/">How to specify chilli powder: SHU, mesh &amp; moisture</a></li>
      <li><a href="/guides/chinese-chilli-varieties-grades/">Chinese chilli varieties: a heat &amp; region guide</a></li>
      <li><a href="/guides/asta-colour-and-shu-heat-explained/">Chilli heat explained: SHU vs capsaicin</a></li>
      <li><a href="/guides/smoked-paprika-vs-chilli-powder/">Smoked paprika vs chilli powder: heat, colour &amp; when to use which</a></li>
      <li><a href="/guides/chilli-powder-colour-storage/">Chilli powder colour change &amp; storage</a></li>
      <li><a href="/guides/sea-vs-air-freight/">Sea vs air freight for chilli imports</a></li>
    </ul>
    <p class="data-note" style="margin-top:10px;">Values are representative ranges (MEDIUM confidence) that vary by variety and origin. Confirm your target SHU, ASTA, moisture and mesh with us. 复核 2026-09-09.</p>

    <p style="margin-top:24px;">
      For the full technical documentation set, visit the
      <a href="https://docs.drychillis.com/" target="_blank" rel="noopener">Tenda Peppers Knowledge Hub</a>.
    </p>
  </div>
</BaseLayout>
