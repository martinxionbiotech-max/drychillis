---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BuyerSpec from "../../../components/BuyerSpec.astro";
import AtAGlance from "../../../components/AtAGlance.astro";

const buyerSpec = [
  { param: "شكل المنتج", value: "تأكيد المواصفات" },
  { param: "الصنف", value: "تشيلي كينغ" },
  { param: "مستوى الحرارة (SHU)", value: ">50,000" },
  { param: "قيمة اللون ASTA", value: "تأكيد المواصفات" },
  { param: "حجم الشبكة (Mesh)", value: "تأكيد المواصفات" },
  { param: "الرطوبة", value: "<13%" },
  { param: "المعالجة", value: "تأكيد المواصفات" },
  { param: "الشهادات", value: "ISO 9001 وHACCP قياسيًا — BRC وحلال وكوشر عند الطلب" },
];

const glanceFacts = [
  { label: "مستوى الحرارة", value: ">50,000 SHU" },
  { label: "المنطقة", value: "فوجيان، هاينان" },
  { label: "الأنسب لـ", value: "منتجات الحرارة القصوى، زيت الفلفل" },
  { label: "الشهادات", value: "ISO 9001 وHACCP" },
];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "https://drychillis.com/products/chilli-king/#product",
  "name": "تشيلي كينغ",
  "description": "تشيلي كينغ — فلفل فائق الحرارة فوق 50,000 SHU من فوجيان وهاينان، لمنتجات الحرارة القصوى وزيت الفلفل والأطباق على طريقة سيتشوان. مصنع صيني، ISO 9001 وHACCP.",
  "image": ["https://drychillis.com/images/products/chilli-whole.jpg"],
  "url": "https://drychillis.com/products/chilli-king/",
  "sku": "TENDA-CHILLI-KING",
  "category": "البهارات والتوابل",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "مستوى الحرارة (SHU)", "value": ">50,000", "unitText": "SHU" },
    { "@type": "PropertyValue", "name": "المنطقة", "value": "فوجيان، هاينان" },
    { "@type": "PropertyValue", "name": "الأنسب لـ", "value": "منتجات الحرارة القصوى، زيت الفلفل" }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هو تشيلي كينغ؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تشيلي كينغ فلفل فائق الحرارة فوق 50,000 SHU من فوجيان وهاينان، من بين أكثر الأصناف الصينية شيوعًا حرارة إلى جانب جيشين وشياومي. يُستخدم لمنتجات الحرارة القصوى وزيت الفلفل والأطباق على طريقة سيتشوان."
      }
    },
    {
      "@type": "Question",
      "name": "ما مدى حرارة فلفل تشيلي كينغ؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تشيلي كينغ فوق 50,000 SHU — حرارة قوية تشمل الفم كله، في نفس نطاق جيشين (50,000–70,000 SHU) وشياومي. الحرارة والنكهة منفصلتان، لذا فالأكثر حرارة ليس تلقائيًا الخيار الأفضل لطبقك."
      }
    },
    {
      "@type": "Question",
      "name": "فيمَ يُستخدم تشيلي كينغ؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تشيلي كينغ معيار لمنتجات الحرارة القصوى وزيت الفلفل والأطباق على طريقة سيتشوان. حدد الصنف ونافذة SHU دقيقة — مع الفلفل فائق الحرارة، فرق صغير في SHU يغيّر المنتج."
      }
    }
  ]
};
---

<BaseLayout
  title="تشيلي كينغ — فلفل فائق الحرارة +50,000 SHU | Tenda Peppers"
  description="تشيلي كينغ — فلفل فائق الحرارة فوق 50,000 SHU من فوجيان وهاينان، لمنتجات الحرارة القصوى وزيت الفلفل والأطباق على طريقة سيتشوان. مصنع صيني، ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; تشيلي كينغ
    </nav>
    <h1>تشيلي كينغ</h1>
    <p class="lead">
      فلفل فائق الحرارة فوق 50,000 SHU من فوجيان وهاينان — لمنتجات الحرارة القصوى وزيت الفلفل والأطباق على طريقة سيتشوان.
    </p>
    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> تشيلي كينغ فلفل فائق الحرارة (فوق 50,000 SHU) من فوجيان وهاينان، من أكثر الأصناف الصينية شيوعًا حرارة إلى جانب جيشين وشياومي. هو المعيار لمنتجات الحرارة القصوى وزيت الفلفل — لكن الحرارة والنكهة منفصلتان، فالأكثر حرارة ليس تلقائيًا الخيار الأفضل.
    </div>
    <AtAGlance facts={glanceFacts} lang="ar" />
    <div class="product-media">
      <img src="/images/products/chilli-whole.jpg" alt="فلفل مجفف كامل" width="1400" height="1050" loading="eager" />
    </div>
    <p class="product-price" style="font-weight:600;color:#8a1c1c;margin:10px 0 0;">يُؤكَّد السعر عند طلب العرض — يُتفق على الحد الأدنى للطلب والتعبئة والمواصفات قبل الطلب.</p>

    <h2 style="margin-top:32px;">ما هو تشيلي كينغ؟</h2>
    <p>
      تشيلي كينغ فلفل فائق الحرارة فوق 50,000 SHU من فوجيان وهاينان. يظهر في صفحة <a href="/ar/heat-levels/extra-hot/">الحرارة الفائقة</a> إلى جانب جيشين (50,000–70,000 SHU) وشياومي كأحد أكثر الأصناف الصينية شيوعًا حرارة — حرارة قوية تشمل الفم كله لمنتجات الحرارة القصوى وزيت الفلفل والأطباق على طريقة سيتشوان.
    </p>
    <table>
      <thead>
        <tr><th>الخاصية</th><th>التفاصيل</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>الحرارة (SHU)</strong></td><td>>50,000</td></tr>
        <tr><td><strong>المنطقة</strong></td><td>فوجيان، هاينان</td></tr>
        <tr><td><strong>الأنسب لـ</strong></td><td>منتجات الحرارة القصوى، زيت الفلفل</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">فيمَ يُستخدم تشيلي كينغ؟</h2>
    <ul>
      <li>منتجات الحرارة القصوى</li>
      <li>زيت الفلفل</li>
      <li>الأطباق على طريقة سيتشوان</li>
    </ul>

    <h2 style="margin-top:32px;">تشيلي كينغ مقابل جيشين مقابل شياومي</h2>
    <p>
      فلفل جيشين (قلب الدجاجة) من أكثر أنواع الفلفل الصيني شيوعًا حرارة عند 50,000–70,000 SHU، إلى جانب شياومي وتشيلي كينغ. هذه هي المعيار لمنتجات الحرارة القصوى وزيت الفلفل — لكن الحرارة والنكهة منفصلتان، فالأكثر حرارة ليس تلقائيًا الخيار الأفضل لطبقك.
    </p>

    <h2 style="margin-top:32px;">تشيلي كينغ بالأرقام</h2>
    <p>
      يتجاوز تشيلي كينغ 50,000 SHU — أكثر حرارة بأكثر من 100 مرة من البابريكا الحلوة (أقل من 500 SHU) ونطاق واحد فوق أصناف الحرارة العالية 20,000–50,000 SHU. أكّد نافذة SHU الدقيقة عند الطلب، لأن نطاق الحرارة الفائقة ليس له سقف علوي.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكّد نافذة SHU والشكل والشبكة بدقة عند الاستفسار.
    </p>

    <BuyerSpec rows={buyerSpec} lang="ar" confirmText="تأكيد المواصفات" />

    <h2 style="margin-top:32px;">في نفس نطاق فوق 50,000 SHU</h2>
    <p>
      أصناف أخرى في هذا النطاق: <a href="/ar/products/jixin-chilli/">جيشين</a>، <a href="/ar/products/xiaomi-chilli/">شياومي</a>.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما هو تشيلي كينغ؟</h3>
      <p>تشيلي كينغ فلفل فائق الحرارة فوق 50,000 SHU من فوجيان وهاينان، من بين أكثر الأصناف الصينية شيوعًا حرارة إلى جانب جيشين وشياومي. يُستخدم لمنتجات الحرارة القصوى وزيت الفلفل والأطباق على طريقة سيتشوان.</p>
    </div>
    <div class="faq-item">
      <h3>ما مدى حرارة فلفل تشيلي كينغ؟</h3>
      <p>تشيلي كينغ فوق 50,000 SHU — حرارة قوية تشمل الفم كله، في نفس نطاق جيشين (50,000–70,000 SHU) وشياومي. الحرارة والنكهة منفصلتان، لذا فالأكثر حرارة ليس تلقائيًا الخيار الأفضل لطبقك.</p>
    </div>
    <div class="faq-item">
      <h3>فيمَ يُستخدم تشيلي كينغ؟</h3>
      <p>تشيلي كينغ معيار لمنتجات الحرارة القصوى وزيت الفلفل والأطباق على طريقة سيتشوان. حدد الصنف ونافذة SHU دقيقة — مع الفلفل فائق الحرارة، فرق صغير في SHU يغيّر المنتج.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر تشيلي كينغ</a>
      <a class="cta cta-outline" href="/ar/products/dried-chillies/" style="margin-left:8px;">الفلفل المجفف ←</a>
    </div>
  </div>
</BaseLayout>
