    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/">Home</a> &rsaquo; <a href="/guides/">Guides</a> &rsaquo; Organic vs Conventional Chilli
