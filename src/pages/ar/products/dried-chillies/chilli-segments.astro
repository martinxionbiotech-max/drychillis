---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هي شرائح الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "شرائح الفلفل الحار هي فلفل مجفف مقطوع إلى قطع — أكبر من الرقائق — لتطبيقات الحرارة الفائقة. تتجاوز عادة 50,000 SHU من أصناف مثل جيشين وشياومي وتشيلي كينغ، وتُستخدم في الأطباق بأسلوب سيتشوان وزيت الفلفل حيث تهم الحرارة المرئية."
      }
    },
    {
      "@type": "Question",
      "name": "ما مدى حرارة شرائح الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "شرائح الفلفل الحار هي الشكل الأعلى حرارة — أكثر من 50,000 SHU. جيشين (50,000–70,000 SHU) وشياومي وتشيلي كينغ كلها تتجاوز 50,000 SHU، مانحةً الحرارة الفائقة التي يتطلبها مطبخ سيتشوان وزيت الفلفل."
      }
    },
    {
      "@type": "Question",
      "name": "فيمَ تُستخدم شرائح الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تُستخدم شرائح الفلفل الحار لمنتجات الحرارة الفائقة: أطباق بأسلوب سيتشوان وزيت الفلفل وقواعد الهوت بوت والتوابل حيث يُراد قطعة مرئية عالية الحرارة بدلًا من مسحوق ناعم."
      }
    }
  ]
};
---

<BaseLayout
  title="شرائح الفلفل الحار (50,000+ SHU) | Tenda Peppers"
  description="مصنع صيني لشرائح الفلفل الحار — قطع فائقة الحرارة تتجاوز 50,000 SHU من جيشين وشياومي وتشيلي كينغ لأطباق سيتشوان وزيت الفلفل. ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; شرائح الفلفل الحار
    </nav>
    <h1>شرائح الفلفل الحار (50,000+ SHU)</h1>
    <p class="lead">
      قطع فلفل مجفف فائقة الحرارة — أكثر من 50,000 SHU — مقطوعة من جيشين وشياومي وتشيلي كينغ،
      لأطباق بأسلوب سيتشوان وزيت الفلفل وقواعد الهوت بوت حيث الحرارة المرئية هي الهدف.
    </p>

    <h2 style="margin-top:32px;">ما هي شرائح الفلفل الحار؟</h2>
    <p>
      شرائح الفلفل الحار هي فلفل مجفف مقطوع إلى قطع — أكبر من الرقائق — لتطبيقات تحتاج فلفلًا
      مرئيًا عالي الحرارة بدلًا من مسحوق ناعم. تقع في قمة مقياس الحرارة (أكثر من 50,000 SHU)،
      ما يجعلها الشكل للحرارة الفائقة والطبخ بأسلوب سيتشوان.
    </p>
    <table>
      <thead>
        <tr><th>الصنف</th><th>الحرارة (SHU)</th><th>المنطقة</th><th>الأفضل لـ</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>جيشين</strong></td><td>50,000 – 70,000</td><td>قويتشو، هونان</td><td>حرارة فائقة، زيت الفلفل</td></tr>
        <tr><td><strong>شياومي</strong></td><td>50,000 – 70,000</td><td>يونان، قويتشو</td><td>قطع عالية الحرارة</td></tr>
        <tr><td><strong>تشيلي كينغ</strong></td><td>&gt;50,000</td><td>—</td><td>توابل فائقة الحرارة</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">فيمَ تُستخدم شرائح الفلفل الحار؟</h2>
    <ul>
      <li>أطباق بأسلوب سيتشوان والهوت بوت</li>
      <li>زيت الفلفل والزيوت المنقوعة</li>
      <li>خلطات توابل فائقة الحرارة</li>
      <li>عبوات حرارة للوجبات الخفيفة والنودلز الفوري</li>
    </ul>

    <h2 style="margin-top:32px;">كيف تحدد شرائح الفلفل الحار</h2>
    <p>
      ابدأ من نطاق SHU المستهدف ثم سمِّ الصنف. جيشين وشياومي هما الثنائي القياسي للحرارة الفائقة،
      عند 50,000–70,000 SHU. أكد حجم القطع والرطوبة (أقل من 13%) وما إذا كنت تحتاج قطعًا منزوعة
      البذور. الحرارة غير خطية، لذا النطاق الدقيق هو ما يحافظ على ثبات منتج فائق الحرارة من دفعة
      لأخرى.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكد نطاق SHU وحجم القطع والرطوبة الدقيقة عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما هي شرائح الفلفل الحار؟</h3>
      <p>شرائح الفلفل الحار هي فلفل مجفف مقطوع إلى قطع — أكبر من الرقائق — لتطبيقات الحرارة الفائقة. تتجاوز عادة 50,000 SHU من أصناف مثل جيشين وشياومي وتشيلي كينغ، وتُستخدم في الأطباق بأسلوب سيتشوان وزيت الفلفل حيث تهم الحرارة المرئية.</p>
    </div>
    <div class="faq-item">
      <h3>ما مدى حرارة شرائح الفلفل الحار؟</h3>
      <p>شرائح الفلفل الحار هي الشكل الأعلى حرارة — أكثر من 50,000 SHU. جيشين (50,000–70,000 SHU) وشياومي وتشيلي كينغ كلها تتجاوز 50,000 SHU، مانحةً الحرارة الفائقة التي يتطلبها مطبخ سيتشوان وزيت الفلفل.</p>
    </div>
    <div class="faq-item">
      <h3>فيمَ تُستخدم شرائح الفلفل الحار؟</h3>
      <p>تُستخدم شرائح الفلفل الحار لمنتجات الحرارة الفائقة: أطباق بأسلوب سيتشوان وزيت الفلفل وقواعد الهوت بوت والتوابل حيث يُراد قطعة مرئية عالية الحرارة بدلًا من مسحوق ناعم.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر للشرائح</a>
      <a class="cta cta-outline" href="/ar/heat-levels/extra-hot/" style="margin-left:8px;">الحرارة الفائقة ←</a>
    </div>
  </div>
</BaseLayout>
