---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما الأصناف الرئيسية للفلفل الصيني؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تمتد من الحلو إلى الفائق: فلفل شينجيانغ الحلو (أقل من 500 SHU)، وYidu red وWangdu (أقل من 10,000)، وشيان وجينتا وإرجينغتياو (10,000–20,000)، وسانينغ وزيدانتو وسبعة نجوم (20,000–50,000)، وجيشين وشياومي وتشيلي كينغ (أكثر من 50,000 SHU)."
      }
    },
    {
      "@type": "Question",
      "name": "أين يُزرع الفلفل في الصين؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تزرع الصين الفلفل في خمس مناطق: سهل الشمال (خنان وخبي وشاندونغ)، وحزام الحرارة العالية (هونان وقويتشو وسيتشوان وتشونغتشينغ)، وحزام اللون الشمالي الغربي (شينجيانغ وقانسو)، ومناطق التخصص (شانشي ويونان)، ومناطق المناخ البارد (منغوليا الداخلية وشانشي ولياونينغ وجيلين)."
      }
    },
    {
      "@type": "Question",
      "name": "لماذا يهم الصنف عند شراء الفلفل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الصنف يحدد الحرارة (SHU) واللون (ASTA) والنكهة، وهي تتفاوت بشكل مستقل. تسمية الصنف — لا طلب «مسحوق فلفل» عام — هي الفرق بين منتج ثابت ودفعة تتغير مع كل طلب."
      }
    }
  ]
};
---

<BaseLayout
  title="أصناف الفلفل الصيني: دليل الحرارة والمنطقة | Tenda Peppers"
  description="دليل أصناف الفلفل الصيني — من فلفل شينجيانغ الحلو إلى جيشين، مع نطاقات حرارة SHU ومناطق الزراعة وأفضل الاستخدامات. مركز المعرفة Tenda Peppers."
  ogType="article"
  author="Tenda Peppers Technical Team"
  datePublished="2026-09-01"
  dateModified="2026-09-01"
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/blog/">الأدلة</a> &rsaquo; أصناف الفلفل
    </nav>
    <h1>أصناف الفلفل الصيني: دليل الحرارة والمنطقة</h1>
    <p class="lead">
      يغطي الفلفل الصيني كامل طيف الحرارة تقريبًا — من فلفل شينجيانغ الحلو (أقل من 500 SHU) إلى
      جيشين الفائق (أكثر من 70,000 SHU). الصنف هو القرار الأول.
    </p>

    <h2 style="margin-top:32px;">طيف الحرارة في لمحة</h2>
    <table>
      <thead>
        <tr><th>النطاق</th><th>SHU</th><th>أصناف تمثيلية</th></tr>
      </thead>
      <tbody>
        <tr><td>حلو</td><td>&lt;500</td><td>فلفل شينجيانغ الحلو، Red Dragon 23</td></tr>
        <tr><td>حرارة منخفضة</td><td>&lt;10,000</td><td>Yidu red، Wangdu</td></tr>
        <tr><td>حرارة متوسطة</td><td>10,000–20,000</td><td>شيان، جينتا، إرجينغتياو</td></tr>
        <tr><td>حرارة عالية</td><td>20,000–50,000</td><td>سانينغ، زيدانتو، سبعة نجوم</td></tr>
        <tr><td>حرارة فائقة</td><td>&gt;50,000</td><td>جيشين، شياومي، تشيلي كينغ</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">مناطق الزراعة الخمس</h2>
    <p>
      المنطقة تحدد المناخ الذي يحدد الحرارة واللون. سهل الشمال يزرع فلفل العقدة المتجه للأعلى؛
      والشمال الغربي هو حزام اللون؛ وحزام الحرارة العالية يزرع الأصناف الحارة؛ ومناطق التخصص تضيف
      أنواعًا مميزة مثل Shaanxi 8819.
    </p>

    <h2 style="margin-top:32px;">لماذا الصنف هو القرار الأول</h2>
    <p>
      الحرارة واللون والنكهة يحددها الصنف ومناخ النضج — وتتفاوت بشكل مستقل. تسمية الصنف (أو نطاق
      SHU دقيق) هي ما يحوّل «مسحوق الفلفل» إلى منتج قابل للتكرار. انظر <a href="/ar/heat-levels/medium-heat/">صفحات مستوى الحرارة</a> أو
      <a href="https://docs.drychillis.com/ar/chilli-varieties/" target="_blank" rel="noopener">دليل الأصناف الكامل</a>.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما الأصناف الرئيسية للفلفل الصيني؟</h3>
      <p>تمتد من الحلو إلى الفائق: فلفل شينجيانغ الحلو (أقل من 500 SHU)، وYidu red وWangdu (أقل من 10,000)، وشيان وجينتا وإرجينغتياو (10,000–20,000)، وسانينغ وزيدانتو وسبعة نجوم (20,000–50,000)، وجيشين وشياومي وتشيلي كينغ (أكثر من 50,000 SHU).</p>
    </div>
    <div class="faq-item">
      <h3>أين يُزرع الفلفل في الصين؟</h3>
      <p>تزرع الصين الفلفل في خمس مناطق: سهل الشمال (خنان وخبي وشاندونغ)، وحزام الحرارة العالية (هونان وقويتشو وسيتشوان وتشونغتشينغ)، وحزام اللون الشمالي الغربي (شينجيانغ وقانسو)، ومناطق التخصص (شانشي ويونان)، ومناطق المناخ البارد (منغوليا الداخلية وشانشي ولياونينغ وجيلين).</p>
    </div>
    <div class="faq-item">
      <h3>لماذا يهم الصنف عند شراء الفلفل؟</h3>
      <p>الصنف يحدد الحرارة (SHU) واللون (ASTA) والنكهة، وهي تتفاوت بشكل مستقل. تسمية الصنف — لا طلب «مسحوق فلفل» عام — هي الفرق بين منتج ثابت ودفعة تتغير مع كل طلب.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/products/dried-chillies/">تصفح الفلفل المجفف</a>
      <a class="cta cta-outline" href="/ar/contact/" style="margin-left:8px;">اطلب عرض سعر</a>
    </div>
  </div>
</BaseLayout>
