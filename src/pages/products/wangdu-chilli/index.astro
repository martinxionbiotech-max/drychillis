---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BuyerSpec from "../../../components/BuyerSpec.astro";
import AtAGlance from "../../../components/AtAGlance.astro";
import { buildOffers, priceLine } from "../../../data/product-offers";

const productUrl = "https://drychillis.com/products/wangdu-chilli/";
const productOffers = buildOffers("wangdu-chilli", productUrl);

const buyerSpec = [
  { param: "Product form", value: "Confirm specification" },
  { param: "Variety", value: "Wangdu Chilli" },
  { param: "Heat level (SHU)", value: "<10,000" },
  { param: "ASTA colour value", value: "Confirm specification" },
  { param: "Mesh size", value: "Confirm specification" },
  { param: "Moisture", value: "<13%" },
  { param: "Processing", value: "Confirm specification" },
  { param: "Certifications", value: "ISO 9001 & HACCP standard — BRC, Halal, Kosher on request" },
];

const glanceFacts = [
  { label: "Heat level", value: "<10,000 SHU" },
  { label: "Region", value: "Shandong, Hebei" },
  { label: "Best for", value: "Low-heat paprika powder, colour" },
  { label: "Certifications", value: "ISO 9001 & HACCP" },
];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "https://drychillis.com/products/wangdu-chilli/#product",
  "name": "Wangdu Chilli",
  "description": "Wangdu pepper — low-heat chilli under 10,000 SHU from Shandong and Hebei, used with Yidu red for low-heat paprika powder and colour. China manufacturer, ISO 9001 & HACCP.",
  "image": ["https://drychillis.com/images/products/chilli-whole.jpg"],
  "url": "https://drychillis.com/products/wangdu-chilli/",
  "sku": "TENDA-WANGDU-CHILLI",
  "category": "Spices and Seasonings",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  ...(productOffers ? { "offers": productOffers } : {}),
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Heat Level (SHU)", "value": "<10,000", "unitText": "SHU" },
    { "@type": "PropertyValue", "name": "Region", "value": "Shandong, Hebei" },
    { "@type": "PropertyValue", "name": "Best For", "value": "Low-heat paprika powder, colour" }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Wangdu chilli?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wangdu is a low-heat chilli under 10,000 SHU from Shandong and Hebei, used with Yidu red for low-heat paprika powder and natural red colour."
      }
    },
    {
      "@type": "Question",
      "name": "How hot is Wangdu pepper?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wangdu is low heat — under 10,000 SHU, at least 5 times milder than the medium band (Xian and Jinta) and far below the extra-hot varieties. It is a colour-first variety."
      }
    },
    {
      "@type": "Question",
      "name": "What is Wangdu pepper used for?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wangdu is used with Yidu red for low-heat paprika powder and natural colour. Specify the variety and your ASTA colour target — colour and heat are independent numbers."
      }
    }
  ]
};
---

<BaseLayout
  title="Wangdu Chilli — Low-Heat Colour Chilli | Tenda Peppers"
  description="Wangdu pepper — low-heat chilli under 10,000 SHU from Shandong and Hebei, used with Yidu red for low-heat paprika powder and colour. China manufacturer, ISO 9001 & HACCP."
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/">Home</a> &rsaquo; <a href="/products/dried-chillies/">Dried Chillies</a> &rsaquo; Wangdu
    </nav>
    <h1>Wangdu Chilli</h1>
    <p class="lead">
      A low-heat chilli under 10,000 SHU from Shandong and Hebei — used with Yidu red for low-heat paprika powder and natural colour.
    </p>
    <div class="takeaways">
      <strong>Short answer:</strong> Wangdu is a low-heat chilli (under 10,000 SHU) from Shandong and Hebei, used with Yidu red for low-heat paprika powder and colour. It is a colour-first variety — bought on ASTA, not on burn.
    </div>
    <AtAGlance facts={glanceFacts} />
    <div class="product-media">
      <img src="/images/products/chilli-whole.jpg" alt="Whole dried chillies" width="1400" height="1050" loading="eager" />
    </div>
    <p class="product-price" style="font-weight:600;color:#8a1c1c;margin:10px 0 0;">Price confirmed on quotation — MOQ, packing and specification agreed before order.</p>

    <h2 style="margin-top:32px;">What is Wangdu chilli?</h2>
    <p>
      Wangdu is a low-heat chilli under 10,000 SHU from Shandong and Hebei. On the <a href="/guides/chinese-chilli-varieties-grades/">varieties guide</a> it sits in the low-heat band with Yidu red — the band milled into low-heat paprika powder where colour does the work and heat stays in the background.
    </p>
    <table>
      <thead>
        <tr><th>Property</th><th>Detail</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>Heat (SHU)</strong></td><td><10,000</td></tr>
        <tr><td><strong>Region</strong></td><td>Shandong, Hebei</td></tr>
        <tr><td><strong>Best for</strong></td><td>Low-heat paprika powder, colour</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">What is Wangdu pepper used for?</h2>
    <ul>
      <li>Low-heat paprika powder</li>
      <li>Natural red colour</li>
      <li>Colour-focused blends</li>
    </ul>

    <h2 style="margin-top:32px;">Wangdu vs Yidu red</h2>
    <p>
      Yidu red and Wangdu are the low-heat pair under 10,000 SHU. Both feed the low-heat paprika grade — colour-first powder where the SHU stays under 10,000. Specify the variety and your ASTA target: colour and heat are independent numbers.
    </p>

    <h2 style="margin-top:32px;">Wangdu Chilli by the numbers</h2>
    <p>
      Wangdu runs under 10,000 SHU — at least 5 times milder than the medium band (Xian, Jinta at 10,000–20,000) and 100+ times milder than Chilli King (over 50,000). It is bought for colour, not heat.
    </p>
    <p class="data-note">
      Heat values are representative per variety. Confirm your exact SHU window, form and mesh when
      you inquire.
    </p>

    <BuyerSpec rows={buyerSpec} />

        <h2 style="margin-top:32px;">In the same under 10,000 SHU band</h2>
    <p>
      Other varieties in this band: <a href="/products/yidu-chilli/">Yidu red</a>, <a href="/products/paprika-powder/">Paprika Powder</a>.
    </p>

<h2 style="margin-top:32px;">Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is Wangdu chilli?</h3>
      <p>Wangdu is a low-heat chilli under 10,000 SHU from Shandong and Hebei, used with Yidu red for low-heat paprika powder and natural red colour.</p>
    </div>
    <div class="faq-item">
      <h3>How hot is Wangdu pepper?</h3>
      <p>Wangdu is low heat — under 10,000 SHU, at least 5 times milder than the medium band (Xian and Jinta) and far below the extra-hot varieties. It is a colour-first variety.</p>
    </div>
    <div class="faq-item">
      <h3>What is Wangdu pepper used for?</h3>
      <p>Wangdu is used with Yidu red for low-heat paprika powder and natural colour. Specify the variety and your ASTA colour target — colour and heat are independent numbers.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/contact/">Request Wangdu Quotation</a>
      <a class="cta cta-outline" href="/products/dried-chillies/" style="margin-left:8px;">Dried Chillies →</a>
    </div>
  </div>
</BaseLayout>
