---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildOffers, priceLine } from "../../../data/product-offers";

const productUrl = "https://drychillis.com/ru/products/yidu-chilli/";
const productOffers = buildOffers("yidu-chilli", productUrl);

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "https://drychillis.com/ru/products/yidu-chilli/#product",
  "name": "Перец Иду Ред (益都红)",
  "description": "Иду Ред (益都红) — сладкий перец с толстой мякотью и низкой остротой из Шаньдуна и Синьцзяна для паприки и натурального красного красителя.",
  "image": ["https://drychillis.com/images/products/chilli-whole.jpg"],
  "url": "https://drychillis.com/ru/products/yidu-chilli/",
  "sku": "TENDA-YIDU-RED-CHILLI",
  "category": "Специи и приправы",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  ...(productOffers ? { "offers": productOffers } : {}),
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Острота (SHU)", "value": "менее 1 000 (сладкий) – менее 10 000" },
    { "@type": "PropertyValue", "name": "Тип плода", "value": "Толстая мякоть, высокий выход цвета" },
    { "@type": "PropertyValue", "name": "Регион", "value": "Шаньдун (Иду/Цинчжоу) и Синьцзян" },
    { "@type": "PropertyValue", "name": "Лучше всего для", "value": "Паприка, натуральный краситель, олеорезин (E160c)" }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Что такое перец Иду Ред?",
      "acceptedAnswer": { "@type": "Answer", "text": "Иду Ред (益都红) — сладкий перец с толстой мякотью и низкой остротой из Шаньдуна и Синьцзяна, выращиваемый как сырьё для паприки ради выхода цвета (ASTA): острота ниже 10 000 SHU и обычно близка к сладкой." } },
    { "@type": "Question", "name": "Насколько остр Иду Ред?",
      "acceptedAnswer": { "@type": "Answer", "text": "Практически не острый: менее 1 000 SHU в сладком диапазоне и никогда близко к потолку 10 000 SHU даже в более острых селекциях. Его покупают ради цвета, а не остроты." } },
    { "@type": "Question", "name": "Для чего используют Иду Ред?",
      "acceptedAnswer": { "@type": "Answer", "text": "Его мелют в паприку низкой остроты, натуральный красный краситель, смеси специй и для экстракции олеорезина паприки (E160c). Толстая мякоть даёт высокий выход цвета на килограмм." } }
  ]
};
---

<BaseLayout
  title="Перец Иду Ред (益都红) — сладкий перец для цвета | Tenda Peppers"
  description="Иду Ред (益都红) — сладкий перец с толстой мякотью и низкой остротой из Шаньдуна и Синьцзяна для паприки и натурального красителя. Китайский производитель, ISO 9001 и HACCP."
  lang="ru"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ru/">Главная</a> &rsaquo; <a href="/ru/products/paprika-powder/">Паприка</a> &rsaquo; Иду Ред
    </nav>
    <h1>Перец Иду Ред (益都红)</h1>
    <p class="lead">
      Сладкий перец с толстой мякотью, выращиваемый ради цвета — его мелют в паприку низкой остроты
      для натурального красного красителя, смесей специй и экстракции олеорезина паприки (E160c).
    </p>
    <p class="product-price" style="font-weight:600;color:#8a1c1c;margin:10px 0 0;">{priceLine("yidu-chilli", "ru")}</p>

    <h2 style="margin-top:32px;">Что такое перец Иду Ред?</h2>
    <p>
      Иду Ред — перец с низкой остротой и толстой мякотью, традиционно связанный с районом Иду
      (Цинчжоу) в Шаньдуне и теперь также выращиваемый в «цветном» поясе Синьцзяна. Это сырьё для
      паприки: его выращивают и мелют ради красного цвета, а не ради остроты. По шкале остроты он в
      самом низу — менее 10 000 SHU, а в сладком рабочем диапазоне менее 1 000 SHU.
    </p>
    <table>
      <thead><tr><th>Свойство</th><th>Подробности</th></tr></thead>
      <tbody>
        <tr><td><strong>Острота (SHU)</strong></td><td>менее 1 000 (сладкий) – менее 10 000</td></tr>
        <tr><td><strong>Тип плода</strong></td><td>Толстая мякоть, высокий выход цвета</td></tr>
        <tr><td><strong>Регион</strong></td><td>Шаньдун (Иду/Цинчжоу) и Синьцзян</td></tr>
        <tr><td><strong>Лучше всего для</strong></td><td>Паприка, натуральный краситель, олеорезин (E160c)</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      Единая опубликованная величина ASTA для свежего перца не фиксирована: значение готового порошка
      зависит от селекции, удаления семян и помола. Подтвердите целевой диапазон ASTA с нами, а не
      предполагайте число.
    </p>

    <h2 style="margin-top:32px;">Для чего используют Иду Ред?</h2>
    <ul>
      <li>Паприка низкой остроты</li>
      <li>Натуральный красный краситель в приправах и переработанных продуктах</li>
      <li>Смеси специй и маринады, где важен цвет, а острота должна остаться низкой</li>
      <li>Экстракция олеорезина паприки (краситель E160c)</li>
    </ul>

    <h2 style="margin-top:32px;">Иду Ред, сладкий перец Синьцзяна и Ванду</h2>
    <table>
      <thead><tr><th>Сорт</th><th>Острота</th><th>Роль цвета</th><th>Лучше всего для</th></tr></thead>
      <tbody>
        <tr><td><strong>Сладкий перец Синьцзяна</strong></td><td>менее 500 SHU</td><td>Эталон цвета, почти нулевая острота</td><td>Чистый цвет, сладкая паприка</td></tr>
        <tr><td><strong>Иду Ред</strong></td><td>менее 1 000 (до менее 10 000)</td><td>Высокий цвет, толстая мякоть, полное тело</td><td>Паприка низкой остроты с ароматом</td></tr>
        <tr><td><strong>Ванду</strong></td><td>менее 10 000</td><td>Цвет с мягкой теплотой</td><td>Смеси паприки низкой остроты</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">Что упускают большинство руководств</h2>
    <p>
      Большинство руководств называют Иду Ред «сладким перцем» и на этом останавливаются. Что они
      упускают — экономику: Иду Ред покупают ради <strong>выхода цвета на килограмм</strong>, а
      поскольку мякоть толстая, этот выход может различаться вдвое между классами и селекциями. Две
      партии «Иду Ред» могут выглядеть одинаково красными и резко различаться тем, насколько сильно
      данная масса окрасит ваш продукт. Поэтому правильный заказ задаёт целевое значение ASTA и меш.
    </p>

    <h2 style="margin-top:32px;">Как задать спецификацию Иду Ред</h2>
    <p>
      Укажите сорт, затем готовую форму (паприка — стандарт), целевое значение цвета ASTA, меш
      (стандартно 60–80) и влажность (ниже 13%). Острота на этом конце шкалы не вопрос — направьте
      усилия спецификации на цвет и размер частиц.
    </p>

    <h2 style="margin-top:32px;">Часто задаваемые вопросы</h2>
    <div class="faq-item">
      <h3>Что такое перец Иду Ред?</h3>
      <p>Иду Ред (益都红) — сладкий перец с толстой мякотью и низкой остротой из Шаньдуна и Синьцзяна, выращиваемый как сырьё для паприки ради выхода цвета (ASTA).</p>
    </div>
    <div class="faq-item">
      <h3>Насколько остр Иду Ред?</h3>
      <p>Практически не острый: менее 1 000 SHU в сладком диапазоне и никогда близко к 10 000 SHU. Его покупают ради цвета.</p>
    </div>
    <div class="faq-item">
      <h3>Для чего используют Иду Ред?</h3>
      <p>Для паприки низкой остроты, натурального красного красителя, смесей специй и экстракции олеорезина (E160c).</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ru/contact/">Запросить цену на Иду Ред</a>
      <a class="cta cta-outline" href="/ru/products/paprika-powder/" style="margin-left:8px;">Паприка →</a>
    </div>
  </div>
</BaseLayout>
