---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "فلفل حار مجفف (كامل، رقائق، مسحوق، قطع)",
  "description": "مصنّع صيني للفلفل الحار المجفف — فلفل حار مجفف كامل، رقائق فلفل حار، مسحوق فلفل حار وقطع فلفل حار بمستويات حرارة من 10,000 إلى 50,000+ وحدة سكوفيل.",
  "image": [
    "https://drychillis.com/images/products/chilli-whole.jpg",
    "https://drychillis.com/images/products/chilli-flakes.jpg",
    "https://drychillis.com/images/products/chilli-powder.jpg",
    "https://drychillis.com/images/products/chilli-segments.jpg",
  ],
  "url": "https://drychillis.com/ar/products/dried-chillies/",
  "sku": "TENDA-DRIED-CHILLIES",
  "category": "Spices and Seasonings",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Heat Level (SHU)", "value": "10,000 – 50,000+" },
    { "@type": "PropertyValue", "name": "Product Forms", "value": "Whole, flakes, powder, segments" },
    { "@type": "PropertyValue", "name": "Moisture", "value": "<13%" },
    { "@type": "PropertyValue", "name": "Mesh", "value": "60–80 mesh (powder)" }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما منتجات الفلفل الحار المجفف التي توردونها؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نورد فلفلًا حارًا مجففًا كاملًا، ورقائق فلفل حار (فلفل مطحون)، ومسحوق فلفل حار وقطع فلفل حار، تغطي مستويات حرارة من 10,000 إلى 50,000+ وحدة سكوفيل في أصناف الفلفل الصينية."
      }
    },
    {
      "@type": "Question",
      "name": "ما مستوى الحرارة الذي أحتاجه؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الحرارة المتوسطة (10,000–20,000 وحدة سكوفيل) تناسب التوابل العامة؛ الحرارة العالية (20,000–50,000 وحدة سكوفيل) تناسب الصلصات الحارة وتتبيل الوجبات الخفيفة؛ والحرارة القصوى (أكثر من 50,000 وحدة سكوفيل) للتطبيقات شديدة الحرارة. أخبرنا بـSHU المستهدف ونضبط الصنف."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكنكم توريد فلفل حار مجفف كامل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم. نورد فلفلًا حارًا مجففًا كاملًا بأصناف مثل فلفل الفانوس وفلفل جينتا وفلفل مواجه السماء وفلفل شياومي، مع تصنيف الحجم والرطوبة وفقًا للمواصفات."
      }
    },
    {
      "@type": "Question",
      "name": "كيف يُتحكم في اللون والحرارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تُضبط الحرارة واللون عند المصدر عبر اختيار الصنف والتحكم في الدرجة، ثم تُتحقق داخليًا. تمر كل دفعة بنزع البذور والترشيح المغناطيسي والفحص بالأشعة السينية والفرز بالألوان."
      }
    }
  ]
};
---

<BaseLayout
  lang="ar"
  title="مصنّع صيني للفلفل الحار المجفف | Tenda Peppers"
  description="مصنّع صيني للفلفل الحار المجفف — فلفل حار مجفف كامل، رقائق فلفل حار، مسحوق فلفل حار وقطع فلفل حار من 10,000 إلى 50,000+ وحدة سكوفيل. ISO 9001 وHACCP، نورد إلى أوروبا والشرق الأوسط وأمريكا الشمالية."
  ogImage="/images/og-chillies.jpg"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; الفلفل الحار المجفف
    </nav>
    <h1>الفلفل الحار المجفف</h1>
    <p class="lead">
      فلفل حار مجفف كامل ورقائق ومسحوق وقطع — منتجات فلفل مركّزة على الحرارة، مطحونة من أصناف
      صينية في كامل طيف الحرارة، للصلصات والوجبات الخفيفة والتوابل.
    </p>

        <div class="product-media">
      <img src="/images/products/chilli-whole.jpg" alt="Whole dried chillies" width="1400" height="1050" loading="eager" />
    </div>

<h2 style="margin-top:32px;">مجموعة الفلفل الحار المجفف لدينا</h2>
    <table>
      <thead>
        <tr><th>شكل المنتج</th><th>الحرارة (SHU)</th><th>الأصناف</th><th>الأنسب لـ</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>فلفل حار مجفف كامل</strong></td>
          <td>10,000 – 50,000+</td>
          <td>الفانوس، جينتا، مواجه السماء، شياومي، زيدانتو</td>
          <td>خدمات الطعام، القدر الحار، الفلفل المرئي</td>
        </tr>
        <tr>
          <td><strong>رقائق فلفل حار (مطحون)</strong></td>
          <td>10,000 – 20,000</td>
          <td>فلفل شيان، جينتا، إرجينغتياو</td>
          <td>طبقة البيتزا، خلطات التوابل، الوجبات الخفيفة</td>
        </tr>
        <tr>
          <td><strong>مسحوق فلفل حار</strong></td>
          <td>20,000 – 50,000</td>
          <td>سانيينغ، زيدانتو، الجيل الجديد، سيفن ستار</td>
          <td>الصلصات الحارة، التوابل، الأغذية الصناعية</td>
        </tr>
        <tr>
          <td><strong>قطع فلفل حار</strong></td>
          <td>&gt;50,000</td>
          <td>جيكسين، شياومي، ملك الفلفل، شوان شوان</td>
          <td>حرارة قصوى، أطباق على طراز سيتشوان</td>
        </tr>
      </tbody>
    </table>

    <div class="product-gallery">
      <figure><img src="/images/products/chilli-whole.jpg" alt="Whole dried chillies" loading="lazy" /><figcaption>Whole dried chillies</figcaption></figure>
      <figure><img src="/images/products/chilli-flakes.jpg" alt="Chilli flakes" loading="lazy" /><figcaption>Chilli flakes</figcaption></figure>
      <figure><img src="/images/products/chilli-powder.jpg" alt="Chilli powder" loading="lazy" /><figcaption>Chilli powder</figcaption></figure>
      <figure><img src="/images/products/chilli-segments.jpg" alt="Chilli segments" loading="lazy" /><figcaption>Chilli segments</figcaption></figure>
    </div>


    <p class="data-note">
      مستويات الحرارة تمثيلية لأصناف الفلفل الصينية. أكّد SHU المستهدف والتطبيق عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">المواصفات</h2>
    <table>
      <thead>
        <tr><th>المعيار</th><th>النطاق النموذجي</th></tr>
      </thead>
      <tbody>
        <tr><td>مستوى الحرارة (SHU)</td><td>10,000 – 50,000+</td></tr>
        <tr><td>الرطوبة</td><td>&lt;13%</td></tr>
        <tr><td>الشبكة (المسحوق)</td><td>قابلة للتعديل حسب المتطلبات</td></tr>
        <tr><td>المعالجة</td><td>نزع البذور، الترشيح المغناطيسي، الفحص بالأشعة السينية، الفرز بالألوان</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">التطبيقات</h2>
    <ul>
      <li>الصلصات الحارة وزيت الفلفل الحار</li>
      <li>تتبيل الوجبات الخفيفة والنودلز سريعة التحضير</li>
      <li>خلطات التوابل والبهارات</li>
      <li>خدمات الطعام والقدر الحار</li>
      <li>اللحوم المصنعة والتتبيلات</li>
    </ul>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما منتجات الفلفل الحار المجفف التي توردونها؟</h3>
      <p>نورد فلفلًا حارًا مجففًا كاملًا، ورقائق فلفل حار (فلفل مطحون)، ومسحوق فلفل حار وقطع فلفل حار، تغطي مستويات حرارة من 10,000 إلى 50,000+ وحدة سكوفيل.</p>
    </div>
    <div class="faq-item">
      <h3>ما مستوى الحرارة الذي أحتاجه؟</h3>
      <p>الحرارة المتوسطة تناسب التوابل العامة؛ الحرارة العالية تناسب الصلصات الحارة وتتبيل الوجبات الخفيفة؛ والحرارة القصوى للتطبيقات شديدة الحرارة. أخبرنا بـSHU المستهدف ونضبط الصنف.</p>
    </div>
    <div class="faq-item">
      <h3>هل يمكنكم توريد فلفل حار مجفف كامل؟</h3>
      <p>نعم. نورد فلفلًا حارًا مجففًا كاملًا بأصناف مثل فلفل الفانوس وفلفل جينتا وفلفل مواجه السماء وفلفل شياومي، مع تصنيف الحجم والرطوبة وفقًا للمواصفات.</p>
    </div>
    <div class="faq-item">
      <h3>كيف يُتحكم في اللون والحرارة؟</h3>
      <p>تُضبط الحرارة واللون عند المصدر عبر اختيار الصنف والتحكم في الدرجة، ثم تُتحقق داخليًا. تمر كل دفعة بنزع البذور والترشيح المغناطيسي والفحص بالأشعة السينية والفرز بالألوان.</p>
    </div>

    <div style="margin-top:32px;padding:20px;background:#faf5f2;border-radius:8px;">
      <h2 style="margin-top:0;">وثائق تقنية ذات صلة</h2>
      <ul style="margin-bottom:0;">
        <li><a href="https://docs.drychillis.com/buying-guide/" target="_blank" rel="noopener">دليل شراء الفلفل الحلو والفلفل الحار</a></li>
        <li><a href="https://docs.drychillis.com/chilli-varieties/" target="_blank" rel="noopener">أصناف الفلفل ودرجاته</a></li>
        <li><a href="https://docs.drychillis.com/heat-perception/" target="_blank" rel="noopener">إدراك الحرارة والذوق</a></li>
      </ul>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">طلب عرض سعر الفلفل الحار</a>
    </div>
  </div>
</BaseLayout>
