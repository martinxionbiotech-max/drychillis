---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما الذي يُعد فلفلًا عالي الحرارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الفلفل عالي الحرارة هو 20,000–50,000 وحدة سكوفيل (SHU) — حرارة قوية ومستمرة للصلصات الحارة وتوابل الوجبات الخفيفة والأغذية الصناعية. الأصناف التمثيلية: سانينغ (تيانينغ) وزيدانتو وسبعة نجوم ونيو جينيريشن."
      }
    },
    {
      "@type": "Question",
      "name": "فيمَ يُستخدم الفلفل عالي الحرارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "هو أساس الصلصات الحارة وزيت الفلفل وتوابل الوجبات الخفيفة والنودلز الفوري والتطبيقات الصناعية التي تحتاج حرارة حقيقية وثابتة."
      }
    },
    {
      "@type": "Question",
      "name": "أي صنف أختار للصلصة الحارة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "سانينغ (تيانينغ) وزيدانتو هما الصنفان الكلاسيكيان للصلصة الحارة (20,000–50,000 SHU)؛ وسبعة نجوم شائع في الوجبات الخفيفة وقواعد الهوت بوت. حدد الصنف ونطاق SHU دقيقًا لثبات بين الدفعات."
      }
    }
  ]
};
---

<BaseLayout
  title="فلفل عالي الحرارة (20,000–50,000 SHU) | Tenda Peppers"
  description="فلفل عالي الحرارة (20,000–50,000 SHU) — سانينغ وزيدانتو وسبعة نجوم للصلصة الحارة وزيت الفلفل والوجبات الخفيفة. مُصنّع في الصين، ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; حرارة عالية
    </nav>
    <h1>فلفل عالي الحرارة (20,000–50,000 SHU)</h1>
    <p class="lead">
      حرارة قوية ومستمرة — نطاق 20,000–50,000 SHU يحرّك الصلصات الحارة وزيت الفلفل وتوابل الوجبات
      الخفيفة، على أصناف مثل سانينغ (تيانينغ) وزيدانتو وسبعة نجوم.
    </p>

    <h2 style="margin-top:32px;">ما الذي يُعد فلفلًا عالي الحرارة؟</h2>
    <p>
      الحرارة العالية هي النطاق الذي يتوقف فيه الفلفل عن كونه خلفية ويصبح نقطة المنتج. تمتد من
      20,000–50,000 SHU — حار بما يكفي لتطبيقات مخصصة، لكنه يبقى قابلًا للتحكم في الخلطة عند
      الجرعات بالوزن.
    </p>
    <table>
      <thead>
        <tr><th>الصنف</th><th>الحرارة (SHU)</th><th>المنطقة</th><th>الأنسب لـ</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>سانينغ / تيانينغ</strong></td><td>20,000 – 50,000</td><td>خنان، خبي</td><td>صلصة حارة، زيت الفلفل</td></tr>
        <tr><td><strong>زيدانتو (الرصاصة)</strong></td><td>20,000 – 50,000</td><td>شاندونغ، آنهوي</td><td>صلصة حارة، الصناعة</td></tr>
        <tr><td><strong>سبعة نجوم</strong></td><td>20,000 – 50,000</td><td>شاندونغ، شانشي</td><td>وجبات خفيفة، هوت بوت</td></tr>
        <tr><td><strong>نيو جينيريشن</strong></td><td>20,000 – 50,000</td><td>شاندونغ</td><td>توابل، مسحوق</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">فيمَ يُستخدم الفلفل عالي الحرارة؟</h2>
    <ul>
      <li>الصلصات الحارة وزيت الفلفل</li>
      <li>توابل الوجبات الخفيفة والنودلز الفوري</li>
      <li>قواعد الهوت بوت وطريقة سيتشوان</li>
      <li>الأغذية الصناعية والتوابل المصنّعة</li>
    </ul>

    <h2 style="margin-top:32px;">كيف تحدد الفلفل عالي الحرارة</h2>
    <p>
      ابدأ من نطاق SHU المستهدف وسمِّ الصنف. سانينغ وزيدانتو هما الثنائي الكلاسيكي للصلصة الحارة؛
      وسبعة نجوم للوجبات الخفيفة والهوت بوت. أكّد الشكل والرطوبة والميش — الحرارة غير خطية، لذا
      فإن النطاق الدقيق هو ما يحافظ على ثبات صلصتك من دفعة لأخرى.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكّد نطاق SHU الدقيق والشكل عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما الذي يُعد فلفلًا عالي الحرارة؟</h3>
      <p>الفلفل عالي الحرارة هو 20,000–50,000 وحدة سكوفيل (SHU) — حرارة قوية ومستمرة للصلصات الحارة وتوابل الوجبات الخفيفة والأغذية الصناعية. الأصناف التمثيلية: سانينغ (تيانينغ) وزيدانتو وسبعة نجوم ونيو جينيريشن.</p>
    </div>
    <div class="faq-item">
      <h3>فيمَ يُستخدم الفلفل عالي الحرارة؟</h3>
      <p>هو أساس الصلصات الحارة وزيت الفلفل وتوابل الوجبات الخفيفة والنودلز الفوري والتطبيقات الصناعية التي تحتاج حرارة حقيقية وثابتة.</p>
    </div>
    <div class="faq-item">
      <h3>أي صنف أختار للصلصة الحارة؟</h3>
      <p>سانينغ (تيانينغ) وزيدانتو هما الصنفان الكلاسيكيان للصلصة الحارة (20,000–50,000 SHU)؛ وسبعة نجوم شائع في الوجبات الخفيفة وقواعد الهوت بوت. حدد الصنف ونطاق SHU دقيقًا لثبات بين الدفعات.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر للحرارة العالية</a>
      <a class="cta cta-outline" href="/ar/heat-levels/extra-hot/" style="margin-left:8px;">حرارة فائقة ←</a>
    </div>
  </div>
</BaseLayout>
