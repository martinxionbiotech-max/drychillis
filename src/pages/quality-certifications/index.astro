---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AtAGlance from "../../components/AtAGlance.astro";

const qualityJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Quality & Certifications",
  "url": "https://drychillis.com/quality-certifications/",
  "mainEntity": { "@id": "https://drychillis.com/#organization" }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What certifications does Tenda Peppers hold?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tenda Peppers is certified to ISO 9001:2015 (quality management) and HACCP (food safety). Production runs under a zero-defect, zero-tolerance food safety policy with 24-hour surveillance."
      }
    },
    {
      "@type": "Question",
      "name": "How do you remove foreign objects from chilli?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every batch passes de-seeding, magnet filtration (ferrous metal), X-ray inspection (dense objects) and colour sorting (optical grading of defects). This multi-stage screening runs alongside moisture control. The layers deliberately overlap — no single machine is trusted alone, so a metallic fragment that slips past the magnet is still caught by X-ray."
      }
    },
    {
      "@type": "Question",
      "name": "Can I get certificates and batch documentation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Certificates and batch documentation are available on request, and every shipment is traceable to its growing base under the ISO 9001 / HACCP system."
      }
    },
    {
      "@type": "Question",
      "name": "How is batch-to-batch consistency ensured?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Consistency comes from variety and grade control at source, raw-material traceability from 12 controlled growing bases, and laboratory re-verification before production. This matters because heat, colour and flavour vary independently — without source control, two batches of the same nominal chilli can arrive visibly different."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between your quality controls and what I must specify?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Three layers apply: our confirmed production controls (magnet filtration, X-ray, colour sorting, moisture control under ISO 9001 and HACCP), regulatory limits set by your target market (mycotoxins, pesticide MRLs, Salmonella, heavy metals), and buyer-specified testing (third-party testing, market-specific MRL screens, microbial-reduction step, lot-specific COA and phytosanitary where required)."
      }
    }
  ]
};
const glanceFacts = [
    { label: "Quality system", value: "ISO 9001 & HACCP" },
    { label: "Production flow", value: "8-step, gated" },
    { label: "Foreign-object control", value: "Layered: magnet filtration, X-ray inspection, colour sorting" },
    { label: "Food safety policy", value: "Zero-defect, zero-tolerance" },
];

---

<BaseLayout
  title="Quality & Certifications | Tenda Peppers"
  description="Tenda Peppers quality control — ISO 9001 and HACCP certified, with X-ray inspection, colour sorting, metal detection and an 8-step process."
  jsonLd={[qualityJsonLd, faqJsonLd]}
>
  <div class="container section">
    <h1>Quality &amp; Certifications</h1>
    <p class="lead">
      Paprika and chilli quality is controlled at source and verified at every step — under an
      ISO 9001 and HACCP system with a zero-defect, zero-tolerance food safety policy.
    </p>

    <div class="takeaways">
      <strong>Short answer:</strong> Tenda Peppers runs an 8-step, gated production flow under ISO 9001 and HACCP. Foreign-object control is deliberately overlapping — magnet filtration, X-ray inspection and colour sorting are layered because no single machine is trusted alone.
    </div>

    <AtAGlance facts={glanceFacts} />

        <div class="product-gallery">
      <figure><img src="/images/quality-inspection.jpg" alt="X-ray inspection and colour sorting line" loading="lazy" /><figcaption>X-ray &amp; colour sorting</figcaption></figure>
      <figure><img src="/images/factory-line.jpg" alt="Tenda Peppers production line" loading="lazy" /><figcaption>Production line</figcaption></figure>
    </div>

    <p class="data-note" style="margin-top:10px;">Published by Tenda Peppers — Leling Tenda Chili Products Co., Ltd. (founded 2010, ISO 9001 & HACCP certified). Last reviewed 2026-09-01.</p>

<h2 style="margin-top:32px;">Certifications</h2>
    <table>
      <thead>
        <tr><th>Certification</th><th>Scope</th><th>Status</th></tr>
      </thead>
      <tbody>
        <tr><td>ISO 9001:2015</td><td>Quality management system</td><td>✅ Certified</td></tr>
        <tr><td>HACCP</td><td>Food safety management</td><td>✅ Certified</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      Certificates available on request. Third-party testing available at buyer's request.
    </p>

    <h2 style="margin-top:32px;">The 8-Step Production Process</h2>
    <p>
      Every batch moves through eight gated stages, each with a defined control point. This
      traceable flow — from raw material to finished goods — is what turns a written specification
      into a consistent product.
    </p>
    <table>
      <thead>
        <tr><th>Step</th><th>Stage</th><th>Control</th></tr>
      </thead>
      <tbody>
        <tr><td>1</td><td>Raw material sourcing</td><td>Approved supplier audit, laboratory re-verification</td></tr>
        <tr><td>2</td><td>Pre-processing</td><td>De-seeding, cleaning</td></tr>
        <tr><td>3</td><td>Grading</td><td>Size, colour, moisture classification</td></tr>
        <tr><td>4</td><td>Storage</td><td>Low-temperature warehouse</td></tr>
        <tr><td>5</td><td>Processing</td><td>Magnet filtration, metal detection</td></tr>
        <tr><td>6</td><td>Colour sorting &amp; X-ray</td><td>Foreign-object removal, colour grading</td></tr>
        <tr><td>7</td><td>Packaging</td><td>Sealed, specification-labelled</td></tr>
        <tr><td>8</td><td>Finished goods</td><td>Final inspection before release</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">Foreign-Object Control</h2>
    <p>
      Foreign-object removal is a multi-stage, overlapping process — no single machine is trusted
      alone:
    </p>
    <ul>
      <li><strong>Magnet filtration</strong> — removes ferrous metal fragments</li>
      <li><strong>X-ray inspection</strong> — detects dense foreign objects magnet filtration misses</li>
      <li><strong>Colour sorting</strong> — optical grading removes off-colour and defective pieces</li>
      <li><strong>De-seeding</strong> — removes seeds and attached plant matter</li>
    </ul>

    <h2 style="margin-top:32px;">The Food-Safety Control Chain</h2>
    <p>
      Food safety here is not a single checkpoint but a chain of four gates that must all hold
      before a batch ships:
    </p>
    <ul>
      <li><strong>Raw-material safety</strong> — approved suppliers, laboratory re-verification before production</li>
      <li><strong>Production and processing safety</strong> — de-seeding, magnet filtration, X-ray inspection, colour sorting</li>
      <li><strong>Testing and inspection before release</strong> — every batch checked against specification</li>
      <li><strong>System certification</strong> — ISO 9001 and HACCP, externally audited</li>
    </ul>

    <h2 style="margin-top:32px;">Three Layers of Control: What We Control, What the Law Sets, What You Specify</h2>
    <p>
      Food-safety requirements come from three different sources — and a serious programme
      separates them rather than blending them into one vague promise:
    </p>
    <table>
      <thead>
        <tr><th>Layer</th><th>Who sets it</th><th>What it covers</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>1. Our confirmed controls</strong></td>
          <td>Tenda Peppers production line</td>
          <td>8-step gated flow; de-seeding; magnet filtration (ferrous metal); X-ray inspection (dense objects); colour sorting (optical defect grading); moisture control; 24-hour surveillance; ISO 9001 &amp; HACCP system</td>
        </tr>
        <tr>
          <td><strong>2. Regulatory limits</strong></td>
          <td>Your target market's law</td>
          <td>Aflatoxin and ochratoxin limits (e.g. EU Regulation 1881/2006); pesticide MRL lists with the EU dehydration factor for dried product; <em>Salmonella</em> absence; heavy-metal limits (lead, cadmium, arsenic). Limits differ by market — specify the destination.</td>
        </tr>
        <tr>
          <td><strong>3. Buyer-specified testing</strong></td>
          <td>You, in the specification</td>
          <td>Third-party testing at your request; screening against your market's MRL list; a microbial-reduction step (steam sterilisation, or irradiation where permitted) where your spec requires it; lot-specific COA, phytosanitary certificate where required, and market-specific certificates.</td>
        </tr>
      </tbody>
    </table>
    <p class="data-note">
      Regulatory values are the European Union's published limits as cited in our
      <a href="/guides/food-safety-quality/">food safety &amp; quality guide</a> — confirm the
      current limit for your target market and lot before contracting.
    </p>

    <h2 style="margin-top:32px;">COA, Phytosanitary and Traceability Documents</h2>
    <p>
      Every shipment's documentation set can include:
    </p>
    <ul>
      <li><strong>Lot-specific COA</strong> — measured SHU, ASTA, moisture, microbial, pesticide and mycotoxin values for the lot you are actually buying — not a catalogue range.</li>
      <li><strong>Phytosanitary certificate</strong> — where the destination country requires it.</li>
      <li><strong>Traceability</strong> — lot-to-growing-base linkage across 12 controlled growing bases, retained samples, and a complaint/recall process.</li>
    </ul>
    <p>
      A generic catalogue certificate is not a lot COA — the test that counts is tied to the
      batch on your invoice.
    </p>

    <h2 style="margin-top:32px;">Quality Control Points</h2>
    <ul>
      <li>24-hour full surveillance across factory and workshop</li>
      <li>Reviewed operating procedures at every position, strictly enforced</li>
      <li>Dedicated quality inspectors at each stage</li>
      <li>Advanced industrial equipment and process flow</li>
      <li>Moisture control and foreign-object screening throughout</li>
    </ul>

    <h2 style="margin-top:32px;">Colour Stability Notes</h2>
    <p>
      We document how colour behaves over time for our buyers: chilli powder lightens gradually at
      room temperature (faster after high-temperature sterilisation), while sweet paprika powder
      may darken after sterilisation. This is normal colour chemistry — and we advise on storage to
      preserve colour in your application.
    </p>
    <p>
      For the full technical explanation, see
      <a href="https://docs.drychillis.com/colour-storage/" target="_blank" rel="noopener">colour change &amp; storage</a>
      and <a href="https://docs.drychillis.com/quality-control/" target="_blank" rel="noopener">quality control</a>
      in the Knowledge Hub.
    </p>

    <h2 style="margin-top:32px;">Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What certifications does Tenda Peppers hold?</h3>
      <p>Tenda Peppers is certified to ISO 9001:2015 (quality management) and HACCP (food safety). Production runs under a zero-defect, zero-tolerance food safety policy with 24-hour surveillance.</p>
    </div>
    <div class="faq-item">
      <h3>How do you remove foreign objects from chilli?</h3>
      <p>Every batch passes de-seeding, magnet filtration (ferrous metal), X-ray inspection (dense objects) and colour sorting (optical grading of defects). This multi-stage screening runs alongside moisture control.</p>
    </div>
    <div class="faq-item">
      <h3>Can I get certificates and batch documentation?</h3>
      <p>Yes. Certificates and batch documentation are available on request, and every shipment is traceable to its growing base under the ISO 9001 / HACCP system.</p>
    </div>
    <div class="faq-item">
      <h3>How is batch-to-batch consistency ensured?</h3>
      <p>Consistency comes from variety and grade control at source, raw-material traceability from 12 controlled growing bases, and laboratory re-verification before production — so heat, colour and flavour stay stable between batches.</p>
    </div>
    <div class="faq-item">
      <h3>What is the difference between your quality controls and what I must specify?</h3>
      <p>Three layers apply: our confirmed production controls (magnet filtration, X-ray, colour sorting, moisture control under ISO 9001 and HACCP), regulatory limits set by your target market (mycotoxins, pesticide MRLs, Salmonella, heavy metals), and buyer-specified testing (third-party testing, market-specific MRL screens, microbial-reduction step, lot-specific COA and phytosanitary where required).</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/contact/">Request Certificates</a>
    </div>
  </div>
</BaseLayout>
