---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BuyerSpec from "../../../components/BuyerSpec.astro";
import AtAGlance from "../../../components/AtAGlance.astro";

const buyerSpec = [
  { param: "شكل المنتج", value: "تأكيد المواصفات" },
  { param: "الصنف", value: "فلفل شيان" },
  { param: "مستوى الحرارة (SHU)", value: "10,000–20,000" },
  { param: "قيمة اللون ASTA", value: "تأكيد المواصفات" },
  { param: "حجم الشبكة (Mesh)", value: "تأكيد المواصفات" },
  { param: "الرطوبة", value: "<13%" },
  { param: "المعالجة", value: "تأكيد المواصفات" },
  { param: "الشهادات", value: "ISO 9001 وHACCP قياسيًا — BRC وحلال وكوشر عند الطلب" },
];

const glanceFacts = [
  { label: "مستوى الحرارة", value: "10,000–20,000 SHU" },
  { label: "المنطقة", value: "منغوليا الداخلية، شينجيانغ" },
  { label: "الأنسب لـ", value: "مسحوق الفلفل، الرقائق، التوابل" },
  { label: "الشهادات", value: "ISO 9001 وHACCP" },
];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "https://drychillis.com/products/xian-pepper/#product",
  "name": "فلفل شيان",
  "description": "فلفل شيان — فلفل متوسط الحرارة عند 10,000–20,000 SHU من منغوليا الداخلية وشينجيانغ، لمسحوق الفلفل والرقائق والتوابل. مصنع صيني، ISO 9001 وHACCP.",
  "image": ["https://drychillis.com/images/products/chilli-whole.jpg"],
  "url": "https://drychillis.com/products/xian-pepper/",
  "sku": "TENDA-XIAN-PEPPER",
  "category": "البهارات والتوابل",
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "مستوى الحرارة (SHU)", "value": "10,000–20,000", "unitText": "SHU" },
    { "@type": "PropertyValue", "name": "المنطقة", "value": "منغوليا الداخلية، شينجيانغ" },
    { "@type": "PropertyValue", "name": "الأنسب لـ", "value": "مسحوق الفلفل، الرقائق، التوابل" }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هو فلفل شيان؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "فلفل شيان فلفل متوسط الحرارة عند 10,000–20,000 SHU من منغوليا الداخلية وشينجيانغ — أحمر داكن ودهني، يُستخدم لمسحوق الفلفل والرقائق والصلصة. وهو الصنف المتوسط الرئيسي إلى جانب جينتا."
      }
    },
    {
      "@type": "Question",
      "name": "ما مدى حرارة فلفل شيان؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "فلفل شيان متوسط الحرارة عند 10,000–20,000 SHU — دافئ بوضوح دون حرق الأصناف عالية الحرارة، وأكثر حرارة بنحو 20–40 مرة من البابريكا الحلوة."
      }
    },
    {
      "@type": "Question",
      "name": "فيمَ يُستخدم فلفل شيان؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُستخدم فلفل شيان لمسحوق الفلفل المتوسط والرقائق (مطحونًا مع جينتا) وخلطات التوابل. اذكر الصنف ونافذة SHU في مواصفاتك — الحرارة والرائحة تتغيران باستقلالية."
      }
    }
  ]
};
---

<BaseLayout
  title="فلفل شيان — 10,000–20,000 SHU فلفل متوسط | Tenda Peppers"
  description="فلفل شيان — فلفل متوسط الحرارة عند 10,000–20,000 SHU من منغوليا الداخلية وشينجيانغ، لمسحوق الفلفل والرقائق والتوابل. مصنع صيني، ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; فلفل شيان
    </nav>
    <h1>فلفل شيان</h1>
    <p class="lead">
      فلفل متوسط الحرارة عند 10,000–20,000 SHU من منغوليا الداخلية وشينجيانغ — الوسط متعدد الاستخدامات لمسحوق الفلفل والرقائق والتوابل.
    </p>
    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> فلفل شيان فلفل متوسط الحرارة (10,000–20,000 SHU) من منغوليا الداخلية وشينجيانغ. هو الوسط متعدد الاستخدامات — أحمر داكن ودهني، يُستخدم لمسحوق الفلفل والرقائق والصلصة، ويُطحن مع جينتا للرقائق.
    </div>
    <AtAGlance facts={glanceFacts} lang="ar" />
    <div class="product-media">
      <img src="/images/products/chilli-whole.jpg" alt="فلفل مجفف كامل" width="1400" height="1050" loading="eager" />
    </div>
    <p class="product-price" style="font-weight:600;color:#8a1c1c;margin:10px 0 0;">يُؤكَّد السعر عند طلب العرض — يُتفق على الحد الأدنى للطلب والتعبئة والمواصفات قبل الطلب.</p>

    <h2 style="margin-top:32px;">ما هو فلفل شيان؟</h2>
    <p>
      فلفل شيان فلفل متوسط الحرارة عند 10,000–20,000 SHU من منغوليا الداخلية وشينجيانغ. يظهر في صفحة <a href="/ar/heat-levels/medium-heat/">الحرارة المتوسطة</a> كالصنف المتوسط الرئيسي إلى جانب جينتا — دافئ بوضوح دون حرق الأصناف عالية الحرارة، وهو النطاق الأكبر حجمًا لأنه يناسب أوسع مجموعة من المنتجات.
    </p>
    <table>
      <thead>
        <tr><th>الخاصية</th><th>التفاصيل</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>الحرارة (SHU)</strong></td><td>10,000–20,000</td></tr>
        <tr><td><strong>المنطقة</strong></td><td>منغوليا الداخلية، شينجيانغ</td></tr>
        <tr><td><strong>الأنسب لـ</strong></td><td>مسحوق الفلفل، الرقائق، التوابل</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">فيمَ يُستخدم فلفل شيان؟</h2>
    <ul>
      <li>مسحوق الفلفل (المتوسط)</li>
      <li>رقائق الفلفل (مطحون مع جينتا)</li>
      <li>التوابل والصلصة</li>
    </ul>

    <h2 style="margin-top:32px;">شيان مقابل جينتا مقابل إرجينغتياو</h2>
    <p>
      فلفل شيان وجينتا هما الصنفان الرئيسيان عند 10,000–20,000 SHU؛ إرجينغتياو عند 15,000–30,000 SHU. يناسب جينتا الرقائق والمسحوق ذا اللون الزاهي؛ يضيف إرجينغتياو الرائحة ويُستخدم لمعجون الفلفل. شيان هو الوسط متعدد الاستخدامات — أحمر داكن ودهني، يُستخدم لمسحوق الفلفل والصلصة.
    </p>

    <h2 style="margin-top:32px;">شيان بالأرقام</h2>
    <p>
      يقع فلفل شيان عند 10,000–20,000 SHU — أكثر حرارة بنحو 20–40 مرة من البابريكا الحلوة (أقل من 500 SHU) وأخف بنحو 2.5–5 مرات من نطاق الحرارة العالية (20,000–50,000). وهو النطاق الذي يناسب أوسع مجموعة من المنتجات.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكّد نافذة SHU والشكل والشبكة بدقة عند الاستفسار.
    </p>

    <BuyerSpec rows={buyerSpec} lang="ar" confirmText="تأكيد المواصفات" />

    <h2 style="margin-top:32px;">في نفس نطاق 10,000–20,000 SHU</h2>
    <p>
      أصناف أخرى في هذا النطاق: <a href="/ar/products/jinta-chilli/">جينتا</a>، <a href="/ar/products/lantern-chilli/">الفانوس</a>.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما هو فلفل شيان؟</h3>
      <p>فلفل شيان فلفل متوسط الحرارة عند 10,000–20,000 SHU من منغوليا الداخلية وشينجيانغ — أحمر داكن ودهني، يُستخدم لمسحوق الفلفل والرقائق والصلصة. وهو الصنف المتوسط الرئيسي إلى جانب جينتا.</p>
    </div>
    <div class="faq-item">
      <h3>ما مدى حرارة فلفل شيان؟</h3>
      <p>فلفل شيان متوسط الحرارة عند 10,000–20,000 SHU — دافئ بوضوح دون حرق الأصناف عالية الحرارة، وأكثر حرارة بنحو 20–40 مرة من البابريكا الحلوة.</p>
    </div>
    <div class="faq-item">
      <h3>فيمَ يُستخدم فلفل شيان؟</h3>
      <p>يُستخدم فلفل شيان لمسحوق الفلفل المتوسط والرقائق (مطحونًا مع جينتا) وخلطات التوابل. اذكر الصنف ونافذة SHU في مواصفاتك — الحرارة والرائحة تتغيران باستقلالية.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر شيان</a>
      <a class="cta cta-outline" href="/ar/products/dried-chillies/" style="margin-left:8px;">الفلفل المجفف ←</a>
    </div>
  </div>
</BaseLayout>
