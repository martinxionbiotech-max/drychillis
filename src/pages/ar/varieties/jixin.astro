---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هو فلفل جيشين؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "جيشين، فلفل قلب الدجاجة، قرن صغير على شكل قلب فائق الحرارة عند 50,000–70,000 SHU من قويتشو وهونان. هو معيار لمنتجات الحرارة الفائقة والأطباق بأسلوب سيتشوان."
      }
    },
    {
      "@type": "Question",
      "name": "ما مدى حرارة فلفل جيشين؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "جيشين فائق الحرارة عند 50,000–70,000 SHU — من أكثر الأصناف الصينية الشائعة حرارة، فوق نطاق سانينغ وزيدانتو عالي الحرارة، ويُستخدم حيث تكون الحرارة الفائقة هي الهدف."
      }
    },
    {
      "@type": "Question",
      "name": "فيمَ يُستخدم فلفل جيشين؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُستخدم جيشين لمنتجات الحرارة الفائقة: زيت الفلفل والأطباق بأسلوب سيتشوان وقواعد الهوت بوت والتوابل حيث يجب أن تمنح جرعة صغيرة حرارة قوية. جرّعه بالوزن لأن الحرارة غير خطية."
      }
    }
  ]
};
---

<BaseLayout
  title="فلفل جيشين (قلب الدجاجة) — 50,000–70,000 SHU | Tenda Peppers"
  description="فلفل جيشين (قلب الدجاجة) — قرن صغير فائق الحرارة من قويتشو وهونان عند 50,000–70,000 SHU لزيت الفلفل وأطباق سيتشوان. مصنع صيني."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; جيشين
    </nav>
    <h1>فلفل جيشين (قلب الدجاجة)</h1>
    <p class="lead">
      فلفل قلب الدجاجة — قرن صغير على شكل قلب فائق الحرارة عند 50,000–70,000 SHU من قويتشو وهونان.
      المعيار للحرارة الفائقة والأطباق بأسلوب سيتشوان.
    </p>

    <h2 style="margin-top:32px;">ما هو فلفل جيشين؟</h2>
    <p>
      جيشين، بمعنى «قلب الدجاجة»، سمي كذلك لقرنه الصغير على شكل قلب. يقع في قمة مقياس حرارة الفلفل
      الصيني الشائع، عند 50,000–70,000 SHU، فوق نطاق الحرارة العالية — لذا يُجرَّع كلمسة لا كقاعدة.
      انظر صفحة <a href="/ar/heat-levels/extra-hot/">الحرارة الفائقة</a>.
    </p>
    <table>
      <thead>
        <tr><th>الخاصية</th><th>التفصيل</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>الحرارة (SHU)</strong></td><td>50,000 – 70,000</td></tr>
        <tr><td><strong>المنطقة</strong></td><td>قويتشو، هونان</td></tr>
        <tr><td><strong>نوع الثمرة</strong></td><td>قرن صغير على شكل قلب</td></tr>
        <tr><td><strong>الأفضل لـ</strong></td><td>حرارة فائقة، زيت الفلفل، سيتشوان</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">فيمَ يُستخدم فلفل جيشين؟</h2>
    <ul>
      <li>زيت الفلفل والزيوت المنقوعة</li>
      <li>أطباق بأسلوب سيتشوان والهوت بوت</li>
      <li>خلطات توابل فائقة الحرارة</li>
      <li>عبوات حرارة للوجبات الخفيفة والنودلز الفوري</li>
    </ul>

    <h2 style="margin-top:32px;">كيف تحدد فلفل جيشين</h2>
    <p>
      سمِّ الصنف ونطاق SHU المستهدف، ثم الشكل — يُورَّد جيشين عادة شرائح أو مسحوقًا. لأن الحرارة غير
      خطية، تحرّك جرعة صغيرة من جيشين حرارة الخلطة أكثر بكثير من الوزن نفسه من فلفل متوسط، لذا
      جرّعه بالوزن وأكد النطاق بدقة.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكد نطاق SHU والشكل الدقيق عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما هو فلفل جيشين؟</h3>
      <p>جيشين، فلفل قلب الدجاجة، قرن صغير على شكل قلب فائق الحرارة عند 50,000–70,000 SHU من قويتشو وهونان. هو معيار لمنتجات الحرارة الفائقة والأطباق بأسلوب سيتشوان.</p>
    </div>
    <div class="faq-item">
      <h3>ما مدى حرارة فلفل جيشين؟</h3>
      <p>جيشين فائق الحرارة عند 50,000–70,000 SHU — من أكثر الأصناف الصينية الشائعة حرارة، فوق نطاق سانينغ وزيدانتو عالي الحرارة، ويُستخدم حيث تكون الحرارة الفائقة هي الهدف.</p>
    </div>
    <div class="faq-item">
      <h3>فيمَ يُستخدم فلفل جيشين؟</h3>
      <p>يُستخدم جيشين لمنتجات الحرارة الفائقة: زيت الفلفل والأطباق بأسلوب سيتشوان وقواعد الهوت بوت والتوابل حيث يجب أن تمنح جرعة صغيرة حرارة قوية. جرّعه بالوزن لأن الحرارة غير خطية.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر جيشين</a>
      <a class="cta cta-outline" href="/ar/varieties/xiaomi/" style="margin-left:8px;">شياومي ←</a>
    </div>
  </div>
</BaseLayout>
