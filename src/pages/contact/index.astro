---
import BaseLayout from "../../layouts/BaseLayout.astro";

const contactJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Tenda Peppers",
  "url": "https://drychillis.com/contact/",
  "mainEntity": { "@id": "https://drychillis.com/#organization" }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What information should I include in my paprika or chilli inquiry?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Include the product form (paprika powder, chilli flakes, powder, whole chillies or segments), your target heat level (SHU) and ASTA colour value, mesh and moisture requirements, target quantity and destination port."
      }
    },
    {
      "@type": "Question",
      "name": "Do you supply custom specifications?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We match paprika and chilli to your target colour value, heat level, mesh and packaging, with one-stop customisation and batch documentation on every shipment."
      }
    },
    {
      "@type": "Question",
      "name": "What is the minimum order quantity?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "MOQ depends on the product and specification. Contact us with your target quantity and destination to confirm MOQ, lead time and shipping terms."
      }
    }
  ]
};
---

<BaseLayout
  title="Contact Tenda Peppers — Paprika & Chilli Inquiry"
  description="Contact Tenda Peppers for paprika powder and dried chilli quotes, custom specifications and export inquiries. Email joanna@paprikabulk.com or WhatsApp +86 15153588090."
  jsonLd={[contactJsonLd, faqJsonLd]}
>
  <div class="container section">
    <h1>Contact &amp; Inquiry</h1>
    <p class="lead">
      For paprika and dried chilli quotes, custom specifications and export inquiries, reach us
      directly. Include your product form, target heat level and colour value for a faster response.
    </p>

    <div class="grid grid-2" style="margin-top:24px;">
      <div class="card">
        <h3>Direct Contact</h3>
        <p>
          <strong>Email:</strong> <a href="mailto:joanna@paprikabulk.com">joanna@paprikabulk.com</a><br />
          <strong>Phone / WhatsApp:</strong> <a href="https://wa.me/8615153588090" target="_blank" rel="noopener">+86 15153588090</a>
        </p>
        <a class="whatsapp-btn" href="https://wa.me/8615153588090" target="_blank" rel="noopener" style="margin-top:8px;"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg> Chat on WhatsApp</a>
      </div>
      <div class="card">
        <h3>Factory</h3>
        <p>
          Leling Tenda Chili Products Co., Ltd.<br />
          Yang'an Town Outer Ring Road,<br />
          Leling, Shandong, China
        </p>
      </div>
    </div>

    <h2 style="margin-top:32px;">What to Include in Your Inquiry</h2>
    <ul>
      <li>Product form — paprika powder, chilli flakes, chilli powder, whole chillies or segments</li>
      <li>Target heat level (SHU) and ASTA colour value</li>
      <li>Mesh and moisture requirements (if specified)</li>
      <li>Target quantity and destination port</li>
    </ul>

    <h2 style="margin-top:32px;">Markets We Serve</h2>
    <p>
      We supply food manufacturers, importers and distributors across Europe, the Middle East and
      North America. Paprika and chilli are exported with full batch documentation, in line with
      ISO 9001 and HACCP quality systems.
    </p>

    <h2 style="margin-top:32px;">Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What information should I include in my paprika or chilli inquiry?</h3>
      <p>Include the product form (paprika powder, chilli flakes, powder, whole chillies or segments), your target heat level (SHU) and ASTA colour value, mesh and moisture requirements, target quantity and destination port.</p>
    </div>
    <div class="faq-item">
      <h3>Do you supply custom specifications?</h3>
      <p>Yes. We match paprika and chilli to your target colour value, heat level, mesh and packaging, with one-stop customisation and batch documentation on every shipment.</p>
    </div>
    <div class="faq-item">
      <h3>What is the minimum order quantity?</h3>
      <p>MOQ depends on the product and specification. Contact us with your target quantity and destination to confirm MOQ, lead time and shipping terms.</p>
    </div>
  </div>
</BaseLayout>
