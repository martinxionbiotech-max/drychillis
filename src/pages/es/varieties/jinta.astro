  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué es el chile Jinta?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Jinta es un chile de picor medio de Gansu y Xinjiang, de 10.000–20.000 SHU. Sus vainas son largas (11–14 cm), de rojo azufaifo intenso y piel gruesa y brillante, lo que lo hace un estándar para escamas visibles y color brillante."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué tan picante es el pimiento Jinta?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Jinta es de picor medio, 10.000–20.000 SHU — suave para condimentos generales y escamas, con el picor de Xian y Erjingtiao. Se elige más por el color y la apariencia que por el picor."
      }
    },
    {
      "@type": "Question",
      "name": "¿Para qué se usa el pimiento Jinta?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Jinta se usa para escamas de chile visibles, cobertura de pizza, mezclas de condimentos y pasta de chile. Su color rojo intenso y piel gruesa y brillante lo hacen la variedad preferida para escamas."
      }
    }
  ]
