---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const contactJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "تواصل مع Tenda Peppers",
  "url": "https://drychillis.com/ar/contact/",
  "mainEntity": { "@id": "https://drychillis.com/#organization" }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما المعلومات التي يجب تضمينها في استفساري عن الفلفل الحلو أو الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "أدرج شكل المنتج (مسحوق فلفل حلو، رقائق فلفل حار، مسحوق، فلفل كامل أو قطع)، ومستوى الحرارة المستهدف (SHU) وقيمة اللون ASTA، ومتطلبات الشبكة والرطوبة، والكمية المستهدفة وميناء الوجهة."
      }
    },
    {
      "@type": "Question",
      "name": "هل توردون مواصفات مخصصة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم. نضبط الفلفل الحلو والفلفل الحار وفقًا لقيمة اللون ومستوى الحرارة والشبكة والتغليف المستهدف، مع تخصيص شامل وتوثيق للدفعات في كل شحنة."
      }
    },
    {
      "@type": "Question",
      "name": "ما الحد الأدنى لكمية الطلب؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يعتمد الحد الأدنى على المنتج والمواصفات. تواصل معنا بكميتك المستهدفة ووجهتك لتأكيد الحد الأدنى ومدة التسليم وشروط الشحن."
      }
    }
  ]
};
---

<BaseLayout
  lang="ar"
  title="تواصل مع Tenda Peppers — استفسار الفلفل الحلو والفلفل الحار"
  description="تواصل مع Tenda Peppers لعروض أسعار مسحوق الفلفل الحلو والفلفل الحار المجفف والمواصفات المخصصة واستفسارات التصدير. البريد الإلكتروني tdlajiao@126.com أو واتساب +86 18162067392."
  jsonLd={[contactJsonLd, faqJsonLd]}
>
  <div class="container section">
    <h1>التواصل والاستفسار</h1>
    <p class="lead">
      لعروض أسعار الفلفل الحلو والفلفل الحار المجفف والمواصفات المخصصة واستفسارات التصدير،
      تواصل معنا مباشرة. أدرج شكل المنتج ومستوى الحرارة وقيمة اللون المستهدفة لاستجابة أسرع.
    </p>

    <div class="grid grid-2" style="margin-top:24px;">
      <div class="card">
        <h3>تواصل مباشر</h3>
        <p>
          <strong>البريد الإلكتروني:</strong> <a href="mailto:tdlajiao@126.com">tdlajiao@126.com</a><br />
          <strong>الهاتف / واتساب:</strong> <a href="tel:+8618162067392">+86 18162067392</a>
        </p>
      </div>
      <div class="card">
        <h3>المصنع</h3>
        <p>
          Leling Tenda Chili Products Co., Ltd.<br />
          Yang'an Town Outer Ring Road,<br />
          Leling, Shandong, China
        </p>
      </div>
    </div>

    <h2 style="margin-top:32px;">ما الذي يجب تضمينه في استفسارك</h2>
    <ul>
      <li>شكل المنتج — مسحوق فلفل حلو، رقائق فلفل حار، مسحوق فلفل حار، فلفل كامل أو قطع</li>
      <li>مستوى الحرارة المستهدف (SHU) وقيمة اللون ASTA</li>
      <li>متطلبات الشبكة والرطوبة (إن وُجدت)</li>
      <li>الكمية المستهدفة وميناء الوجهة</li>
    </ul>

    <h2 style="margin-top:32px;">الأسواق التي نخدمها</h2>
    <p>
      نورد لمصنّعي الأغذية والمستوردين والموزعين في أوروبا والشرق الأوسط وأمريكا الشمالية.
      يُصدَّر الفلفل الحلو والفلفل الحار مع توثيق كامل للدفعات، وفقًا لنظامي الجودة ISO 9001
      وHACCP.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما المعلومات التي يجب تضمينها في استفساري عن الفلفل الحلو أو الفلفل الحار؟</h3>
      <p>أدرج شكل المنتج (مسحوق فلفل حلو، رقائق فلفل حار، مسحوق، فلفل كامل أو قطع)، ومستوى الحرارة المستهدف (SHU) وقيمة اللون ASTA، ومتطلبات الشبكة والرطوبة، والكمية المستهدفة وميناء الوجهة.</p>
    </div>
    <div class="faq-item">
      <h3>هل توردون مواصفات مخصصة؟</h3>
      <p>نعم. نضبط الفلفل الحلو والفلفل الحار وفقًا لقيمة اللون ومستوى الحرارة والشبكة والتغليف المستهدف، مع تخصيص شامل وتوثيق للدفعات في كل شحنة.</p>
    </div>
    <div class="faq-item">
      <h3>ما الحد الأدنى لكمية الطلب؟</h3>
      <p>يعتمد الحد الأدنى على المنتج والمواصفات. تواصل معنا بكميتك المستهدفة ووجهتك لتأكيد الحد الأدنى ومدة التسليم وشروط الشحن.</p>
    </div>
  </div>
</BaseLayout>
