---
import { buildOffers, priceLine } from "../../../../data/product-offers";
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const productOffers = buildOffers("chilli-flakes", "https://drychillis.com/ar/products/dried-chillies/chilli-flakes/");

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هي رقائق الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "رقائق الفلفل الحار (الفلفل الأحمر المجروش) هي فلفل مجفف مسحوق إلى قطع خشنة — عادة 20–40 ميش — مع بذور وقشرة مرئية. تقع في نطاق 10,000–20,000 SHU وتُستخدم لتزيين البيتزا وخلطات التوابل والوجبات الخفيفة."
      }
    },
    {
      "@type": "Question",
      "name": "ما مستوى حرارة رقائق الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "معظم رقائق الفلفل الحار متوسطة الحرارة، 10,000–20,000 SHU، من أصناف مثل شيان وجينتا؛ رقائق إيرجينغتياو تقع في 15,000–30,000 SHU. تتوفر رقائق أكثر حرارة بتحديد صنف أقوى، لكن الرقاقة التجارية القياسية متوسطة."
      }
    },
    {
      "@type": "Question",
      "name": "ما حجم الميش لرقائق الفلفل الحار؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "رقائق الفلفل الحار قطع خشنة 20–40 ميش — أكبر من المسحوق (60–80 ميش) وأصغر من الفلفل الكامل. القطع الخشن يُبقي البذور والقشرة مرئية ويعطي الرقاقة قوامها المميز."
      }
    }
  ]
};
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "https://drychillis.com/ar/products/dried-chillies/chilli-flakes/#product",
  "name": "رقائق الفلفل الحار (فلفل أحمر مجروش)",
  "description": "فلفل مجفف مسحوق خشن — 20–40 ميش، 10,000–20,000 SHU — الشكل القياسي لتزيين البيتزا وخلطات التوابل ونكهات الوجبات الخفيفة، مطحون من شيان وجينتا؛ رقائق إيرجينغتياو تقع في 15,000–30,000 SHU.",
  "url": "https://drychillis.com/ar/products/dried-chillies/chilli-flakes/",
  "sku": "TENDA-CHILLI-FLAKES",
  "category": "Spices and Seasonings",
  "image": ["https://drychillis.com/images/products/chilli-flakes.jpg"],
  "brand": { "@type": "Brand", "name": "Tenda Peppers" },
  "manufacturer": { "@id": "https://drychillis.com/#organization" },
  ...(productOffers ? { "offers": productOffers } : {}),
  "additionalProperty": [
  {
    "@type": "PropertyValue",
    "name": "فلفل شيان",
    "value": "10,000 – 20,000 خنان خلطات التوابل، البيتزا"
  },
  {
    "@type": "PropertyValue",
    "name": "جينتا",
    "value": "10,000 – 20,000 قانسو رقائق مرئية، اللون"
  },
  {
    "@type": "PropertyValue",
    "name": "إيرجينغتياو",
    "value": "15,000 – 30,000 سيتشوان رقائق عطرية، زيت الفلفل"
  }
]
};
---

<BaseLayout
  title="رقائق الفلفل الحار (فلفل أحمر مجروش) | Tenda Peppers"
  description="مصنع صيني لرقائق الفلفل الحار — فلفل أحمر مجروش عند 10,000–20,000 SHU و20–40 ميش من شيان وجينتا، إضافة إلى إيرجينغتياو عند 15,000–30,000 SHU. ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; رقائق الفلفل الحار
    </nav>
    <h1>رقائق الفلفل الحار (فلفل أحمر مجروش)</h1>
    <p class="lead">
      فلفل مجفف مسحوق خشن — 20–40 ميش، 10,000–20,000 SHU — الشكل القياسي لتزيين البيتزا وخلطات
      التوابل ونكهات الوجبات الخفيفة، مطحون من شيان وجينتا؛ رقائق إيرجينغتياو تقع في 15,000–30,000 SHU.
    </p>
    <p class="product-price" style="font-weight:600;color:#8a1c1c;margin:10px 0 0;">{priceLine("chilli-flakes", "ar")}</p>

    <h2 style="margin-top:32px;">ما هي رقائق الفلفل الحار؟</h2>
    <p>
      رقائق الفلفل الحار، وتسمى أيضًا الفلفل الأحمر المجروش، هي فلفل مجفف مسحوق إلى قطع خشنة مع
      بذور وقشرة مرئية. لها حرارة متوسطة (10,000–20,000 SHU) وتعطي الأطباق حرارة وقوامًا مرئيًا.
      القطع الخشن هو ما يميزها عن المسحوق — انظر
      <a href="/ar/specs/mesh-size/">دليل حجم الميش</a>.
    </p>
    <table>
      <thead>
        <tr><th>الصنف</th><th>الحرارة (SHU)</th><th>المنطقة</th><th>الأفضل لـ</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>فلفل شيان</strong></td><td>10,000 – 20,000</td><td>خنان</td><td>خلطات التوابل، البيتزا</td></tr>
        <tr><td><strong>جينتا</strong></td><td>10,000 – 20,000</td><td>قانسو</td><td>رقائق مرئية، اللون</td></tr>
        <tr><td><strong>إيرجينغتياو</strong></td><td>15,000 – 30,000</td><td>سيتشوان</td><td>رقائق عطرية، زيت الفلفل</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">فيمَ تُستخدم رقائق الفلفل الحار؟</h2>
    <ul>
      <li>تزيين البيتزا والمعكرونة</li>
      <li>خلطات التوابل والبهارات</li>
      <li>نكهات الوجبات الخفيفة والنودلز الفوري</li>
      <li>زيت الفلفل والرقائق المنقوعة</li>
    </ul>

    <h2 style="margin-top:32px;">كيف تحدد رقائق الفلفل الحار</h2>
    <p>
      حدد الميش (20–40 قياسي)، ونطاق SHU، والصنف. إذا أردت لونًا مرئيًا، فجينتا يعطي أحمر أكثر
      إشراقًا؛ وإيرجينغتياو يضيف عطرًا دون حرارة مفرطة. أكد الرطوبة (أقل من 13%) وما إذا كنت تريد
      رقائق منزوعة البذور — معظم الرقائق تُبقي بذورها للقوام.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكد نطاق SHU والميش والرطوبة الدقيق عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما هي رقائق الفلفل الحار؟</h3>
      <p>رقائق الفلفل الحار (الفلفل الأحمر المجروش) هي فلفل مجفف مسحوق إلى قطع خشنة — عادة 20–40 ميش — مع بذور وقشرة مرئية. تقع في نطاق 10,000–20,000 SHU وتُستخدم لتزيين البيتزا وخلطات التوابل والوجبات الخفيفة.</p>
    </div>
    <div class="faq-item">
      <h3>ما مستوى حرارة رقائق الفلفل الحار؟</h3>
      <p>معظم رقائق الفلفل الحار متوسطة الحرارة، 10,000–20,000 SHU، من أصناف مثل شيان وجينتا؛ رقائق إيرجينغتياو تقع في 15,000–30,000 SHU. تتوفر رقائق أكثر حرارة بتحديد صنف أقوى، لكن الرقاقة التجارية القياسية متوسطة.</p>
    </div>
    <div class="faq-item">
      <h3>ما حجم الميش لرقائق الفلفل الحار؟</h3>
      <p>رقائق الفلفل الحار قطع خشنة 20–40 ميش — أكبر من المسحوق (60–80 ميش) وأصغر من الفلفل الكامل. القطع الخشن يُبقي البذور والقشرة مرئية ويعطي الرقاقة قوامها المميز.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر للرقائق</a>
      <a class="cta cta-outline" href="/ar/products/dried-chillies/chilli-powder/" style="margin-left:8px;">مسحوق الفلفل الحار ←</a>
    </div>
  </div>
</BaseLayout>
