---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AtAGlance from "../../../components/AtAGlance.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما الفلفل الأفضل لزيت الفلفل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "إرجينغتياو العطري يعطي الرائحة، ويُخلط عادة مع صنف حرارة مثل سانينغ أو جيشين، على شكل رقائق أو قطع لنقع متساوٍ."
      }
    },
    {
      "@type": "Question",
      "name": "رقائق أم مسحوق لزيت الفلفل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "رقائق أو قطع — المسحوق الناعم يعكّر الزيت ويفقد رائحته أسرع. الرقائق والقطع تنقع بالتساوي وتحافظ على سطح الرائحة سليمًا."
      }
    },
    {
      "@type": "Question",
      "name": "ما مدى حرارة الفلفل لزيت الفلفل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "القاعدة العطرية (إرجينغتياو) عند 15,000–30,000 SHU؛ والخلطات مع صنف حرارة تصل إلى 50,000 SHU فأكثر. حدّد نافذة SHU لكل صنف في الخلطة."
      }
    }
  ]
};

const glanceFacts = [
  { label: "الصنف الأساسي", value: "إرجينغتياو" },
  { label: "الحرارة", value: "15,000–50,000 SHU" },
  { label: "الشكل", value: "رقائق، قطع" },
  { label: "يُقيَّم بـ", value: "الرائحة والحرارة" }
];
---

<BaseLayout
  title="فلفل لزيت الفلفل | Tenda Peppers"
  description="ما الفلفل الذي تستخدمه لزيت الفلفل — إرجينغتياو عطري مخلوط مع سانينغ أو جيشين، على شكل رقائق أو قطع. مصنع صيني، ISO 9001 وHACCP."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/guides/">الأدلة</a> &rsaquo; زيت الفلفل
    </nav>
    <h1>فلفل لزيت الفلفل</h1>
    <p class="lead">
      يُقيَّم زيت الفلفل بالرائحة بقدر الحرارة. القاعدة الكلاسيكية هي إرجينغتياو العطري، مخلوطًا مع صنف حرارة مثل سانينغ أو جيشين — على شكل رقائق أو قطع، لا مسحوق ناعم.
    </p>

    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> زيت الفلفل يريد الرائحة (إرجينغتياو، 15,000–30,000 SHU) مخلوطة مع الحرارة (سانينغ أو جيشين). استخدم رقائق أو قطعًا لنقع متساوٍ — المسحوق الناعم يعكّر الزيت ويفقد رائحته أسرع.
    </div>
    <AtAGlance facts={glanceFacts} lang="ar" />

    <h2 style="margin-top:32px;">ما الذي يجعل الفلفل جيدًا لزيت الفلفل؟</h2>
    <p>
      يُقيَّم زيت الفلفل بالرائحة بقدر الحرارة. القاعدة الكلاسيكية هي إرجينغتياو العطري (15,000–30,000 SHU)، ويُخلط غالبًا مع صنف حرارة مثل سانينغ أو جيشين. الرقائق أو القطع تنقع بالتساوي وتحافظ على سطح الرائحة سليمًا.
    </p>
    <table>
      <thead>
        <tr><th>الصنف / النطاق</th><th>الحرارة (SHU)</th><th>الدور</th><th></th></tr>
      </thead>
      <tbody>
        <tr><td><strong>إرجينغتياو</strong></td><td>15,000 – 30,000</td><td>قاعدة عطرية، معجون الفلفل، هوت بوت</td><td><a href="https://drychillis.com/products/erjingtiao-chilli/">عرض ←</a></td></tr>
        <tr><td><strong>سانينغ (تيانيينغ)</strong></td><td>20,000 – 50,000</td><td>شريك الحرارة في الخلطة</td><td><a href="/ar/products/sanying-chilli/">عرض ←</a></td></tr>
        <tr><td><strong>شياومي (الدخن)</strong></td><td>50,000 – 70,000</td><td>زيت الفلفل، حرارة قصوى</td><td><a href="/ar/products/xiaomi-chilli/">عرض ←</a></td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">كيف تحدد الفلفل لزيت الفلفل</h2>
    <p>
      استخدم رقائق أو قطعًا لنقع متساوٍ وللحفاظ على سطح الرائحة سليمًا — المسحوق الناعم يعكّر الزيت ويفقد رائحته أسرع. اذكر الصنف الأساسي (إرجينغتياو) وشريك الحرارة، مع نافذة SHU لكل منهما.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكّد نافذة SHU والشكل والشبكة بدقة عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما الفلفل الأفضل لزيت الفلفل؟</h3>
      <p>إرجينغتياو العطري يعطي الرائحة، ويُخلط عادة مع صنف حرارة مثل سانينغ أو جيشين، على شكل رقائق أو قطع لنقع متساوٍ.</p>
    </div>
    <div class="faq-item">
      <h3>رقائق أم مسحوق لزيت الفلفل؟</h3>
      <p>رقائق أو قطع — المسحوق الناعم يعكّر الزيت ويفقد رائحته أسرع. الرقائق والقطع تنقع بالتساوي وتحافظ على سطح الرائحة سليمًا.</p>
    </div>
    <div class="faq-item">
      <h3>ما مدى حرارة الفلفل لزيت الفلفل؟</h3>
      <p>القاعدة العطرية (إرجينغتياو) عند 15,000–30,000 SHU؛ والخلطات مع صنف حرارة تصل إلى 50,000 SHU فأكثر. حدّد نافذة SHU لكل صنف في الخلطة.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/products/dried-chillies/">الفلفل المجفف ←</a>
      <a class="cta cta-outline" href="/ar/contact/" style="margin-left:8px;">اطلب عرض سعر</a>
    </div>
  </div>
</BaseLayout>
