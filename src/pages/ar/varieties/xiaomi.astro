---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هو فلفل شياومي؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "شياومي فلفل صغير نحيل فائق الحرارة من يونان وقويتشو عند 50,000–70,000 SHU. يُستخدم للفلفل الكامل عالي الحرارة والقطع وزيت الفلفل، مانحًا حرارة قوية في قرن مدمج."
      }
    },
    {
      "@type": "Question",
      "name": "ما مدى حرارة فلفل شياومي؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "شياومي فائق الحرارة عند 50,000–70,000 SHU، في نفس نطاق جيشين وتشيلي كينغ — فوق الأصناف عالية الحرارة ويُستخدم حيث يجب أن يمنح قرن صغير حرارة قوية."
      }
    },
    {
      "@type": "Question",
      "name": "فيمَ يُستخدم فلفل شياومي؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يُستخدم شياومي للفلفل الكامل عالي الحرارة وشرائح الفلفل وزيت الفلفل والتوابل بأسلوب سيتشوان. يبقى قرنه المدمج مرئيًا في الأطباق بينما يمنح حرارة فائقة."
      }
    }
  ]
};
---

<BaseLayout
  title="فلفل شياومي — 50,000–70,000 SHU | Tenda Peppers"
  description="فلفل شياومي — فلفل صغير نحيل فائق الحرارة من يونان وقويتشو عند 50,000–70,000 SHU للفلفل الكامل والشرائح وزيت الفلفل. مصنع صيني."
  lang="ar"
  jsonLd={[faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/ar/">الرئيسية</a> &rsaquo; <a href="/ar/products/dried-chillies/">الفلفل المجفف</a> &rsaquo; شياومي
    </nav>
    <h1>فلفل شياومي</h1>
    <p class="lead">
      فلفل صغير نحيل فائق الحرارة عند 50,000–70,000 SHU من يونان وقويتشو — يُستخدم للفلفل الكامل
      عالي الحرارة والشرائح وزيت الفلفل حيث يمنح قرن مدمج حرارة قوية.
    </p>

    <h2 style="margin-top:32px;">ما هو فلفل شياومي؟</h2>
    <p>
      شياومي («الأرز الصغير») سمي لقرنه الصغير النحيل. يقع في النطاق فائق الحرارة، عند 50,000–70,000
      SHU، إلى جانب جيشين وتشيلي كينغ، وحجمه المدمج يجعله مثاليًا للتطبيقات حيث يجب أن يبقى الفلفل
      مرئيًا بينما يمنح حرارة فائقة. انظر صفحة <a href="/ar/heat-levels/extra-hot/">الحرارة الفائقة</a>.
    </p>
    <table>
      <thead>
        <tr><th>الخاصية</th><th>التفصيل</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>الحرارة (SHU)</strong></td><td>50,000 – 70,000</td></tr>
        <tr><td><strong>المنطقة</strong></td><td>يونان، قويتشو</td></tr>
        <tr><td><strong>نوع الثمرة</strong></td><td>قرن صغير نحيل</td></tr>
        <tr><td><strong>الأفضل لـ</strong></td><td>فلفل كامل، شرائح، زيت الفلفل</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:32px;">فيمَ يُستخدم فلفل شياومي؟</h2>
    <ul>
      <li>فلفل مجفف كامل عالي الحرارة</li>
      <li>شرائح الفلفل وزيت الفلفل</li>
      <li>أطباق بأسلوب سيتشوان والهوت بوت</li>
      <li>خلطات توابل فائقة الحرارة</li>
    </ul>

    <h2 style="margin-top:32px;">كيف تحدد فلفل شياومي</h2>
    <p>
      سمِّ الصنف ونطاق SHU المستهدف، ثم الشكل — يُورَّد شياومي عادة كاملًا أو شرائح. يبقى قرنه
      الصغير مرئيًا في الطبق النهائي، وهو غالبًا سبب اختياره على المسحوق. أكد درجة الحجم والرطوبة
      وما إذا كنت تحتاج قرونًا منزوعة الساق.
    </p>
    <p class="data-note">
      قيم الحرارة تمثيلية لكل صنف. أكد نطاق SHU والشكل الدقيق عند الاستفسار.
    </p>

    <h2 style="margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما هو فلفل شياومي؟</h3>
      <p>شياومي فلفل صغير نحيل فائق الحرارة من يونان وقويتشو عند 50,000–70,000 SHU. يُستخدم للفلفل الكامل عالي الحرارة والقطع وزيت الفلفل، مانحًا حرارة قوية في قرن مدمج.</p>
    </div>
    <div class="faq-item">
      <h3>ما مدى حرارة فلفل شياومي؟</h3>
      <p>شياومي فائق الحرارة عند 50,000–70,000 SHU، في نفس نطاق جيشين وتشيلي كينغ — فوق الأصناف عالية الحرارة ويُستخدم حيث يجب أن يمنح قرن صغير حرارة قوية.</p>
    </div>
    <div class="faq-item">
      <h3>فيمَ يُستخدم فلفل شياومي؟</h3>
      <p>يُستخدم شياومي للفلفل الكامل عالي الحرارة وشرائح الفلفل وزيت الفلفل والتوابل بأسلوب سيتشوان. يبقى قرنه المدمج مرئيًا في الأطباق بينما يمنح حرارة فائقة.</p>
    </div>

    <div style="margin-top:32px;">
      <a class="cta" href="/ar/contact/">اطلب عرض سعر شياومي</a>
      <a class="cta cta-outline" href="/ar/varieties/jinta/" style="margin-left:8px;">جينتا (متوسط) ←</a>
    </div>
  </div>
</BaseLayout>
